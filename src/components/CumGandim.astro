---
/**
 * The turn from what the company does to why it does it this way.
 *
 * The client asked for no mission-vision-values block and no adjectives --
 * "inovator", "dinamic", "excelență" and the rest are banned by name. One idea,
 * very little text, a lot of room. So this section is mostly air: the light
 * arrives here, and the sentence is the only thing in it.
 *
 * The white does not arrive as an edge either. The dawn sheet floods up over
 * the map above while that is still on screen, the same way the page used to
 * open into the light over the first model.
 */
const LINE = 'Să alegi mai bine, nu doar mai ieftin.';

/* The client's own three, from their brief. The only edit is the one word that
 * was in English in it -- "new names" -- which is now in the language the rest
 * of the page is written in. Nothing has been added: what each step says about
 * the shopper is what the brief says about the shopper. */
const STEPS = [
  {
    t: 'Ieși din reflex',
    d: 'Nu cumperi automat ce ai cumpărat mereu.',
  },
  {
    t: 'Cauți alternativa bună',
    d: 'Nu renunți la calitate. Îți lărgești opțiunile.',
  },
  {
    t: 'Descoperi nume noi',
    d: 'Nu testezi la întâmplare. Smartino alege pentru tine.',
  },
];
---

<section class="think" aria-labelledby="think-title">
  <span class="think__glow" aria-hidden="true"></span>

  <div class="think__inner">
    <p class="think__kicker" data-reveal>Cum gândim</p>
    <h2 class="think__title" id="think-title" data-animate="words" aria-label={LINE}>
      <span aria-hidden="true">
        {LINE.split(' ').map((w, i) => (
          <span class="w"><span class="w__in" style={`--wi: ${i * 0.5}`}>{w}</span></span>
        ))}
      </span>
    </h2>
    <p class="think__body" data-reveal style="--i: 2">
      Viața de zi cu zi înseamnă multe alegeri, de multe ori făcute din reflex. Smartino le aduce
      într-un singur loc: aproape, accesibil și bine ales, pentru casă, familie și nevoile de zi cu
      zi.
    </p>
    <ol class="think__steps">
      {
        STEPS.map((step, i) => (
          <li class="step" data-reveal style={`--i: ${i + 3}; --k: ${i}`}>
            <span class="step__n" aria-hidden="true">{i + 1}</span>
            <p class="step__t">{step.t}</p>
            <p class="step__d">{step.d}</p>
          </li>
        ))
      }
    </ol>

    <p class="think__close" data-reveal style="--i: 6">
      Mai puțin pilot automat. Mai multe alegeri făcute cu cap.
    </p>
  </div>
</section>

<style>
  .think {
    position: relative;
    z-index: 1;
    /* clipped sideways: the drifting glow must not widen the page. clip, not
       hidden -- hidden would make this a scroll container and the scroll-driven
       animations inside would stop measuring. */
    overflow: clip;
    background-color: var(--ink);
    color: var(--fg-inv);
    /* the rhythm of every other dark section on the page: this band used to
       open tight because the map handed it a screenful of white already made,
       and there is no white to hand over any more */
    padding-block: clamp(4rem, 10vh, 7rem);
  }

  /* Nothing of this section is drawn outside this section -- an element hung
     over a neighbour has no backdrop to sit on, and everything that ever went
     wrong here went wrong for that one reason. Two lamps of its own, then, at
     the strength the dark zones use: on white they were a tint, and a tint is
     invisible on ink.
     Which is also why each lamp has to END inside this box, top and bottom.
     The first one used to sit at 18% of the height with a reach of 21%, so it
     was still four luminance levels strong where the section stops -- and a
     clip is a straight line across the full width, which is the one thing the
     eye catches in a dark room. Both are now centred deep enough that they are
     at zero before either edge. Sideways they are not: the box is 20% wider
     than the section on purpose, so what gets cut off there is cut off past
     the window, where there is nothing to see it against.
     Three stops, not two, for the same reason the map's light has three: a
     straight ramp to transparent leaves a corner in the falloff, and a corner
     in a gradient this wide draws its own faint ring. */
  .think__glow {
    position: absolute;
    inset: 0 -10%;
    z-index: 0;
    pointer-events: none;
    background-image:
      radial-gradient(
        38% 44% at 78% 46%,
        rgba(19, 180, 198, 0.2),
        rgba(19, 180, 198, 0.064) 44%,
        transparent 78%
      ),
      radial-gradient(
        32% 30% at 6% 74%,
        rgba(75, 216, 232, 0.13),
        rgba(75, 216, 232, 0.042) 44%,
        transparent 78%
      );
  }

  @media (prefers-reduced-motion: no-preference) {
    .think__glow {
      animation: drift-b 30s var(--ease-in-out) infinite alternate;
    }
  }

  .think__inner {
    position: relative;
    z-index: 1;
    max-width: var(--content);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .think__kicker {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--t-glow);
  }

  /* the same head as every other section on the page: this one used to be set
     two thirds bigger than the rest, which made it read as a second hero
     rather than as one section among them */
  .think__title {
    margin-top: 0.875rem;
    max-width: 20ch;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.25rem + 2.1vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .think__body {
    margin-top: clamp(1.25rem, 3vh, 2rem);
    max-width: 46ch;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.1875rem);
    line-height: 1.6;
    color: var(--fg-inv-2);
  }

  /* ---- the three, as one movement --------------------------------------- *
   *
   * Three numbers in three columns is a list. What makes it a sequence is the
   * line above them: one rule across the whole width, cut into three pieces
   * that open in turn from the left, each piece running on into the gap after
   * it so the joins never show. The numerals arrive as outlines and fill as
   * the line reaches them.
   *
   * Then the line is live. Every --turn, one light leaves the left end of the
   * rule and runs its whole length, and each numeral flares as it passes: a
   * bloom around the figure and a bright sweep through it, in that order,
   * settling back to the solid turquoise it sits at the rest of the time. It
   * is the same light that runs the wires in the architecture diagram and the
   * partnership equation -- two background layers on one box, moved by
   * background-position alone -- so the page keeps one vocabulary for "this
   * is connected", and the compositor does all of it.
   *
   * The rule is three pieces, so the light is three runs, each handed to the
   * next: a piece runs on into the gap after it, which is exactly where the
   * next piece begins, so a run that leaves piece k on its right edge is one
   * that enters piece k+1 on its left edge -- the same moment, by the delay,
   * and the two halves of the streak add up to one across the join. Stacked
   * on a phone, the same three delays read as a cascade down the column.
   *
   * All of it hangs off the reveal the rest of the page already uses, so it
   * costs nothing: no observer of its own, no scroll driver, and where reveals
   * do not run -- no JavaScript, or motion turned down -- the line is simply
   * drawn, the numerals are simply filled, and nothing runs.
   * ---------------------------------------------------------------------- */
  .think__steps {
    --gap: clamp(1.5rem, 3vw, 3rem);
    /* one cycle of the light: a third of it is the run, the rest is quiet */
    --turn: 8s;
    margin: clamp(2.5rem, 6vh, 4rem) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
  }

  .step {
    position: relative;
    padding-top: clamp(1.125rem, 2.4vh, 1.625rem);
  }

  /* ::before is the rule; ::after is the light that runs along it. Same box
     both, so the light is on the line at every width and every gap. */
  .step::before,
  .step::after {
    content: '';
    position: absolute;
    left: 0;
    right: calc(-1 * var(--gap));
    pointer-events: none;
  }

  .step::before {
    top: 0;
    height: 1px;
    background-color: var(--line-dark-strong);
    transform-origin: left;
  }

  /* The streak: a soft ellipse of the glow colour, drawn once in the middle of
     an image four boxes wide, so the box's own window on to it is empty at
     both ends of the travel and the wrap from one cycle to the next never
     shows. 16px tall and centred on the 1px rule, because a light has a body
     and a line does not. Off until the rule under it is drawn. */
  .step::after {
    top: -11px;
    height: 22px;
    opacity: 0;
    background-image: radial-gradient(
      4.5% 50% at 50% 50%,
      rgba(75, 216, 232, 1),
      rgba(19, 180, 198, 0.5) 40%,
      transparent 100%
    );
    background-size: 400% 100%;
    background-position: 100% 0;
    background-repeat: no-repeat;
  }

  .step:last-child::before,
  .step:last-child::after {
    right: 0;
  }

  /* max-content, not block: the flare's sweep is a background the numeral is
     cut out of, and a background the width of the column would cross the
     figure in a blink and spend the rest of its travel on nothing */
  .step__n {
    display: block;
    width: max-content;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.7rem + 2.6vw, 4rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--t);
  }

  .step__t {
    margin-top: clamp(0.625rem, 1.4vh, 1rem);
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 0.95rem + 0.5vw, 1.375rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--fg-inv);
  }

  .step__d {
    margin-top: 0.4375rem;
    max-width: 32ch;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--fg-inv-2);
  }

  @media (max-width: 759px) {
    .think__steps {
      --gap: clamp(1.75rem, 4vh, 2.5rem);
      grid-template-columns: 1fr;
    }

    .step::before,
    .step::after {
      right: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global([data-js]) .step::before {
      transform: scaleX(0);
      transition: transform 760ms var(--ease-out);
      transition-delay: calc(var(--i, 0) * var(--stagger));
    }

    :global([data-js]) .step[data-in]::before {
      transform: scaleX(1);
    }

    /* The light starts once the LAST piece of the rule is in -- one clock for
       all three runs and all three flares, so their delays mean something
       relative to each other. :has() is what asks the list about its last
       child; where it is not understood, nothing runs and the line is still
       drawn, still filled. */
    :global([data-js]) .think__steps:has(.step:last-child[data-in]) .step::after {
      opacity: 1;
      animation: rule-run var(--turn) linear infinite;
      animation-delay: calc(var(--k, 0) * var(--turn) * 0.1);
    }

    /* and the piece of rule under the light warms while the light is on it,
       then cools: the line remembers where the light has been, for a moment */
    :global([data-js]) .think__steps:has(.step:last-child[data-in]) .step::before {
      animation: rule-warm var(--turn) linear infinite;
      animation-delay: calc(var(--k, 0) * var(--turn) * 0.1);
    }

    /* the fill only where the outline can be drawn at all: without the stroke
       a transparent numeral is no numeral */
    @supports (-webkit-text-stroke: 1px currentColor) {
      :global([data-js]) .step__n {
        color: transparent;
        -webkit-text-stroke: 1.5px var(--t);
        transition: color 520ms var(--ease-out);
        transition-delay: calc(var(--i, 0) * var(--stagger) + 300ms);
      }

      :global([data-js]) .step[data-in] .step__n {
        color: var(--t);
      }
    }

    /* The flare needs the figure to be cut out of its own background, so
       that the sweep can cross it: fill becomes background-color (which
       background-clip: text clips just the same, and which transitions just
       the same), and the sweep is a second layer over it, parked off the
       glyph until its turn. */
    @supports ((-webkit-text-stroke: 1px currentColor) and (-webkit-background-clip: text)) {
      :global([data-js]) .step__n {
        color: var(--t);
        -webkit-text-fill-color: transparent;
        background-color: transparent;
        background-image: linear-gradient(
          100deg,
          transparent 0 42%,
          rgba(255, 255, 255, 0.92) 50%,
          transparent 58% 100%
        );
        background-size: 400% 100%;
        background-position: 100% 0;
        background-repeat: no-repeat;
        -webkit-background-clip: text;
        background-clip: text;
        transition: background-color 520ms var(--ease-out);
        transition-delay: calc(var(--i, 0) * var(--stagger) + 300ms);
      }

      :global([data-js]) .step[data-in] .step__n {
        background-color: var(--t);
      }

      /* Timed to the run. The streak's centre reaches the left end of piece k
         a third of the way into that piece's run, and each run starts a tenth
         of a turn after the one before: (k + 1) / 10 of the turn. The flare
         starts a hair BEFORE that, because its bloom takes a fiftieth of the
         turn to peak and the peak should land while the streak is still on
         the figure, not a hundred pixels past it. Same period as the run, so
         they never drift apart. */
      :global([data-js]) .think__steps:has(.step:last-child[data-in]) .step__n {
        animation: n-flare var(--turn) linear infinite;
        animation-delay: calc(var(--turn) * ((var(--k, 0) + 1) * 0.1 - 0.008));
      }
    }
  }

  /* Position 100% shows the image's right quarter, 0% its left; the streak is
     in the middle, so it crosses the box while the window slides over it --
     left to right on screen -- and both ends of the travel are empty. The run
     is three tenths of the turn; the last seven tenths it sits, unseen, at
     the far end, and the jump back at the wrap is from empty to empty. */
  @keyframes rule-run {
    0% {
      background-position: 100% 0;
    }
    30% {
      background-position: 0% 0;
    }
    100% {
      background-position: 0% 0;
    }
  }

  /* The streak is on a piece from a tenth to two tenths of the piece's run;
     the piece is warmest in the middle of that and has cooled by the time the
     next piece is warmest, so at any moment only the lit third glows. */
  @keyframes rule-warm {
    0%,
    8% {
      background-color: var(--line-dark-strong);
    }
    15% {
      background-color: color-mix(in srgb, var(--t) 55%, var(--line-dark-strong));
    }
    34%,
    100% {
      background-color: var(--line-dark-strong);
    }
  }

  /* The bloom leads by a hair and the sweep follows through the figure; the
     bloom then takes four times as long to die as it took to rise, which is
     what makes it read as light rather than as a blink. filter, not
     text-shadow: with the figure cut from its background a text-shadow shows
     through the cut-out and tints the whole glyph, while a drop-shadow is
     drawn from what is actually painted and stays outside it. */
  @keyframes n-flare {
    0% {
      background-position: 100% 0;
      filter: drop-shadow(0 0 0 rgba(75, 216, 232, 0)) drop-shadow(0 0 0 rgba(19, 180, 198, 0));
    }
    2.5% {
      filter: drop-shadow(0 0 6px rgba(75, 216, 232, 1)) drop-shadow(0 0 40px rgba(19, 180, 198, 0.85));
    }
    7% {
      background-position: 0% 0;
    }
    14% {
      filter: drop-shadow(0 0 0 rgba(75, 216, 232, 0)) drop-shadow(0 0 0 rgba(19, 180, 198, 0));
    }
    100% {
      background-position: 0% 0;
      filter: drop-shadow(0 0 0 rgba(75, 216, 232, 0)) drop-shadow(0 0 0 rgba(19, 180, 198, 0));
    }
  }

  /* No rule of its own any more: the three above it already put one across the
     whole width, and a second one underneath at a third of that length reads
     as a mistake rather than as a break. The space does the work instead. */
  .think__close {
    margin-top: clamp(2.75rem, 7vh, 4.25rem);
    max-width: 34ch;
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 0.95rem + 0.6vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--fg-inv);
  }
</style>
