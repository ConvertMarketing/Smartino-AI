---
import { Image } from 'astro:assets';
import familie from '../assets/photos/familie-lounge.jpg';
import { COMPANY, UNITS, SUPERMARKET_HOURS } from '../lib/data';

/**
 * The hero: the whole group at once, four store cards side by side.
 *
 * No carousel. All four units are permanently in sight, equal citizens on one
 * row (a 2×2 field on narrow screens). Each card is image-on-top, caption
 * underneath: name, one line, the exit.
 *
 * The motion lives in three places: the cards enter with a staggered 3D rise
 * as the page arrives, each card tilts toward the pointer under the hand, and
 * the drawn fields drift slowly forever. Under reduced motion all of it stops
 * and the page is simply there; without JavaScript everything is visible and
 * every link still a link.
 *
 * The units without any real photography (01, 03, 04) carry their drawn
 * fields -- the aisle, the bubbles, the route -- rather than a fake photo.
 */
const hoursShort = SUPERMARKET_HOURS.map((h) => `${h.open}–${h.close}`).join(' · ');
const [u1, u2, u3, u4] = UNITS;

const cards = [
  { unit: u1, art: null, pattern: 'aisle', href: '#snagov-plaza', exit: hoursShort, line: 'Nevoile zilnice ale familiei, din 2025.' },
  { unit: u2, art: familie, pattern: null, href: u2.href!, exit: u2.domain!, line: 'Peste 1.200 m² de acasă, vizavi.' },
  { unit: u3, art: null, pattern: 'bloom', href: u3.href!, exit: u3.domain!, line: 'Îngrijire și curățenie, livrate în toată țara.' },
  { unit: u4, art: null, pattern: 'route', href: u4.href!, exit: u4.domain!, line: 'Partenerul din Republica Moldova.' },
];
---

<header class="fascia">
  <span class="fascia__mark">SMARTINO</span>
  <span class="fascia__where">{COMPANY.address.oneLine}</span>
</header>

<section class="hero" id="continut" data-hero>
  <div class="hero__ground" data-animate="ground" aria-hidden="true">
    <span class="hero__aurora"></span>
    <span class="hero__grid"></span>
    <span class="hero__floor"></span>
  </div>

  <div class="hero__head">
    <p class="hero__over" data-reveal>Smartino International</p>
    <h1 class="hero__title" data-animate="lines">
      <span class="line"><span class="line__in">Un grup crescut</span></span>
      <span class="line"><span class="line__in line__in--t">dintr-un singur magazin.</span></span>
    </h1>
  </div>

  <ul class="units" data-animate="deck" aria-label="Magazinele grupului">
    {
      cards.map((c, i) => (
        <li class="units__cell" style={`--i: ${i}`}>
          <a
            class="uc"
            data-tilt
            href={c.href}
            {...c.href.startsWith('http') ? { rel: 'noopener' } : {}}
            aria-label={
              c.href.startsWith('http')
                ? `${c.unit.name} — deschide ${c.exit}`
                : `${c.unit.name} — vezi adresa și programul`
            }
          >
            <span class="uc__media" data-pattern={c.pattern}>
              {c.art && (
                <Image src={c.art} alt="" widths={[480, 720]} sizes="(min-width: 1024px) 24vw, 46vw" loading="eager" />
              )}
              <span class="uc__n tnum">{c.unit.index}</span>
            </span>
            <span class="uc__caption">
              <span class="uc__name">{c.unit.name.replace('Smartino ', '')}</span>
              <span class="uc__line">{c.line}</span>
              <span class="uc__exit tnum">{c.exit}<span class="uc__arrow" aria-hidden="true">→</span></span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <a class="hero__cue" href="#povestea" aria-label="Derulează la poveste">
    <span class="hero__cueLine" aria-hidden="true"></span>
    <span class="hero__cueText">povestea</span>
  </a>
</section>

<style>
  .fascia {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 64px;
    padding-inline: var(--gutter);
    background-color: var(--mist);
    color: var(--fg);
    border-bottom: 1px solid rgba(11, 15, 16, 0.12);
  }

  .fascia__mark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.16em;
  }

  .fascia__where {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: right;
    color: var(--fg-2);
  }

  .hero {
    position: relative;
    min-height: calc(100dvh - 64px);
    display: flex;
    flex-direction: column;
    background-color: var(--mist);
    overflow: hidden;
  }

  /* ---- the living ground ------------------------------------------------
     Three layers under everything: auroras adrift, a dot grid sliding
     diagonally, and a turquoise stage rising under the cards. The whole
     ground leans toward the pointer (--mx/--my) and drifts with the scroll
     (--sy), both written by the runtime; without it they are simply 0. */
  .hero__ground {
    position: absolute;
    inset: -8%;
    z-index: 0;
    pointer-events: none;
    transform: translate3d(calc(var(--mx, 0) * 1.6%), calc(var(--my, 0) * 1.2% + var(--sy, 0) * 1px), 0);
    transition: transform 700ms var(--ease-out);
    will-change: transform;
  }

  .hero__aurora,
  .hero__grid,
  .hero__floor {
    position: absolute;
    inset: 0;
    display: block;
  }

  .hero__aurora {
    background-image:
      radial-gradient(34% 28% at 20% 22%, rgba(19, 180, 198, 0.34), transparent 68%),
      radial-gradient(40% 34% at 84% 30%, rgba(75, 216, 232, 0.28), transparent 70%),
      radial-gradient(26% 22% at 56% 8%, rgba(11, 111, 122, 0.14), transparent 72%);
    animation: aurora-drift 22s var(--ease-in-out) infinite alternate;
  }

  .hero__grid {
    inset: -30%;
    background-image: radial-gradient(rgba(11, 15, 16, 0.07) 1px, transparent 1.5px);
    background-size: 24px 24px;
    animation: grid-drift 48s linear infinite;
  }

  /* the stage: solid brand turquoise at the floor, dissolving upward, with a
     light sweeping across it forever */
  .hero__floor {
    top: 50%;
    background-image: linear-gradient(180deg, transparent 0%, rgba(19, 180, 198, 0.24) 42%, rgba(19, 180, 198, 0.56) 100%);
  }

  .hero__floor::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, 0.22) 50%, transparent 70%);
    background-size: 60% 100%;
    background-repeat: no-repeat;
    animation: floor-sheen 9s var(--ease-in-out) infinite;
  }

  @keyframes aurora-drift {
    to {
      transform: translate3d(4%, 6%, 0) rotate(6deg) scale(1.08);
    }
  }

  @keyframes grid-drift {
    to {
      transform: translate3d(240px, 168px, 0);
    }
  }

  @keyframes floor-sheen {
    0%,
    100% {
      background-position: -60% 0;
    }
    50% {
      background-position: 160% 0;
    }
  }

  /* Entry: the stage rises from the floor while the auroras come up. */
  :global([data-js]) [data-animate='ground'] .hero__floor {
    opacity: 0;
    transform: translateY(14%);
    transition:
      opacity 900ms var(--ease-out) 120ms,
      transform 1300ms var(--ease-out) 120ms;
  }

  :global([data-js]) [data-animate='ground'] .hero__aurora {
    opacity: 0;
    transition: opacity 1400ms var(--ease-out) 300ms;
  }

  :global([data-js]) [data-animate='ground'][data-in] .hero__floor,
  :global([data-js]) [data-animate='ground'][data-in] .hero__aurora {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__ground {
      transition: none;
    }
    .hero__aurora,
    .hero__grid,
    .hero__floor::after {
      animation: none;
    }
    :global([data-js]) [data-animate='ground'] .hero__floor,
    :global([data-js]) [data-animate='ground'] .hero__aurora {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .hero__head,
  .units,
  .hero__cue {
    position: relative;
    z-index: 1;
  }

  /* ---- leaving the hero, on the scroll itself -----------------------------
     The words rise faster than the page and fade; the deck tips back and
     sinks. Both are driven by the scroll position, not by time, so they
     follow the hand exactly and cost nothing. Browsers without scroll-driven
     animations simply scroll; reduced motion keeps only the fade. */
  /* The timeline lives in its own rule, apart from the shorthand, and with
     HIGHER specificity (the doubled class): the minifier would otherwise fold
     it into `animation:`, a form no browser parses -- and in a separate rule
     of lower specificity the shorthand's reset of animation-timeline would
     win, leaving a zero-duration animation stuck at its end state. */
  @supports (animation-timeline: scroll(root)) {
    .hero__head {
      animation: head-away linear both;
    }

    .hero__head.hero__head {
      animation-timeline: scroll(root);
      animation-range: 0 80vh;
    }

    .units {
      animation: deck-away linear both;
    }

    .units.units {
      animation-timeline: scroll(root);
      animation-range: 0 100vh;
    }

    @media (prefers-reduced-motion: reduce) {
      .hero__head {
        animation-name: head-fade;
      }
      .units {
        animation: none;
      }
    }
  }

  @keyframes head-away {
    to {
      transform: translateY(-24vh);
      opacity: 0;
    }
  }

  @keyframes head-fade {
    to {
      opacity: 0;
    }
  }

  @keyframes deck-away {
    to {
      transform: perspective(1400px) translateY(18vh) rotateX(-14deg) scale(0.95);
      opacity: 0.3;
    }
  }

  .hero__head {
    text-align: center;
    padding: clamp(1.25rem, 3.5vh, 2.5rem) var(--gutter) 0;
  }

  .hero__over {
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 0.7rem + 0.8vw, 1.375rem);
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--t-deep);
  }

  .hero__title {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 0.6rem + 4vw, 5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--fg);
  }

  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.06em;
  }

  .line__in {
    display: block;
  }

  :global([data-js]) .line__in {
    transform: translate3d(0, 115%, 0);
    transition: transform 900ms var(--ease-out) 200ms;
  }

  :global([data-js]) .line:nth-child(2) .line__in {
    transition-delay: 340ms;
  }

  :global([data-js]) [data-animate='lines'][data-in] .line__in {
    transform: none;
  }

  /* the second line shimmers: every stop is --t-deep or darker, so the
     contrast never dips below the solid colour's */
  .line__in--t {
    color: var(--t-deep);
    background-image: linear-gradient(100deg, var(--t-deep) 0%, var(--t-deep) 35%, var(--t-dark) 50%, var(--t-deep) 65%, var(--t-deep) 100%);
    background-size: 240% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: title-shimmer 6s var(--ease-in-out) infinite;
  }

  @keyframes title-shimmer {
    0%,
    100% {
      background-position: 100% 0;
    }
    50% {
      background-position: 0% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .line__in--t {
      animation: none;
    }
    :global([data-js]) .line__in {
      transform: none;
      transition: none;
    }
  }

  /* ---- the four, all at once -------------------------------------------- */
  .units {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(14px, 1.6vw, 26px);
    width: min(100%, calc(1560px + 2 * var(--gutter)));
    padding-inline: var(--gutter);
    margin-inline: auto;
    margin-block: auto;
    padding-block: clamp(1.25rem, 3.5vh, 2.5rem) clamp(1rem, 2.5vh, 2rem);
    perspective: 1400px;
  }

  /* Entry: each card rises and unfolds toward the viewer, one beat apart;
     landed, it floats -- a slow breath, out of phase with its neighbours. */
  :global([data-js]) [data-animate='deck'] .units__cell {
    opacity: 0;
    transform: translateY(70px) rotateX(18deg) scale(0.93);
    transition:
      transform 1000ms var(--ease-out) calc(var(--i) * 120ms + 500ms),
      opacity 700ms var(--ease-out) calc(var(--i) * 120ms + 500ms);
  }

  :global([data-js]) [data-animate='deck'][data-in] .units__cell {
    opacity: 1;
    transform: none;
    animation: card-float 7s var(--ease-in-out) calc(var(--i) * -1.75s + 2.2s) infinite;
  }

  @keyframes card-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-7px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-js]) [data-animate='deck'] .units__cell,
    :global([data-js]) [data-animate='deck'][data-in] .units__cell {
      opacity: 1;
      transform: none;
      transition: none;
      animation: none;
    }
  }

  /* The card: image on top, words underneath. Under a pointer it leans
     toward the hand (--rx/--ry from the tilt driver) and lifts. */
  .uc {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: 20px;
    overflow: hidden;
    background-color: #fffdf9;
    box-shadow: var(--lift-2);
    text-decoration: none;
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg))
      translateY(var(--uy, 0px));
    transition:
      transform 260ms var(--ease-out),
      box-shadow 260ms var(--ease-out);
  }

  /* a light sweeps across each card, one after another */
  .uc::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background-image: linear-gradient(115deg, transparent 38%, rgba(255, 255, 255, 0.34) 50%, transparent 62%);
    transform: translateX(-120%);
    animation: card-sheen 8s var(--ease-in-out) calc(var(--i) * 0.55s + 3s) infinite;
  }

  @keyframes card-sheen {
    0%,
    62%,
    100% {
      transform: translateX(-120%);
    }
    30% {
      transform: translateX(120%);
    }
  }

  .uc:hover {
    --uy: -10px;
    box-shadow: var(--lift-t);
  }

  @media (prefers-reduced-motion: reduce) {
    .uc {
      transition: none;
    }
    .uc:hover {
      --uy: 0px;
    }
    .uc::after {
      animation: none;
    }
  }

  .uc__media {
    position: relative;
    height: clamp(190px, 30vh, 340px);
    overflow: hidden;
  }

  .uc__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }

  .uc:hover .uc__media img {
    transform: scale(1.06);
  }

  .uc__media[data-pattern='aisle'] {
    background-color: var(--t);
    background-image:
      repeating-linear-gradient(100deg, rgba(11, 15, 16, 0.16) 0 2px, transparent 2px 46px),
      repeating-linear-gradient(80deg, rgba(255, 255, 255, 0.14) 0 1px, transparent 1px 32px),
      linear-gradient(115deg, var(--t-glow), var(--t) 55%, var(--t-floor));
  }

  .uc__media[data-pattern='route'] {
    background-color: var(--t);
    background-image:
      repeating-linear-gradient(115deg, rgba(255, 255, 255, 0.2) 0 12px, transparent 12px 30px),
      linear-gradient(155deg, var(--t) 30%, var(--t-floor));
  }

  .uc__media[data-pattern='bloom'] {
    background-color: var(--t);
    background-image:
      radial-gradient(circle, rgba(255, 255, 255, 0.24) 0 26%, transparent 27%),
      radial-gradient(circle, rgba(11, 15, 16, 0.07) 0 18%, transparent 19%),
      linear-gradient(140deg, var(--t-glow), var(--t) 52%, var(--t-floor));
    background-size: 64px 64px, 38px 38px, 100% 100%;
    background-position: 0 0, 19px 27px, 0 0;
  }

  /* The drawn fields drift, slowly, forever. Photographs hold still. */
  @media (prefers-reduced-motion: no-preference) {
    .uc__media[data-pattern] {
      animation: field-drift 36s linear infinite alternate;
    }
  }

  @keyframes field-drift {
    to {
      background-position:
        140px -40px,
        -90px 60px,
        0 0;
    }
  }

  /* The index rides on its own scrim: photographs cannot promise contrast.
     Under the hand it turns to the brand colour, with near-black on it. */
  .uc__n {
    position: absolute;
    left: 0.875rem;
    top: 0.875rem;
    padding: 0.32rem 0.32rem 0.32rem 0.6rem;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    color: #fffdf9;
    background-color: rgba(11, 15, 16, 0.72);
    transition:
      background-color var(--d-micro) var(--ease-out),
      color var(--d-micro) var(--ease-out);
  }

  .uc:hover .uc__n {
    background-color: var(--t);
    color: var(--ink);
  }

  /* text under the card's image, as asked: name, one line, the exit */
  .uc__caption {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.125rem 1.125rem;
    border-top: 1px solid rgba(11, 15, 16, 0.08);
  }

  .uc__name {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1rem + 0.5vw, 1.625rem);
    font-weight: 800;
    letter-spacing: -0.015em;
    color: var(--fg);
  }

  .uc__line {
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--fg-2);
  }

  .uc__exit {
    margin-top: auto;
    padding-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--t-deep);
  }

  .uc__arrow {
    display: inline-block;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity var(--d-micro) var(--ease-out),
      transform var(--d-micro) var(--ease-out);
  }

  .uc:hover .uc__arrow {
    opacity: 1;
    transform: none;
  }

  /* ---- cue -------------------------------------------------------------- */
  .hero__cue {
    align-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding-bottom: 0.625rem;
    text-decoration: none;
  }

  .hero__cueLine {
    width: 1px;
    height: 24px;
    background-image: linear-gradient(180deg, transparent, var(--ink));
    position: relative;
    overflow: hidden;
  }

  .hero__cueLine::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: -40%;
    height: 40%;
    background-color: var(--ink);
    animation: cue-drop 1.8s var(--ease-in-out) infinite;
  }

  @keyframes cue-drop {
    to { transform: translateY(350%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cueLine::after { animation: none; }
  }

  .hero__cueText {
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink);
  }

  @media (max-width: 1023px) {
    .units {
      grid-template-columns: repeat(2, 1fr);
    }

    .uc__media {
      height: clamp(140px, 19vh, 200px);
    }

    .hero__floor {
      top: 36%;
    }
  }

  @media (max-width: 599px) {
    .fascia__where {
      max-width: 11rem;
      font-size: 0.5625rem;
    }

    .uc__caption {
      padding: 0.625rem 0.75rem 0.75rem;
    }

    .uc__name {
      font-size: 1.0625rem;
    }

    .uc__line {
      font-size: 0.75rem;
    }
  }
</style>
