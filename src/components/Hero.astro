---
import { Image } from 'astro:assets';
import supermarket from '../assets/photos/smartino-supermarket-interior.jpg';
import homeCladire from '../assets/photos/smartino-home-cladire.jpg';
import shopSite from '../assets/photos/smartinoshop-site.jpg';
import mdSite from '../assets/photos/smartino-md-site.jpg';
import { UNITS, SUPERMARKET_HOURS } from '../lib/data';

/**
 * The hero: the whole group at once, four store cards side by side.
 *
 * No carousel. All four units are permanently in sight, equal citizens on one
 * row (a 2×2 field on narrow screens). Each card is image-on-top, caption
 * underneath: name, one line, the exit.
 *
 * The motion lives in three places: the cards enter with a staggered 3D rise
 * as the page arrives, each card tilts toward the pointer under the hand, and
 * the drawn fields drift slowly forever. Under reduced motion all of it stops
 * and the page is simply there; without JavaScript everything is visible and
 * every link still a link.
 *
 * Every card carries the real thing: the supermarket's own aisles, the Home
 * building at dusk (a still from the group's campaign film), and the two
 * online shops as their actual storefronts, captured from the live sites.
 * TODO(client): the supermarket card holds a press photo of the interior,
 * because no exterior photograph of the building is published anywhere
 * reachable. Swap it for the client's own exterior shot -- see
 * docs/assets-needed.md.
 */
const hoursShort = SUPERMARKET_HOURS.map((h) => `${h.open}–${h.close}`).join(' · ');
const [u1, u2, u3, u4] = UNITS;

const cards = [
  { unit: u1, art: supermarket, pattern: null, fit: null, href: '#snagov-plaza', exit: hoursShort, line: 'Nevoile zilnice ale familiei, din 2025.' },
  { unit: u2, art: homeCladire, pattern: null, fit: null, href: u2.href!, exit: u2.domain!, line: 'Peste 1.200 m² de acasă, vizavi.' },
  // the two shops show their own storefront, so the crop holds the top of the
  // page -- the logo and the banner -- rather than drifting into the products
  { unit: u3, art: shopSite, pattern: null, fit: 'top', href: u3.href!, exit: u3.domain!, line: 'Îngrijire și curățenie, livrate în toată țara.' },
  { unit: u4, art: mdSite, pattern: null, fit: 'top', href: u4.href!, exit: u4.domain!, line: 'Partenerul din Republica Moldova.' },
];
---

<section class="hero" id="continut" data-hero>
  <div class="hero__ground" data-animate="ground" aria-hidden="true">
    <span class="hero__aurora"></span>
    <span class="hero__grid"></span>
    <span class="hero__rings">
      <span style="--r: 0"></span>
      <span style="--r: 1"></span>
      <span style="--r: 2"></span>
      <span style="--r: 3"></span>
    </span>
  </div>
  <div class="hero__floor" data-animate="floor" aria-hidden="true"></div>

  <div class="hero__head">
    <p class="hero__over" data-reveal>Smartino International</p>
    <h1 class="hero__title" data-animate="lines">
      <span class="line"><span class="line__in">Zeci de branduri,</span></span>
      <span class="line"><span class="line__in line__in--t">un singur grup.</span></span>
    </h1>
  </div>

  <ul class="units" data-animate="deck" aria-label="Magazinele grupului">
    {
      cards.map((c, i) => (
        <li class="units__cell" style={`--i: ${i}`}>
          <a
            class="uc"
            data-tilt
            href={c.href}
            {...c.href.startsWith('http') ? { rel: 'noopener' } : {}}
            aria-label={
              c.href.startsWith('http')
                ? `${c.unit.name} — deschide ${c.exit}`
                : `${c.unit.name} — vezi adresa și programul`
            }
          >
            <span class="uc__media" data-pattern={c.pattern} data-fit={c.fit}>
              {c.art && (
                <Image src={c.art} alt="" widths={[480, 720, 960]} sizes="(min-width: 1024px) 24vw, 46vw" loading="eager" />
              )}
              <span class="uc__n tnum">{c.unit.index}</span>
            </span>
            <span class="uc__caption">
              <span class="uc__name">{c.unit.name.replace('Smartino ', '')}</span>
              <span class="uc__line">{c.line}</span>
              <span class="uc__exit tnum">{c.exit}<span class="uc__arrow" aria-hidden="true">→</span></span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <a class="hero__cue" href="#povestea" aria-label="Derulează la poveste">
    <span class="hero__cueLine" aria-hidden="true"></span>
    <span class="hero__cueText">povestea</span>
  </a>
</section>

<style>
  /* The hero opens on the same near-black the maquette below is built on, so
     the top of the page reads as one dark room with the four lit cards in it.
     Everything turquoise here is LIGHT: on this ground it finally behaves
     like light rather than paint. */
  .hero {
    position: relative;
    min-height: calc(100dvh - 64px);
    display: flex;
    flex-direction: column;
    background-color: var(--ink);
    color: var(--fg-inv);
    overflow: hidden;
  }

  /* ---- the living ground ------------------------------------------------
     Auroras adrift and a dot grid sliding diagonally, both leaning toward the
     pointer (--mx/--my) and drifting with the scroll (--sy), written by the
     runtime; without it they are simply 0. The floor below is deliberately
     NOT in here: it must not move, or the seam with the next section would
     slide open as the page scrolls. */
  .hero__ground {
    position: absolute;
    inset: -8%;
    z-index: 0;
    pointer-events: none;
    transform: translate3d(calc(var(--mx, 0) * 1.6%), calc(var(--my, 0) * 1.2% + var(--sy, 0) * 1px), 0);
    transition: transform 700ms var(--ease-out);
    will-change: transform;
  }

  .hero__aurora,
  .hero__grid {
    position: absolute;
    inset: 0;
    display: block;
  }

  /* The pools are brighter now, but their placement is what keeps the text
     readable: they are pushed out to the edges and low, away from the band
     the title occupies. Every colour here was measured against the pixels
     actually rendered behind it -- see scripts/verify.mjs, which now samples
     the real ground under each line rather than trusting the stylesheet. */
  .hero__aurora {
    background-image:
      radial-gradient(42% 34% at 8% 26%, rgba(19, 180, 198, 0.3), transparent 70%),
      radial-gradient(46% 38% at 95% 30%, rgba(75, 216, 232, 0.26), transparent 72%),
      radial-gradient(52% 40% at 50% 96%, rgba(19, 180, 198, 0.26), transparent 74%),
      radial-gradient(28% 24% at 78% 84%, rgba(75, 216, 232, 0.16), transparent 76%);
    animation: aurora-drift 22s var(--ease-in-out) infinite alternate;
  }

  /* ---- the rings ---------------------------------------------------------
     The plaza is built out of circles -- two roundabouts, the monument's
     basin, the ring the Home building is wrapped in -- so the light in this
     room travels the same way: rings opening out of the floor, one every few
     seconds. Transform and opacity only, so they cost the compositor and
     nothing else. */
  .hero__rings {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
  }

  .hero__rings span {
    position: absolute;
    left: 50%;
    bottom: -34vmax;
    width: 68vmax;
    height: 68vmax;
    margin-left: -34vmax;
    border: 1px solid rgba(75, 216, 232, 0.5);
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.28);
    animation: ring-out 16s linear infinite;
    animation-delay: calc(var(--r) * -4s);
  }

  @keyframes ring-out {
    0% {
      opacity: 0;
      transform: scale(0.28);
    }
    12% {
      opacity: 0.55;
    }
    100% {
      opacity: 0;
      transform: scale(1.55);
    }
  }

  .hero__grid {
    inset: -30%;
    background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1.5px);
    background-size: 24px 24px;
    animation: grid-drift 48s linear infinite;
  }

  /* The floor: a pool of turquoise light low in the room, closed off by a veil
     that returns to exactly the ink the next section starts with -- so the
     glow never reaches the edge and the seam stays invisible. It sits outside
     the parallax layer, which is what keeps that seam closed at every scroll
     position. A light still sweeps across it. */
  .hero__floor {
    position: absolute;
    inset: 44% 0 0 0;
    z-index: 0;
    pointer-events: none;
    /* the veil is listed FIRST because the first background layer paints on
       TOP: with the glow first, light leaked past it to the very edge and the
       seam measured 11,21,22 against the 10,14,15 of the section below */
    background-image:
      linear-gradient(180deg, transparent 52%, var(--ink) 92%),
      radial-gradient(78% 64% at 50% 68%, rgba(19, 180, 198, 0.3), transparent 72%);
  }

  /* A turquoise light travels along the horizon, where the grey gives way to
     the dark. It is masked to that band alone: a sweep reaching the near-black
     below would lift it off the colour the next section starts with, and the
     seam would show. */
  .hero__floor::after {
    content: '';
    position: absolute;
    inset: 30% 0 auto 0;
    height: 34%;
    background-image: linear-gradient(105deg, transparent 32%, rgba(75, 216, 232, 0.22) 50%, transparent 68%);
    background-size: 62% 100%;
    background-repeat: no-repeat;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 45%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 45%, transparent 100%);
    animation: floor-sheen 9s var(--ease-in-out) infinite;
  }

  @keyframes aurora-drift {
    to {
      transform: translate3d(4%, 6%, 0) rotate(6deg) scale(1.08);
    }
  }

  @keyframes grid-drift {
    to {
      transform: translate3d(240px, 168px, 0);
    }
  }

  @keyframes floor-sheen {
    0%,
    100% {
      background-position: -60% 0;
    }
    50% {
      background-position: 160% 0;
    }
  }

  /* Entry: the dark floor rises while the auroras come up. */
  :global([data-js]) [data-animate='floor'] {
    opacity: 0;
    transform: translateY(10%);
    transition:
      opacity 900ms var(--ease-out) 120ms,
      transform 1300ms var(--ease-out) 120ms;
  }

  :global([data-js]) [data-animate='floor'][data-in] {
    opacity: 1;
    transform: none;
  }

  :global([data-js]) [data-animate='ground'] .hero__aurora {
    opacity: 0;
    transition: opacity 1400ms var(--ease-out) 300ms;
  }

  :global([data-js]) [data-animate='ground'][data-in] .hero__aurora {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__ground {
      transition: none;
    }
    .hero__aurora,
    .hero__grid,
    .hero__rings span,
    .hero__floor::after {
      animation: none;
    }

    /* one ring stays, drawn, so the room keeps its shape without motion */
    .hero__rings span {
      opacity: 0.3;
      transform: scale(0.9);
    }
    :global([data-js]) [data-animate='floor'],
    :global([data-js]) [data-animate='ground'] .hero__aurora {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .hero__head,
  .units,
  .hero__cue {
    position: relative;
    z-index: 1;
  }

  /* ---- leaving the hero, on the scroll itself -----------------------------
     The words rise faster than the page and fade; the deck tips back and
     sinks. Both are driven by the scroll position, not by time, so they
     follow the hand exactly and cost nothing. Browsers without scroll-driven
     animations simply scroll; reduced motion keeps only the fade. */
  /* The timeline lives in its own rule, apart from the shorthand, and with
     HIGHER specificity (the doubled class): the minifier would otherwise fold
     it into `animation:`, a form no browser parses -- and in a separate rule
     of lower specificity the shorthand's reset of animation-timeline would
     win, leaving a zero-duration animation stuck at its end state. */
  @supports (animation-timeline: scroll(root)) {
    .hero__head {
      animation: head-away linear both;
    }

    .hero__head.hero__head {
      animation-timeline: scroll(root);
      animation-range: 0 80vh;
    }

    .units {
      animation: deck-away linear both;
    }

    .units.units {
      animation-timeline: scroll(root);
      animation-range: 0 100vh;
    }

    @media (prefers-reduced-motion: reduce) {
      .hero__head {
        animation-name: head-fade;
      }
      .units {
        animation: none;
      }
    }
  }

  @keyframes head-away {
    to {
      transform: translateY(-24vh);
      opacity: 0;
    }
  }

  @keyframes head-fade {
    to {
      opacity: 0;
    }
  }

  @keyframes deck-away {
    to {
      transform: perspective(1400px) translateY(18vh) rotateX(-14deg) scale(0.95);
      opacity: 0.3;
    }
  }

  .hero__head {
    text-align: center;
    padding: clamp(1.25rem, 3.5vh, 2.5rem) var(--gutter) 0;
  }

  .hero__over {
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 0.7rem + 0.8vw, 1.375rem);
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--t-glow);
  }

  .hero__title {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 0.55rem + 3.2vw, 4rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--fg-inv);
  }

  /* The mask the line rises out of clips at its padding edge, so the padding
     must clear the deepest ink on the line: descenders, and the comma below
     ș and ț. At 0.1em it cut the tails off every g. The negative margin puts
     the leading back, so the extra room costs no space between the lines.
     scripts/verify.mjs fails on the old value. */
  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.26em;
    margin-bottom: -0.22em;
  }

  .line__in {
    display: block;
  }

  :global([data-js]) .line__in {
    transform: translate3d(0, 115%, 0);
    transition: transform 900ms var(--ease-out) 200ms;
  }

  :global([data-js]) .line:nth-child(2) .line__in {
    transition-delay: 340ms;
  }

  :global([data-js]) [data-animate='lines'][data-in] .line__in {
    transform: none;
  }

  /* the second line shimmers: every stop is --t-deep or darker, so the
     contrast never dips below the solid colour's */
  /* On the dark ground the turquoise steps UP: --t reads 7.68:1 on ink, and
     the shimmer only ever brightens it. */
  .line__in--t {
    /* The mask above clears the deepest ink; this clears the deepest PAINT.
       background-clip fills only inside this element's background box, so a
       tail below it has nothing to be drawn with -- 25 px of the comma under
       ț, measured by the clipping check. Extended and pulled back by the same
       amount, so nothing moves. */
    padding-bottom: 0.24em;
    margin-bottom: -0.24em;
    color: var(--t);
    background-image: linear-gradient(100deg, var(--t) 0%, var(--t) 35%, var(--t-glow) 50%, var(--t) 65%, var(--t) 100%);
    background-size: 240% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: title-shimmer 6s var(--ease-in-out) infinite;
  }

  @keyframes title-shimmer {
    0%,
    100% {
      background-position: 100% 0;
    }
    50% {
      background-position: 0% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .line__in--t {
      animation: none;
    }
    :global([data-js]) .line__in {
      transform: none;
      transition: none;
    }
  }

  /* ---- the four, all at once -------------------------------------------- */
  .units {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(14px, 1.6vw, 26px);
    width: min(100%, calc(1560px + 2 * var(--gutter)));
    padding-inline: var(--gutter);
    margin-inline: auto;
    margin-block: auto;
    padding-block: clamp(1.25rem, 3.5vh, 2.5rem) clamp(1rem, 2.5vh, 2rem);
    perspective: 1400px;
    transform-style: preserve-3d;
  }

  /* Entry: the four gather into the dark room from where each of them stands
     -- the outer two swing in from their own side, the inner two rise from
     the floor -- all of them out of depth, turning as they come. Landed, each
     floats: a slow breath, out of phase with its neighbours. */
  :global([data-js]) [data-animate='deck'] .units__cell {
    opacity: 0;
    transform: translate3d(var(--fx, 0), var(--fy, 0), -220px) rotateY(var(--fr, 0deg)) rotateX(12deg) scale(0.94);
    transition:
      transform 1150ms var(--ease-out) calc(var(--i) * 130ms + 420ms),
      opacity 620ms var(--ease-out) calc(var(--i) * 130ms + 420ms);
  }

  :global([data-js]) [data-animate='deck'] .units__cell:nth-child(1) {
    --fx: -30%;
    --fr: 16deg;
  }

  :global([data-js]) [data-animate='deck'] .units__cell:nth-child(2) {
    --fy: 90px;
    --fr: 7deg;
  }

  :global([data-js]) [data-animate='deck'] .units__cell:nth-child(3) {
    --fy: 90px;
    --fr: -7deg;
  }

  :global([data-js]) [data-animate='deck'] .units__cell:nth-child(4) {
    --fx: 30%;
    --fr: -16deg;
  }

  :global([data-js]) [data-animate='deck'][data-in] .units__cell {
    opacity: 1;
    transform: none;
    animation: card-float 7s var(--ease-in-out) calc(var(--i) * -1.75s + 2.4s) infinite;
  }

  /* ...and they do not simply appear: each arrives unlit and the light finds
     it, a beat after it lands. The veil is the room's own near-black, so an
     unlit card reads as a dark panel rather than a hole in the layout. */
  :global([data-js]) [data-animate='deck'] .uc::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    background-color: var(--ink);
    opacity: 1;
    transition: opacity 900ms var(--ease-out) calc(var(--i) * 130ms + 700ms);
  }

  :global([data-js]) [data-animate='deck'][data-in] .uc::before {
    opacity: 0;
  }

  @keyframes card-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-7px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-js]) [data-animate='deck'] .units__cell,
    :global([data-js]) [data-animate='deck'][data-in] .units__cell {
      opacity: 1;
      transform: none;
      transition: none;
      animation: none;
    }

    /* nothing arrives unlit when motion is refused: the veil never exists */
    :global([data-js]) [data-animate='deck'] .uc::before {
      display: none;
    }
  }

  /* The card: image on top, words underneath. Under a pointer it leans
     toward the hand (--rx/--ry from the tilt driver) and lifts. */
  .uc {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: 20px;
    overflow: hidden;
    background-color: #fffdf9;
    box-shadow:
      0 2px 6px rgba(0, 0, 0, 0.45),
      0 26px 70px rgba(0, 0, 0, 0.55);
    text-decoration: none;
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg))
      translateY(var(--uy, 0px));
    transition:
      transform 260ms var(--ease-out),
      box-shadow 260ms var(--ease-out);
  }

  /* a light sweeps across each card, one after another */
  .uc::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background-image: linear-gradient(115deg, transparent 38%, rgba(255, 255, 255, 0.34) 50%, transparent 62%);
    transform: translateX(-120%);
    animation: card-sheen 8s var(--ease-in-out) calc(var(--i) * 0.55s + 3s) infinite;
  }

  @keyframes card-sheen {
    0%,
    62%,
    100% {
      transform: translateX(-120%);
    }
    30% {
      transform: translateX(120%);
    }
  }

  .uc:hover {
    --uy: -10px;
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.5),
      0 30px 80px rgba(10, 91, 101, 0.55),
      0 0 0 1px rgba(75, 216, 232, 0.35);
  }

  @media (prefers-reduced-motion: reduce) {
    .uc {
      transition: none;
    }
    .uc:hover {
      --uy: 0px;
    }
    .uc::after {
      animation: none;
    }
  }

  .uc__media {
    position: relative;
    height: clamp(190px, 30vh, 340px);
    overflow: hidden;
  }

  .uc__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }

  .uc__media[data-fit='top'] img {
    object-position: top center;
  }

  .uc:hover .uc__media img {
    transform: scale(1.06);
  }

  .uc__media[data-pattern='aisle'] {
    background-color: var(--t);
    background-image:
      repeating-linear-gradient(100deg, rgba(11, 15, 16, 0.16) 0 2px, transparent 2px 46px),
      repeating-linear-gradient(80deg, rgba(255, 255, 255, 0.14) 0 1px, transparent 1px 32px),
      linear-gradient(115deg, var(--t-glow), var(--t) 55%, var(--t-floor));
  }

  .uc__media[data-pattern='route'] {
    background-color: var(--t);
    background-image:
      repeating-linear-gradient(115deg, rgba(255, 255, 255, 0.2) 0 12px, transparent 12px 30px),
      linear-gradient(155deg, var(--t) 30%, var(--t-floor));
  }

  .uc__media[data-pattern='bloom'] {
    background-color: var(--t);
    background-image:
      radial-gradient(circle, rgba(255, 255, 255, 0.24) 0 26%, transparent 27%),
      radial-gradient(circle, rgba(11, 15, 16, 0.07) 0 18%, transparent 19%),
      linear-gradient(140deg, var(--t-glow), var(--t) 52%, var(--t-floor));
    background-size: 64px 64px, 38px 38px, 100% 100%;
    background-position: 0 0, 19px 27px, 0 0;
  }

  /* The drawn fields drift, slowly, forever. Photographs hold still. */
  @media (prefers-reduced-motion: no-preference) {
    .uc__media[data-pattern] {
      animation: field-drift 36s linear infinite alternate;
    }
  }

  @keyframes field-drift {
    to {
      background-position:
        140px -40px,
        -90px 60px,
        0 0;
    }
  }

  /* The index rides on its own scrim: photographs cannot promise contrast.
     Under the hand it turns to the brand colour, with near-black on it. */
  /* Above the card's light sweep (z-index 2). The sweep is a white wash, and
     this scrim carries white text: letting the wash cross it would thin the
     one pairing on the card that has no margin to give. */
  .uc__n {
    position: absolute;
    z-index: 3;
    left: 0.875rem;
    top: 0.875rem;
    padding: 0.32rem 0.32rem 0.32rem 0.6rem;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    color: #fffdf9;
    background-color: rgba(11, 15, 16, 0.72);
    transition:
      background-color var(--d-micro) var(--ease-out),
      color var(--d-micro) var(--ease-out);
  }

  .uc:hover .uc__n {
    background-color: var(--t);
    color: var(--ink);
  }

  /* text under the card's image, as asked: name, one line, the exit */
  .uc__caption {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
