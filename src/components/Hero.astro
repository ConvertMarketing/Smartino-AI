---
import { Image } from 'astro:assets';
import familie from '../assets/photos/familie-lounge.jpg';
import { COMPANY, UNITS, SUPERMARKET_HOURS } from '../lib/data';

/**
 * The hero: the whole group at once, four store cards side by side.
 *
 * No carousel. All four units are permanently in sight, equal citizens on one
 * row (a 2×2 field on narrow screens). Each card is image-on-top, caption
 * underneath: name, one line, the exit.
 *
 * The motion lives in three places: the cards enter with a staggered 3D rise
 * as the page arrives, each card tilts toward the pointer under the hand, and
 * the drawn fields drift slowly forever. Under reduced motion all of it stops
 * and the page is simply there; without JavaScript everything is visible and
 * every link still a link.
 *
 * The units without any real photography (01, 03, 04) carry their drawn
 * fields -- the aisle, the bubbles, the route -- rather than a fake photo.
 */
const hoursShort = SUPERMARKET_HOURS.map((h) => `${h.open}–${h.close}`).join(' · ');
const [u1, u2, u3, u4] = UNITS;

const cards = [
  { unit: u1, art: null, pattern: 'aisle', href: '#snagov-plaza', exit: hoursShort, line: 'Nevoile zilnice ale familiei, din 2025.' },
  { unit: u2, art: familie, pattern: null, href: u2.href!, exit: u2.domain!, line: 'Peste 1.200 m² de acasă, vizavi.' },
  { unit: u3, art: null, pattern: 'bloom', href: u3.href!, exit: u3.domain!, line: 'Îngrijire și curățenie, livrate în toată țara.' },
  { unit: u4, art: null, pattern: 'route', href: u4.href!, exit: u4.domain!, line: 'Partenerul din Republica Moldova.' },
];
---

<header class="fascia">
  <span class="fascia__mark">SMARTINO</span>
  <span class="fascia__where">{COMPANY.address.oneLine}</span>
</header>

<section class="hero" id="continut">
  <div class="hero__head">
    <p class="hero__over" data-reveal>Smartino International</p>
    <h1 class="hero__title" data-animate="lines">
      <span class="line"><span class="line__in">Un grup crescut</span></span>
      <span class="line"><span class="line__in line__in--t">dintr-un singur magazin.</span></span>
    </h1>
  </div>

  <ul class="units" data-animate="deck" aria-label="Magazinele grupului">
    {
      cards.map((c, i) => (
        <li class="units__cell" style={`--i: ${i}`}>
          <a
            class="uc"
            data-tilt
            href={c.href}
            {...c.href.startsWith('http') ? { rel: 'noopener' } : {}}
            aria-label={
              c.href.startsWith('http')
                ? `${c.unit.name} — deschide ${c.exit}`
                : `${c.unit.name} — vezi adresa și programul`
            }
          >
            <span class="uc__media" data-pattern={c.pattern}>
              {c.art && (
                <Image src={c.art} alt="" widths={[480, 720]} sizes="(min-width: 1024px) 24vw, 46vw" loading="eager" />
              )}
              <span class="uc__n tnum">{c.unit.index}</span>
            </span>
            <span class="uc__caption">
              <span class="uc__name">{c.unit.name.replace('Smartino ', '')}</span>
              <span class="uc__line">{c.line}</span>
              <span class="uc__exit tnum">{c.exit}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <a class="hero__cue" href="#povestea" aria-label="Derulează la poveste">
    <span class="hero__cueLine" aria-hidden="true"></span>
    <span class="hero__cueText">povestea</span>
  </a>
</section>

<style>
  .fascia {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 64px;
    padding-inline: var(--gutter);
    background-color: var(--paper);
    color: var(--fg);
    border-bottom: 1px solid rgba(11, 15, 16, 0.12);
  }

  .fascia__mark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.16em;
  }

  .fascia__where {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: right;
    color: var(--fg-2);
  }

  .hero {
    position: relative;
    min-height: calc(100dvh - 64px);
    display: flex;
    flex-direction: column;
    background-color: var(--paper);
    background-image: radial-gradient(90% 55% at 50% 118%, rgba(19, 180, 198, 0.16), transparent 62%);
    overflow: hidden;
  }

  .hero__head {
    text-align: center;
    padding: clamp(1.25rem, 3.5vh, 2.5rem) var(--gutter) 0;
  }

  .hero__over {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--t-deep);
  }

  .hero__title {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1rem + 3vw, 3.4rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--fg);
  }

  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.05em;
  }

  .line__in {
    display: block;
  }

  :global([data-js]) .line__in {
    transform: translate3d(0, 115%, 0);
    transition: transform 850ms var(--ease-out);
  }

  :global([data-js]) .line:nth-child(2) .line__in {
    transition-delay: 130ms;
  }

  :global([data-js]) [data-animate='lines'][data-in] .line__in {
    transform: none;
  }

  .line__in--t {
    color: var(--t-deep);
  }

  /* ---- the four, all at once -------------------------------------------- */
  .units {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(14px, 1.6vw, 22px);
    width: min(100%, calc(var(--content) + 2 * var(--gutter)));
    padding-inline: var(--gutter);
    margin-inline: auto;
    /* centres the field in the hero's slack; the cue keeps the floor */
    margin-block: auto;
    padding-block: clamp(1.25rem, 3.5vh, 2.5rem) clamp(1rem, 2.5vh, 2rem);
    /* one shared vanishing point for the staggered 3D entry */
    perspective: 1400px;
  }

  /* Entry: each card rises and unfolds toward the viewer, one beat apart. */
  :global([data-js]) [data-animate='deck'] .units__cell {
    opacity: 0;
    transform: translateY(58px) rotateX(14deg) scale(0.95);
    transition:
      transform 950ms var(--ease-out) calc(var(--i) * 110ms + 200ms),
      opacity 650ms var(--ease-out) calc(var(--i) * 110ms + 200ms);
  }

  :global([data-js]) [data-animate='deck'][data-in] .units__cell {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-js]) [data-animate='deck'] .units__cell {
      opacity: 1;
      transform: none;
      transition: none;
    }
    :global([data-js]) .line__in {
      transform: none;
      transition: none;
    }
  }

  /* The card: image on top, words underneath. Under a pointer it leans
     toward the hand (--rx/--ry from the tilt driver) and lifts. */
  .uc {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: 18px;
    overflow: hidden;
    background-color: #fffdf9;
    box-shadow: var(--lift-1);
    text-decoration: none;
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg))
      translateY(var(--uy, 0px));
    transition:
      transform 260ms var(--ease-out),
      box-shadow 260ms var(--ease-out);
  }

  .uc:hover {
    --uy: -8px;
    box-shadow: var(--lift-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .uc {
      transition: none;
    }
    .uc:hover {
      --uy: 0px;
    }
  }

  .uc__media {
    position: relative;
    height: clamp(180px, 28vh, 300px);
  }

  .uc__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .uc__media[data-pattern='aisle'] {
    background-color: var(--t);
    background-image:
      repeating-linear-gradient(100deg, rgba(11, 15, 16, 0.16) 0 2px, transparent 2px 46px),
      repeating-linear-gradient(80deg, rgba(255, 255, 255, 0.14) 0 1px, transparent 1px 32px),
      linear-gradient(115deg, var(--t-glow), var(--t) 55%, var(--t-floor));
  }

  .uc__media[data-pattern='route'] {
    background-color: var(--t);
    background-image:
      repeating-linear-gradient(115deg, rgba(255, 255, 255, 0.2) 0 12px, transparent 12px 30px),
      linear-gradient(155deg, var(--t) 30%, var(--t-floor));
  }

  .uc__media[data-pattern='bloom'] {
    background-color: var(--t);
    background-image:
      radial-gradient(circle, rgba(255, 255, 255, 0.24) 0 26%, transparent 27%),
      radial-gradient(circle, rgba(11, 15, 16, 0.07) 0 18%, transparent 19%),
      linear-gradient(140deg, var(--t-glow), var(--t) 52%, var(--t-floor));
    background-size: 64px 64px, 38px 38px, 100% 100%;
    background-position: 0 0, 19px 27px, 0 0;
  }

  /* The drawn fields drift, slowly, forever. Photographs hold still. */
  @media (prefers-reduced-motion: no-preference) {
    .uc__media[data-pattern] {
      animation: field-drift 36s linear infinite alternate;
    }
  }

  @keyframes field-drift {
    to {
      background-position:
        140px -40px,
        -90px 60px,
        0 0;
    }
  }

  /* The index rides on its own scrim: photographs cannot promise contrast. */
  .uc__n {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    padding: 0.3rem 0.3rem 0.3rem 0.55rem;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    color: #fffdf9;
    background-color: rgba(11, 15, 16, 0.72);
  }

  /* text under the card's image, as asked: name, one line, the exit */
  .uc__caption {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.875rem 1rem 1rem;
    border-top: 1px solid rgba(11, 15, 16, 0.08);
  }

  .uc__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--fg);
  }

  .uc__line {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--fg-2);
  }

  .uc__exit {
    margin-top: auto;
    padding-top: 0.375rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--t-deep);
  }

  /* ---- cue -------------------------------------------------------------- */
  .hero__cue {
    align-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding-bottom: 0.625rem;
    text-decoration: none;
  }

  .hero__cueLine {
    width: 1px;
    height: 24px;
    background-image: linear-gradient(180deg, transparent, var(--t-deep));
    position: relative;
    overflow: hidden;
  }

  .hero__cueLine::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: -40%;
    height: 40%;
    background-color: var(--t);
    animation: cue-drop 1.8s var(--ease-in-out) infinite;
  }

  @keyframes cue-drop {
    to { transform: translateY(350%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cueLine::after { animation: none; }
  }

  .hero__cueText {
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--fg-2);
  }

  @media (max-width: 1023px) {
    .units {
      grid-template-columns: repeat(2, 1fr);
    }

    .uc__media {
      height: clamp(140px, 19vh, 190px);
    }
  }

  @media (max-width: 599px) {
    .fascia__where {
      max-width: 11rem;
      font-size: 0.5625rem;
    }

    .uc__caption {
      padding: 0.625rem 0.75rem 0.75rem;
    }

    .uc__name {
      font-size: 1.0625rem;
    }

    .uc__line {
      font-size: 0.75rem;
    }
  }
</style>
