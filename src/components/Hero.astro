---
import Band from './Band.astro';
import UnitCard from './UnitCard.astro';
import { UNITS, TIMELINE, SUPERMARKET_HOURS } from '../lib/data';

const [supermarket, home, shop, moldova] = UNITS;

/**
 * The pill renders the NEUTRAL hours string, never a computed "open now".
 * The deploy workflow has no schedule trigger, so any state baked at build time
 * would freeze at the last deploy and get indexed that way. Live state belongs
 * to Faza 3, after hydration, with public holidays handled -- otherwise on
 * 25 December the site tells someone driving to Tâncăbești something false.
 */
const hoursLine = SUPERMARKET_HOURS.map((h) => `${h.days} ${h.open}–${h.close}`).join(' · ');
---

<section class="hero" id="continut">
  <Band />

  <div class="hero__inner">
    <h1 class="hero__title">Un grup crescut<br />dintr-un singur magazin.</h1>

    <p class="hero__deck">
      Primul magazin s-a deschis pe {TIMELINE.first.label}, în Snagov Plaza.<br />
      Al doilea, <span class="tnum">{TIMELINE.days}</span> de zile mai târziu, vizavi.
    </p>

    <p class="hero__pill tnum">{hoursLine}</p>

    {/* Row A -- the physical pair. The only one allowed to sit either side of
        the gap, because it is the only one that actually stands that way. */}
    <div class="hero__rowA">
      <UnitCard unit={supermarket} size="large" align="end" />
      <div class="hero__gap" aria-hidden="true"></div>
      <UnitCard unit={home} size="large" align="start" />
    </div>

    {/* Row B -- the online pair. It does NOT straddle the gap, it crosses it:
        smartinoshop.ro and smartino.md do not face each other anywhere, so they
        do not pretend to. The 96px rupture falls before 04. */}
    <div class="hero__rowB">
      <UnitCard unit={shop} size="compact" />
      <div class="hero__rupture" aria-hidden="true"></div>
      <UnitCard unit={moldova} size="compact" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: 3.5rem 4rem;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: var(--content);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.2rem + 2.6vw, 3.5rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .hero__deck {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-slate);
  }

  .hero__pill {
    display: inline-block;
    margin-top: 1.25rem;
    padding: 0.4375rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--color-line-strong);
    font-size: 0.8125rem;
    color: var(--color-ink);
  }

  .hero__rowA {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: 1fr var(--band) 1fr;
  }

  .hero__rowB {
    margin-top: 1.25rem;
    display: grid;
    grid-template-columns: 1fr 96px 1fr;
  }

  .hero__gap,
  .hero__rupture {
    /* Deliberately empty. The gap is the signature; it never gets content. */
  }

  /* Below 900 the gap rotates: the physical pair stacks and the emptiness
   * becomes horizontal. Same mechanism, turned 90 degrees -- not a fallback. */
  @media (max-width: 899px) {
    .hero__rowA {
      grid-template-columns: 1fr;
      gap: var(--band);
    }
    .hero__rowA .hero__gap {
      display: none;
    }
    .hero__rowB {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .hero__rowB .hero__rupture {
      display: none;
    }
  }
</style>
