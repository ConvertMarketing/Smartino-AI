---
import { Image } from 'astro:assets';
import terasa from '../assets/photos/gradina-terasa.jpg';
import { COMPANY, SUPERMARKET_HOURS } from '../lib/data';

/**
 * The hero IS the concept, in one gesture: two worlds facing each other across
 * a seam you can drag. Left, the daily-needs world of the first store, drawn
 * in flat brand turquoise with its aisle lines; right, the home world of the
 * second, in real photography from the group's own campaign. The wordmark
 * sits astride the seam, belonging to both.
 *
 * The seam is a real <input type="range">, full-bleed and invisible, so
 * dragging, touch and arrow keys all come free from the platform. Without JS
 * the split simply rests at half.
 */
const hoursShort = SUPERMARKET_HOURS.map((h) => `${h.open}–${h.close}`).join(' · ');
---

<header class="fascia">
  <span class="fascia__mark">SMARTINO</span>
  <span class="fascia__where">{COMPANY.address.oneLine}</span>
</header>

<section class="split" id="continut" data-split>
  {/* Right world: home. Sits underneath, full-bleed. */}
  <div class="split__world split__world--home" aria-hidden="true">
    <Image
      class="split__photo"
      src={terasa}
      alt=""
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <span class="split__scrim"></span>
    <p class="split__tag split__tag--right tnum">2026 · Smartino Home · 1.200 m²</p>
  </div>

  {/* Left world: daily needs. Clipped by the seam. */}
  <div class="split__world split__world--daily" aria-hidden="true">
    <span class="split__aisle"></span>
    <p class="split__tag split__tag--left tnum">2025 · Smartino Supermarket · {hoursShort}</p>
  </div>

  {/* The seam itself. */}
  <span class="seam" aria-hidden="true">
    <span class="seam__grip">
      <span class="seam__chev">‹</span><span class="seam__chev">›</span>
    </span>
  </span>

  <input
    class="seam__input"
    type="range"
    min="16"
    max="84"
    value="50"
    step="1"
    aria-label="Trage cusătura dintre cele două magazine"
  />

  {/* The statement, astride the seam. */}
  <div class="split__statement">
    <h1 class="split__title" data-animate="lines">
      <span class="line"><span class="line__in">SMARTINO</span></span>
    </h1>
    <p class="split__sub" data-reveal>INTERNATIONAL</p>
    <p class="split__line" data-reveal style="--i: 1">
      Două magazine față în față. Un singur grup.
    </p>
  </div>

  <a class="split__cue" href="#povestea" aria-label="Derulează la poveste">
    <span class="split__cueLine" aria-hidden="true"></span>
    <span class="split__cueText">povestea</span>
  </a>
</section>

<style>
  .fascia {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 5;
    /* its own scrim: the bar must stay legible over any photo underneath,
     * not borrow legibility from whatever happens to be there */
    background-image: linear-gradient(180deg, rgba(11, 15, 16, 0.55), transparent);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 64px;
    padding-inline: var(--gutter);
    color: var(--fg-inv);
  }

  .fascia__mark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.16em;
  }

  .fascia__where {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: right;
    opacity: 0.85;
  }

  .split {
    position: relative;
    height: 100dvh;
    min-height: 560px;
    overflow: hidden;
    background-color: var(--ink);
    --split: 50%;
  }

  .split__world {
    position: absolute;
    inset: 0;
  }

  .split__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .split__scrim {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(180deg, rgba(11, 15, 16, 0.42), rgba(11, 15, 16, 0.12) 45%, rgba(11, 15, 16, 0.5));
  }

  /* The daily world: flat brand turquoise, aisle lines running to the seam. */
  .split__world--daily {
    background-color: var(--t);
    background-image:
      repeating-linear-gradient(100deg, rgba(11, 15, 16, 0.16) 0 2px, transparent 2px 64px),
      repeating-linear-gradient(80deg, rgba(255, 255, 255, 0.14) 0 1px, transparent 1px 44px),
      linear-gradient(115deg, var(--t-glow), var(--t) 55%, var(--t-floor));
    clip-path: inset(0 calc(100% - var(--split)) 0 0);
    will-change: clip-path;
  }

  .split__tag {
    position: absolute;
    bottom: 5.5rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .split__tag--left {
    left: var(--gutter);
    color: var(--ink);
  }

  .split__tag--right {
    right: var(--gutter);
    color: var(--fg-inv);
    text-shadow: 0 1px 8px rgba(11, 15, 16, 0.7);
  }

  /* ---- the seam --------------------------------------------------------- */
  .seam {
    position: absolute;
    inset-block: 0;
    left: var(--split);
    width: 2px;
    margin-left: -1px;
    background-color: var(--paper);
    box-shadow: 0 0 24px rgba(75, 216, 232, 0.6);
    pointer-events: none;
    z-index: 3;
  }

  .seam__grip {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
    background-color: var(--paper);
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 800;
    box-shadow: var(--lift-2);
  }

  .split:hover .seam__grip {
    animation: grip-nudge 1.6s var(--ease-in-out) infinite;
  }

  @keyframes grip-nudge {
    0%, 100% { transform: translate(-50%, -50%); }
    50% { transform: translate(calc(-50% + 5px), -50%); }
  }

  .seam__input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: ew-resize;
    z-index: 4;
    margin: 0;
    -webkit-appearance: none;
    appearance: none;
  }

  .seam__input::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 96px;
    height: 100%;
  }

  .seam__input:focus-visible ~ .split__statement .split__title,
  .seam__input:focus-visible + .split__statement .split__title {
    outline: 3px solid var(--paper);
    outline-offset: 8px;
  }

  /* ---- the statement ---------------------------------------------------- */
  .split__statement {
    position: absolute;
    inset-inline: 0;
    top: 50%;
    transform: translateY(-58%);
    text-align: center;
    pointer-events: none;
    z-index: 3;
    padding-inline: var(--gutter);
  }

  .split__title {
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 1rem + 12.5vw, 12.5rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: 0.01em;
    color: var(--paper);
    text-shadow: 0 2px 40px rgba(11, 15, 16, 0.35);
  }

  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.05em;
  }

  .line__in {
    display: block;
  }

  :global([data-js]) .line__in {
    transform: translate3d(0, 112%, 0);
    transition: transform 950ms var(--ease-out) 100ms;
  }

  :global([data-js]) [data-animate='lines'][data-in] .line__in {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-js]) .line__in {
      transform: none;
      transition: none;
    }
    .split:hover .seam__grip {
      animation: none;
    }
  }

  .split__sub {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(0.6875rem, 0.5rem + 1vw, 1rem);
    font-weight: 700;
    letter-spacing: 0.58em;
    text-indent: 0.58em;
    color: var(--paper);
    opacity: 0.92;
  }

  .split__line {
    margin-top: 1.25rem;
    font-size: clamp(0.875rem, 0.8rem + 0.4vw, 1.0625rem);
    color: var(--paper);
    opacity: 0.85;
    text-shadow: 0 1px 10px rgba(11, 15, 16, 0.5);
  }

  /* ---- cue -------------------------------------------------------------- */
  .split__cue {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
  }

  .split__cueLine {
    width: 1px;
    height: 40px;
    background-image: linear-gradient(180deg, transparent, var(--paper));
    position: relative;
    overflow: hidden;
  }

  .split__cueLine::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: -40%;
    height: 40%;
    background-color: var(--t-glow);
    animation: cue-drop 1.8s var(--ease-in-out) infinite;
  }

  @keyframes cue-drop {
    to { transform: translateY(350%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .split__cueLine::after { animation: none; }
  }

  .split__cueText {
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--paper);
    opacity: 0.85;
  }

  /* ---- small screens: same vertical seam, same gesture ------------------ */
  @media (max-width: 767px) {
    .split__tag {
      font-size: 0.5625rem;
      letter-spacing: 0.08em;
      max-width: 38vw;
      line-height: 1.5;
    }

    .split__tag--left {
      bottom: 7.5rem;
    }

    .split__tag--right {
      bottom: 5rem;
      text-align: right;
    }

    .fascia__where {
      max-width: 11rem;
      font-size: 0.5625rem;
    }
  }
</style>
