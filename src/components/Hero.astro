---
import Fascia from './Fascia.astro';
import Band from './Band.astro';
import UnitCard from './UnitCard.astro';
import { UNITS, TIMELINE, SUPERMARKET_HOURS } from '../lib/data';

const [supermarket, home, shop, moldova] = UNITS;

/**
 * The pill renders the NEUTRAL hours string, never a computed "open now".
 * The deploy workflow has no schedule trigger, so state baked at build time
 * would freeze at the last deploy and be indexed that way. Live state is Faza 3,
 * after hydration, with public holidays handled.
 */
const hoursLine = SUPERMARKET_HOURS.map((h) => `${h.days} ${h.open}–${h.close}`).join(' · ');
---

<div class="top">
  <Fascia />

  <section class="hero" id="continut">
    <div class="hero__inner">
      <h1 class="hero__title" data-reveal>Un grup crescut<br />dintr-un singur magazin.</h1>

      <p class="hero__deck" data-reveal style="--i: 1">
        Primul magazin s-a deschis pe {TIMELINE.first.label}, în Snagov Plaza.<br />
        Al doilea, <span class="tnum">{TIMELINE.days}</span> de zile mai târziu, vizavi.
      </p>

      <p class="hero__pill tnum" data-reveal data-schedule style="--i: 2">{hoursLine}</p>

      {/* The band starts here, not at the top of the section. The H1 still
          crosses the axis, but marks running through the letterforms read as a
          rendering glitch rather than as a measure. */}
      <div class="hero__rows" data-rows>
        <Band tone="dark" />

      {/* Row A -- the physical pair. The only one allowed to sit either side of
          the gap, because it is the only one that actually stands that way. */}
      <div class="hero__rowA" data-reveal style="--i: 3">
        <UnitCard unit={supermarket} size="large" align="end" dataUnit="01" />
        <div class="hero__gap" aria-hidden="true">
          <span class="hero__rule"></span>
          <span class="hero__tag" data-for="01">01 →</span>
          <span class="hero__tag" data-for="02">← 02</span>
        </div>
        <UnitCard unit={home} size="large" align="start" dataUnit="02" />
      </div>

      {/* Row B -- the online pair. It does NOT straddle the gap, it crosses it:
          these two do not face each other anywhere, so they do not pretend to.
          The 96px rupture falls before 04. */}
      <div class="hero__rowB" data-reveal style="--i: 4">
        <UnitCard unit={shop} size="compact" />
        <div class="hero__rupture" aria-hidden="true"></div>
        <UnitCard unit={moldova} size="compact" />
      </div>
      </div>
    </div>
  </section>
</div>

<style>
  /* One continuous dark surface from the first pixel to the end of the hero.
   * The turquoise is a large field here, not a thin accent -- a wide glow
   * behind the cards plus a deep stop at the foot. */
  .top {
    position: relative;
    background-color: var(--ink);
    background-image:
      radial-gradient(120% 85% at 18% 0%, rgba(19, 180, 198, 0.38) 0%, transparent 62%),
      radial-gradient(90% 70% at 92% 26%, rgba(75, 216, 232, 0.2) 0%, transparent 58%),
      linear-gradient(180deg, transparent 55%, rgba(10, 91, 101, 0.55) 100%);
    color: var(--fg-inv);
    overflow: hidden;
  }

  .hero {
    position: relative;
    padding-block: 5rem 5.5rem;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: var(--content);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.4rem + 4.4vw, 5rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .hero__deck {
    margin-top: 1.75rem;
    max-width: 36rem;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.1875rem);
    line-height: 1.55;
    color: var(--fg-inv-2);
  }

  .hero__pill {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.5rem 1.125rem;
    border-radius: 999px;
    border: 1px solid rgba(19, 180, 198, 0.5);
    background-color: rgba(19, 180, 198, 0.08);
    font-size: 0.8125rem;
    color: var(--t);
  }

  .hero__rows {
    position: relative;
  }

  .hero__rowA {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: 1fr var(--band) 1fr;
  }

  .hero__rowB {
    margin-top: 1.25rem;
    display: grid;
    grid-template-columns: 1fr 96px 1fr;
  }

  /* The gap stays empty of CONTENT. What crosses it is the response itself:
   * a rule and a direction label, both decorative and aria-hidden. */
  .hero__gap {
    position: relative;
    display: grid;
    place-items: center;
  }

  .hero__rupture {
    /* Deliberately empty. */
  }

  .hero__rule {
    position: absolute;
    top: 50%;
    left: 8%;
    width: 84%;
    height: 2px;
    background-color: var(--t);
    transform: scaleX(0);
    transition: transform var(--d-micro) var(--ease-out);
  }

  [data-active='01'] .hero__rule {
    transform-origin: left center;
    transform: scaleX(1);
  }

  [data-active='02'] .hero__rule {
    transform-origin: right center;
    transform: scaleX(1);
  }

  .hero__tag {
    position: absolute;
    top: calc(50% + 0.875rem);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--t);
    opacity: 0;
    transition: opacity var(--d-micro) var(--ease-out);
  }

  [data-landed][data-active='01'] .hero__tag[data-for='01'],
  [data-landed][data-active='02'] .hero__tag[data-for='02'] {
    opacity: 1;
  }

  /* The answer: the card OPPOSITE the active one takes the edge. Hovering 01
   * lights 02; hovering 02 sends it back. */
  /* :global because the cards are rendered by UnitCard.astro, so Astro's
   * per-component style scoping would otherwise never match them from here. */
  [data-active='01'] :global([data-unit='02']),
  [data-active='02'] :global([data-unit='01']) {
    box-shadow:
      0 0 0 3px var(--t),
      var(--lift-t);
  }

  :global([data-unit]) {
    transition: box-shadow var(--d-micro) var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    /* The rule does not travel and the label does not fade. The meaning still
     * arrives in full: which unit answers is carried by the edge and the label,
     * not by the movement. */
    .hero__rule,
    .hero__tag,
    :global([data-unit]) {
      transition-duration: 0ms;
    }
  }

  @media (max-width: 899px) {
    .hero {
      padding-block: 3rem 3.5rem;
    }
    .hero__rowA {
      grid-template-columns: 1fr;
      gap: var(--band);
    }
    .hero__rowB {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .hero__gap,
    .hero__rupture {
      display: none;
    }
  }
</style>
