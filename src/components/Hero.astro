---
import Fascia from './Fascia.astro';
import { UNITS, SUPERMARKET_HOURS } from '../lib/data';

/**
 * The hero as a poster, not a dashboard.
 *
 * One enormous statement over the 3D scene, everything else reduced to a thin
 * brand index along the bottom. The cards' information is not lost -- every
 * unit has its full section below; up here the four directions are exactly
 * four lines. The response interaction survives on the index: hovering 01
 * makes 02 answer (and the 3D building flare with it), because those two are
 * the only pair that actually faces across anything.
 */
const [supermarket, home, shop, moldova] = UNITS;
const hoursShort = SUPERMARKET_HOURS.map((h) => `${h.open}–${h.close}`).join(' · ');

const index = [
  { unit: supermarket, dataUnit: '01', href: '#snagov-plaza', meta: 'schedule', arrow: '\u2193\uFE0E' },
  { unit: home, dataUnit: '02', href: home.href!, meta: home.domain!, arrow: '\u2197\uFE0E' },
  { unit: shop, dataUnit: null, href: shop.href!, meta: shop.domain!, arrow: '\u2197\uFE0E' },
  { unit: moldova, dataUnit: null, href: moldova.href!, meta: moldova.domain!, arrow: '\u2197\uFE0E' },
];
---

<div class="top">
  {/* The motion behind everything: two large turquoise fields drifting on
      70s/55s loops. Transform-only, aria-hidden, killed under reduced motion. */}
  <div class="top__glow top__glow--a" aria-hidden="true"></div>
  <div class="top__glow top__glow--b" aria-hidden="true"></div>

  {/* The Three.js VIZAVI scene mounts here, lazily, behind everything.
      Without JS or under reduced motion the glows above are the whole floor. */}
  <div class="top__scene" data-scene aria-hidden="true"></div>

  <Fascia />

  <section class="hero" id="continut">
    <div class="hero__inner">
      <div class="hero__statement">
        <p class="hero__over" data-reveal>Smartino International · Snagov Plaza</p>

        <h1 class="hero__title" data-animate="lines">
          <span class="line"><span class="line__in">Un grup crescut</span></span>
          <span class="line"><span class="line__in line__in--grad">dintr-un singur magazin.</span></span>
        </h1>

        <p class="hero__deck" data-reveal style="--i: 2">
          Două magazine față în față pe DN-1, două cataloage online, două țări.
        </p>
      </div>

      {/* The brand index: four directions, four lines. */}
      <nav class="hx" aria-label="Direcțiile grupului" data-rows data-reveal style="--i: 3">
        {
          index.map((row, i) => (
            <a
              class="hx__item"
              href={row.href}
              data-unit={row.dataUnit}
              style={`--hxi: ${i}`}
              {...row.href.startsWith('http') ? { rel: 'noopener' } : {}}
              aria-label={
                row.href.startsWith('http')
                  ? `${row.unit.name} — deschide ${row.meta}`
                  : `${row.unit.name} — vezi adresa și programul`
              }
            >
              <span class="hx__n tnum">{row.unit.index}</span>
              <span class="hx__name">{row.unit.name.replace('Smartino ', '')}</span>
              <span class="hx__meta tnum" {...row.meta === 'schedule' ? { 'data-schedule': '' } : {}}>
                {row.meta === 'schedule' ? hoursShort : row.meta}
              </span>
              <span class="hx__arrow" aria-hidden="true">{row.arrow}</span>
            </a>
          ))
        }
      </nav>
    </div>

    {/* The scroll cue sits on the band's axis. */}
    <a class="hero__cue" href="#povestea" aria-label="Derulează la poveste">
      <span class="hero__cueLine" aria-hidden="true"></span>
      <span class="hero__cueText">povestea</span>
    </a>
  </section>
</div>

<style>
  .top {
    position: relative;
    background-color: var(--ink);
    background-image:
      radial-gradient(120% 85% at 18% 0%, rgba(19, 180, 198, 0.34) 0%, transparent 62%),
      radial-gradient(90% 70% at 92% 26%, rgba(75, 216, 232, 0.18) 0%, transparent 58%),
      linear-gradient(180deg, transparent 55%, rgba(10, 91, 101, 0.5) 100%);
    color: var(--fg-inv);
    overflow: hidden;
  }

  .top__glow {
    position: absolute;
    border-radius: 999px;
    pointer-events: none;
  }

  .top__glow--a {
    top: -18%;
    left: -12%;
    width: 68vw;
    height: 68vw;
    background-image: radial-gradient(closest-side, rgba(19, 180, 198, 0.42), transparent 70%);
    animation: drift-a 70s ease-in-out infinite alternate;
  }

  .top__glow--b {
    top: 18%;
    right: -16%;
    width: 55vw;
    height: 55vw;
    background-image: radial-gradient(closest-side, rgba(75, 216, 232, 0.26), transparent 72%);
    animation: drift-b 55s ease-in-out infinite alternate;
  }

  @media (prefers-reduced-motion: reduce) {
    .top__glow {
      animation: none;
    }
  }

  .top__scene {
    position: absolute;
    inset: 0;
    pointer-events: none;
    mask-image: linear-gradient(180deg, black 68%, transparent 98%);
  }

  .hero {
    position: relative;
    min-height: calc(100dvh - 72px);
    display: flex;
    flex-direction: column;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    flex: 1;
    width: 100%;
    max-width: var(--content);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-block: clamp(2rem, 6vh, 4.5rem) clamp(4rem, 9vh, 6.5rem);
  }

  .hero__over {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--t);
  }

  /* The poster. Big enough to be the hero on its own. */
  .hero__title {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 1rem + 7.2vw, 7.25rem);
    font-weight: 800;
    line-height: 0.99;
    letter-spacing: -0.04em;
  }

  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.09em;
    margin-bottom: -0.06em;
  }

  .line__in {
    display: block;
  }

  :global([data-js]) .line__in {
    transform: translate3d(0, 118%, 0);
    transition: transform 900ms var(--ease-out);
  }

  :global([data-js]) .line:nth-child(2) .line__in {
    transition-delay: 150ms;
  }

  :global([data-js]) [data-animate='lines'][data-in] .line__in {
    transform: none;
  }

  .line__in--grad {
    background-image: linear-gradient(92deg, var(--t-glow), var(--t) 72%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-js]) .line__in {
      transform: none;
      transition: none;
    }
  }

  .hero__deck {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: clamp(0.9375rem, 0.9rem + 0.25vw, 1.0625rem);
    line-height: 1.6;
    color: var(--fg-inv-2);
  }

  /* ---- The brand index -------------------------------------------------- */
  .hx {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .hx__item {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'n arrow'
      'name arrow'
      'meta arrow';
    align-content: start;
    row-gap: 0.375rem;
    padding: 1.375rem 1.25rem 1.25rem 0;
    margin-right: 1.25rem;
    border-top: 2px solid transparent;
    margin-top: -1px;
    text-decoration: none;
    color: var(--fg-inv);
    transition:
      border-color var(--d-micro) var(--ease-out),
      background-color var(--d-micro) var(--ease-out);
  }

  .hx__item + .hx__item {
    border-left: 1px solid rgba(255, 255, 255, 0.09);
    padding-left: 1.25rem;
  }

  .hx__item:hover {
    border-top-color: var(--t);
  }

  .hx__n {
    grid-area: n;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    color: var(--t);
  }

  .hx__name {
    grid-area: name;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .hx__meta {
    grid-area: meta;
    font-size: 0.75rem;
    color: var(--fg-inv-2);
  }

  .hx__arrow {
    font-family: var(--font-display);
    grid-area: arrow;
    justify-self: end;
    align-self: start;
    font-size: 1rem;
    color: var(--t);
    transition: transform var(--d-micro) var(--ease-out);
  }

  .hx__item:hover .hx__arrow {
    transform: translate(3px, -3px);
  }

  .hx__item[href^='#']:hover .hx__arrow {
    transform: translateY(3px);
  }

  /* The response, on the index: activating one physical unit lights the
   * other's number and top rule. The 3D buildings flare with it. */
  :global([data-active='01']) .hx__item[data-unit='02'],
  :global([data-active='02']) .hx__item[data-unit='01'] {
    border-top-color: var(--t-glow);
    background-color: rgba(19, 180, 198, 0.07);
  }

  :global([data-active='01']) .hx__item[data-unit='02'] .hx__n,
  :global([data-active='02']) .hx__item[data-unit='01'] .hx__n {
    color: var(--t-glow);
    text-shadow: 0 0 14px rgba(75, 216, 232, 0.8);
  }

  /* ---- The scroll cue --------------------------------------------------- */
  .hero__cue {
    position: relative;
    z-index: 1;
    align-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 1.25rem;
    text-decoration: none;
  }

  .hero__cueLine {
    width: 1px;
    height: 44px;
    background-image: linear-gradient(180deg, transparent, var(--t) 30%, var(--t));
    overflow: hidden;
    position: relative;
  }

  .hero__cueLine::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: -40%;
    height: 40%;
    background-color: var(--t-glow);
    animation: cue-drop 1.8s var(--ease-in-out) infinite;
  }

  @keyframes cue-drop {
    to {
      transform: translateY(350%);
    }
  }

  .hero__cueText {
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--fg-inv-2);
  }

  .hero__cue:hover .hero__cueText {
    color: var(--t-glow);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cueLine::after {
      animation: none;
    }
  }

  /* ---- Small screens ---------------------------------------------------- */
  @media (max-width: 899px) {
    .hero {
      min-height: calc(100dvh - 56px);
    }

    .hx {
      grid-template-columns: 1fr;
      border-top: none;
    }

    .hx__item {
      grid-template-areas: 'n name arrow' 'n meta arrow';
      grid-template-columns: 2.25rem 1fr auto;
      row-gap: 0.125rem;
      column-gap: 0.25rem;
      padding: 0.875rem 0;
      margin-right: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
    }

    .hx__item + .hx__item {
      border-left: none;
      padding-left: 0;
    }

    .hx__name {
      font-size: 1.0625rem;
    }
  }
</style>
