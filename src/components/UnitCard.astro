---
import type { Unit } from '../lib/data';
import { SUPERMARKET_HOURS } from '../lib/data';

interface Props {
  unit: Unit;
  size: 'large' | 'compact';
  align?: 'start' | 'end';
  /** Marks a card as a participant in the response interaction. Only the two
   *  physical units carry it -- they are the only pair that actually faces
   *  across the gap. */
  dataUnit?: string;
}
const { unit, size, align = 'start', dataUnit } = Astro.props;

/**
 * Smartino Supermarket has no site, no logo and no asset anywhere in the
 * group's estate -- and is still its first physical store. Its card is DRAWN
 * rather than filled: an outline on the dark ground, with the live hours where
 * the others carry a domain. Against the solid turquoise panel next to it the
 * difference is structural and impossible to miss.
 *
 * It is an <a href="#snagov-plaza">, not a button with aria-expanded: nothing
 * expands in place. The anchor also works without JS and survives middle-click.
 * Three doors lead out of the site. The fourth leads deeper into it.
 */
const drawn = !unit.href;
const href = unit.href ?? '#snagov-plaza';
const external = Boolean(unit.href);
const label = external
  ? `${unit.name} — deschide ${unit.domain}`
  : `${unit.name} — vezi adresa și programul magazinului`;
---

<a
  class:list={['card', `card--${size}`, drawn ? 'card--drawn' : 'card--filled']}
  href={href}
  aria-label={label}
  data-align={align}
  data-unit={dataUnit}
  {...external ? { rel: 'noopener' } : {}}
>
  <span class="card__index tnum">{unit.index}</span>

  <span class="card__body">
    <span class="card__name">{unit.name}</span>
    <span class="card__presence">{unit.presence}</span>
  </span>

  {
    drawn ? (
      <span class="card__hours tnum">
        {SUPERMARKET_HOURS.map((h) => (
          <span class="card__hoursRow">
            <span>{h.days}</span>
            <span>
              {h.open}–{h.close}
            </span>
          </span>
        ))}
        <span class="card__noSite">fără site — magazin fizic</span>
      </span>
    ) : (
      <span class="card__door">
        <span>{unit.domain}</span>
        <span class="card__arrow" aria-hidden="true">↗</span>
      </span>
    )
  }
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    border-radius: 20px;
    text-decoration: none;
  }

  .card[data-align='end'] {
    text-align: right;
    align-items: flex-end;
  }

  .card--large {
    min-height: 300px;
  }

  .card--compact {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 92px;
    padding: 1.125rem 1.5rem;
    border-radius: 16px;
  }

  /* The solid turquoise panel. It carries NEAR-BLACK, never white: white on
   * this colour is 2.51:1, near-black is 7.68:1. */
  .card--filled {
    background-image: linear-gradient(145deg, var(--t-glow), var(--t));
    color: var(--fg);
    box-shadow: var(--lift-t);
  }

  /* The drawn card. Outline on the dark ground, turquoise text at 7.68:1. */
  .card--drawn {
    border: 2px solid var(--t);
    background-color: rgba(19, 180, 198, 0.06);
    color: var(--t);
  }

  .card--compact.card--filled {
    background-image: none;
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(19, 180, 198, 0.45);
    color: var(--t);
    box-shadow: none;
  }

  .card__index {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    opacity: 0.75;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .card--compact .card__body {
    flex-direction: row;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    flex: 1;
  }

  .card__name {
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .card--compact .card__name {
    font-size: 1.125rem;
  }

  .card__presence {
    font-size: 0.875rem;
    opacity: 0.72;
  }

  .card__door {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5625rem 1rem;
    border-radius: 999px;
    font-size: 0.875rem;
  }

  .card--filled:not(.card--compact) .card__door {
    background-color: var(--fg);
    color: var(--t-glow);
  }

  .card--compact .card__door {
    border: 1px solid rgba(19, 180, 198, 0.5);
  }

  .card__hours {
    display: flex;
    flex-direction: column;
    gap: 0.3125rem;
    font-size: 0.875rem;
    width: 100%;
    max-width: 17rem;
  }

  .card[data-align='end'] .card__hours {
    margin-left: auto;
  }

  .card__hoursRow {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgba(19, 180, 198, 0.3);
    padding-bottom: 0.3125rem;
  }

  .card__noSite {
    margin-top: 0.375rem;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  @media (max-width: 599px) {
    .card--compact {
      flex-direction: column;
      align-items: flex-start;
    }
    .card[data-align='end'] {
      text-align: left;
      align-items: flex-start;
    }
    .card[data-align='end'] .card__hours {
      margin-left: 0;
    }
  }
</style>
