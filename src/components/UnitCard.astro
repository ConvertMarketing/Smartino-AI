---
import type { Unit } from '../lib/data';
import { SUPERMARKET_HOURS } from '../lib/data';

interface Props {
  unit: Unit;
  size: 'large' | 'compact';
  /** Which way the card's content faces. The physical pair face each other
   *  across the band, because that is how they actually stand in Snagov Plaza. */
  align?: 'start' | 'end';
}
const { unit, size, align = 'start' } = Astro.props;

/**
 * Smartino Supermarket has no site, no logo and no asset anywhere in the group's
 * estate -- and is still its first physical store. So its card is DRAWN rather
 * than filled: no tint, a 2px Line Strong outline at 3.23:1, a hatched floor,
 * and the live opening hours where the other three carry a domain.
 *
 * It is an <a href="#snagov-plaza">, not a button with aria-expanded: nothing
 * expands in place, so that ARIA would be a lie. An anchor also works without
 * JS, survives middle-click and copy-link, and gets focus handling for free.
 *
 * Three doors lead out of the site. The fourth leads deeper into it.
 */
const drawn = !unit.href;
const href = unit.href ?? '#snagov-plaza';
const external = Boolean(unit.href);

const label = external
  ? `${unit.name} — deschide ${unit.domain}`
  : `${unit.name} — vezi adresa și programul magazinului`;
---

<a
  class:list={['card', `card--${size}`, { 'card--drawn': drawn }]}
  href={href}
  aria-label={label}
  data-align={align}
  style={`--accent: var(--color-${unit.token}); --accent-deep: var(--color-${unit.token}-deep);`}
  {...external ? { rel: 'noopener' } : {}}
>
  <span class="card__index tnum">{unit.index}</span>

  <span class="card__body">
    <span class="card__name">{unit.name}</span>
    <span class="card__presence">{unit.presence}</span>
  </span>

  {
    drawn ? (
      <span class="card__hours tnum">
        {SUPERMARKET_HOURS.map((h) => (
          <span class="card__hoursRow">
            <span>{h.days}</span>
            <span>
              {h.open}–{h.close}
            </span>
          </span>
        ))}
        <span class="card__noSite">fără site — magazin fizic</span>
      </span>
    ) : (
      <span class="card__door">
        <span>{unit.domain}</span>
        <span class="card__arrow" aria-hidden="true">↗</span>
      </span>
    )
  }
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    border-radius: 16px;
    border: 1px solid var(--color-line-strong);
    /* 10%, not 14%. The deep step has to stay >=4.5:1 against whatever this
     * mixes to, and at 14% Moldova's deep landed on 4.43:1 -- measured on the
     * rendered pixels, not on the palette against plain Canvas. */
    background-color: color-mix(in oklab, var(--accent) 10%, var(--color-canvas));
    color: var(--color-ink);
    text-decoration: none;
  }

  .card[data-align='end'] {
    text-align: right;
    align-items: flex-end;
  }

  .card--large {
    min-height: 288px;
  }

  .card--compact {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 88px;
    padding: 1rem 1.5rem;
  }

  /* The drawn card: outline and hatch instead of fill. */
  .card--drawn {
    border-width: 2px;
    background-color: transparent;
    background-image: repeating-linear-gradient(
      45deg,
      var(--color-line) 0 1px,
      transparent 1px 9px
    );
  }

  .card__index {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--accent-deep);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .card--compact .card__body {
    flex-direction: row;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .card__name {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.15;
    color: var(--accent-deep);
  }

  .card--compact .card__name {
    font-size: 1.0625rem;
  }

  .card__presence {
    font-size: 0.875rem;
    color: var(--color-slate);
  }

  .card__door {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    align-self: inherit;
    padding: 0.5rem 0.875rem;
    border-radius: 999px;
    border: 1px solid var(--color-line-strong);
    background-color: var(--color-canvas);
    font-size: 0.875rem;
    color: var(--accent-deep);
  }

  .card__arrow {
    font-size: 0.9375rem;
  }

  .card__hours {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.875rem;
    color: var(--color-ink);
    width: 100%;
    max-width: 17rem;
  }

  .card[data-align='end'] .card__hours {
    margin-left: auto;
  }

  .card__hoursRow {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 0.25rem;
  }

  .card__noSite {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-slate);
  }

  .card:hover {
    border-color: var(--accent-deep);
  }

  @media (max-width: 599px) {
    .card--compact {
      flex-direction: column;
      align-items: flex-start;
      padding: 1rem 1.25rem;
    }
    .card[data-align='end'] {
      text-align: left;
      align-items: flex-start;
    }
    .card[data-align='end'] .card__hours {
      margin-left: 0;
    }
  }
</style>
