---
import Band from './Band.astro';
import type { Unit } from '../lib/data';
import { SUPERMARKET_HOURS } from '../lib/data';

interface Props {
  unit: Unit;
  /** Alternating ground keeps four consecutive sections from reading as one
   *  undifferentiated block. */
  alt?: boolean;
}
const { unit, alt = false } = Astro.props;

const isMoldova = unit.token === 'u4';
const isSupermarket = !unit.href;
---

<section
  class:list={['unit', { 'unit--alt': alt }]}
  id={`unitatea-${unit.index}`}
  aria-labelledby={`unit-${unit.index}-title`}
>
  {/* Moldova's stretch of band carries no marks. The missing measure is the
      distinct legal status made spatial, rather than stated in a footnote. */}
  <Band marks={!isMoldova} tone="light" />

  <div class="unit__inner">
    <div class="unit__col" data-reveal>
      <p class="unit__index tnum">{unit.index}</p>
      <h2 class="unit__name" id={`unit-${unit.index}-title`}>{unit.name}</h2>
      <p class="unit__presence">{unit.presence}</p>

      {unit.slogan && <p class="unit__slogan">{unit.slogan}</p>}

      <p class="unit__summary">{unit.summary}</p>

      <ul class="unit__cats">
        {unit.categories.map((c) => <li>{c}</li>)}
      </ul>

      {
        unit.notes && (
          <ul class="unit__notes">
            {unit.notes.map((n) => (
              <li>{n}</li>
            ))}
          </ul>
        )
      }

      {
        isSupermarket && (
          <table class="unit__hours tnum">
            <caption class="unit__hoursCaption">Program</caption>
            <tbody>
              {SUPERMARKET_HOURS.map((h) => (
                <tr>
                  <th scope="row">{h.days}</th>
                  <td>
                    {h.open}–{h.close}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )
      }

      {
        unit.href ? (
          <a
            class:list={['unit__cta', { 'unit__cta--outlined': isMoldova }]}
            href={unit.href}
            rel="noopener"
            aria-label={`Deschide ${unit.domain}`}
          >
            {unit.domain}
            <span aria-hidden="true">↗</span>
          </a>
        ) : (
          <a class="unit__cta unit__cta--internal" href="#snagov-plaza">
            Vezi adresa și programul
            <span aria-hidden="true">↓</span>
          </a>
        )
      }
    </div>

    <div class="unit__gap" aria-hidden="true"></div>

    {/* The far side of the gap. The group owns no photography, so the "large
        visual" the brief asks for here is a turquoise field carrying the unit's
        number. Decorative: the real index and slogan are in the column above. */}
    <div class="unit__panel" aria-hidden="true" data-reveal style="--i: 1">
      <span class="unit__panelIndex tnum">{unit.index}</span>
      {unit.slogan && <span class="unit__panelSlogan">{unit.slogan}</span>}
    </div>
  </div>
</section>

<style>
  .unit {
    position: relative;
    padding-block: 6rem;
    background-color: var(--white);
  }

  .unit--alt {
    background-color: var(--paper);
  }

  .unit__inner {
    position: relative;
    z-index: 1;
    max-width: var(--content);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: 1fr var(--band) 1fr;
    align-items: start;
  }

  .unit__col {
    min-width: 0;
  }

  .unit__gap {
    /* Deliberately empty, and genuinely so: nothing may cross it. */
  }

  /* The panel. A real field of the brand colour, not a thin accent -- and it
   * carries near-black, never white. */
  .unit__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 22rem;
    padding: 1.75rem;
    border-radius: 24px;
    background-image: linear-gradient(155deg, var(--t-glow), var(--t) 52%, var(--t-floor));
    box-shadow: var(--lift-t);
    overflow: hidden;
  }

  .unit__panelIndex {
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 3rem + 6vw, 8.5rem);
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: var(--fg);
    opacity: 0.9;
  }

  .unit__panelSlogan {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 0.9rem + 0.7vw, 1.625rem);
    font-weight: 600;
    line-height: 1.2;
    max-width: 12ch;
    color: var(--fg);
  }

  .unit__index {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    color: var(--t-deep);
  }

  .unit__name {
    margin-top: 0.625rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .unit__presence {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-2);
  }

  .unit__slogan {
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--t-deep);
  }

  .unit__summary {
    margin-top: 1rem;
    max-width: 36rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--fg-2);
  }

  .unit__cats {
    margin-top: 1.75rem;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }

  .unit__cats li {
    padding-block: 0.625rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.9375rem;
  }

  .unit__notes {
    margin-top: 1.25rem;
    list-style: none;
    display: grid;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--fg-2);
  }

  .unit__hours {
    margin-top: 1.75rem;
    border-collapse: collapse;
    width: 100%;
    max-width: 24rem;
    font-size: 0.9375rem;
  }

  .unit__hoursCaption {
    text-align: left;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-2);
    padding-bottom: 0.5rem;
  }

  .unit__hours th,
  .unit__hours td {
    text-align: left;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--line);
    font-weight: 400;
  }

  .unit__hours td {
    text-align: right;
  }

  .unit__cta {
    margin-top: 2.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    border-radius: 999px;
    background-color: var(--ink);
    color: var(--t-glow);
    font-size: 0.9375rem;
    text-decoration: none;
    box-shadow: var(--lift-1);
  }

  /* The only outlined CTA on the page. A visual register that matches the
   * neutral wording -- this store is a partner, not a property. */
  .unit__cta--outlined {
    background-color: transparent;
    color: var(--t-deep);
    border: 2px solid var(--t-deep);
    box-shadow: none;
  }

  .unit__cta--internal {
    background-color: transparent;
    color: var(--fg);
    border: 1px solid var(--line-strong);
    box-shadow: none;
  }

  @media (max-width: 899px) {
    .unit {
      padding-block: 3.5rem;
    }
    .unit__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .unit__panel {
      min-height: 12rem;
      order: -1;
    }
  }
</style>
