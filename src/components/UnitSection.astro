---
import Band from './Band.astro';
import type { Unit } from '../lib/data';
import { SUPERMARKET_HOURS } from '../lib/data';

interface Props {
  unit: Unit;
}
const { unit } = Astro.props;

const isMoldova = unit.token === 'u4';
const isSupermarket = !unit.href;
---

<section
  class:list={['unit', { 'unit--moldova': isMoldova }]}
  id={`unitatea-${unit.index}`}
  aria-labelledby={`unit-${unit.index}-title`}
  style={`--accent: var(--color-${unit.token}); --accent-deep: var(--color-${unit.token}-deep);`}
>
  {/* Moldova's stretch of band carries no marks. The missing measure is the
      distinct legal status made spatial, rather than stated in a footnote. */}
  <Band marks={!isMoldova} />

  <div class="unit__inner">
    <div class="unit__col">
    <p class="unit__index tnum">{unit.index}</p>
    <h2 class="unit__name" id={`unit-${unit.index}-title`}>{unit.name}</h2>
    <p class="unit__presence">{unit.presence}</p>

    {unit.slogan && <p class="unit__slogan">{unit.slogan}</p>}

    <p class="unit__summary">{unit.summary}</p>

    <ul class="unit__cats">
      {unit.categories.map((c) => <li>{c}</li>)}
    </ul>

    {
      unit.notes && (
        <ul class="unit__notes">
          {unit.notes.map((n) => (
            <li>{n}</li>
          ))}
        </ul>
      )
    }

    {
      isSupermarket && (
        <table class="unit__hours tnum">
          <caption class="unit__hoursCaption">Program</caption>
          <tbody>
            {SUPERMARKET_HOURS.map((h) => (
              <tr>
                <th scope="row">{h.days}</th>
                <td>
                  {h.open}–{h.close}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }

    {/* One exit per unit. Moldova's is the only outlined CTA on the page --
        a visual register that matches its neutral wording. */}
    {
      unit.href ? (
        <a
          class:list={['unit__cta', { 'unit__cta--outlined': isMoldova }]}
          href={unit.href}
          rel="noopener"
          aria-label={`Deschide ${unit.domain}`}
        >
          {unit.domain}
          <span aria-hidden="true">↗</span>
        </a>
      ) : (
        <a class="unit__cta unit__cta--internal" href="#snagov-plaza">
          Vezi adresa și programul
          <span aria-hidden="true">↓</span>
        </a>
      )
    }
    </div>

    <div class="unit__gap" aria-hidden="true"></div>

    {/* The far side of the gap. Decorative only -- the real index and slogan are
        in the content column above, so this repeats nothing to assistive tech.
        It exists because the group owns no photography: the "large visual" the
        brief asks for here has to be typographic until the client supplies art. */}
    <div class="unit__echo" aria-hidden="true">
      <span class="unit__echoIndex tnum">{unit.index}</span>
      {unit.slogan && <span class="unit__echoSlogan">{unit.slogan}</span>}
    </div>
  </div>
</section>

<style>
  .unit {
    position: relative;
    padding-block: 4.5rem;
    background-color: color-mix(in oklab, var(--accent) 7%, var(--color-canvas));
    border-top: 1px solid var(--color-line);
  }

  .unit__inner {
    position: relative;
    z-index: 1;
    max-width: var(--content);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: 1fr var(--band) 1fr;
    align-items: start;
  }

  .unit__col {
    min-width: 0;
  }

  .unit__gap {
    /* Deliberately empty, and now genuinely so: nothing may cross it. */
  }

  .unit__echo {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 0.25rem;
  }

  .unit__echoIndex {
    font-family: var(--font-display);
    font-size: clamp(4rem, 3rem + 5vw, 9rem);
    font-weight: 700;
    line-height: 0.82;
    letter-spacing: -0.04em;
    color: color-mix(in oklab, var(--accent) 55%, var(--color-canvas));
  }

  .unit__echoSlogan {
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.85rem + 0.6vw, 1.375rem);
    font-weight: 500;
    line-height: 1.25;
    max-width: 14ch;
    color: var(--accent-deep);
  }

  @media (max-width: 899px) {
    .unit__inner {
      grid-template-columns: 1fr;
    }
    .unit__echo {
      display: none;
    }
  }

  .unit__index {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--accent-deep);
  }

  .unit__name {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--accent-deep);
  }

  .unit__presence {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-slate);
  }

  .unit__slogan {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
  }

  .unit__summary {
    margin-top: 1rem;
    max-width: 36rem;
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .unit__cats {
    margin-top: 1.5rem;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }

  .unit__cats li {
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--color-line);
    font-size: 0.9375rem;
  }

  .unit__notes {
    margin-top: 1.25rem;
    list-style: none;
    display: grid;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--color-slate);
  }

  .unit__hours {
    margin-top: 1.5rem;
    border-collapse: collapse;
    width: 100%;
    max-width: 24rem;
    font-size: 0.9375rem;
  }

  .unit__hoursCaption {
    text-align: left;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-slate);
    padding-bottom: 0.5rem;
  }

  .unit__hours th,
  .unit__hours td {
    text-align: left;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--color-line);
    font-weight: 400;
  }

  .unit__hours td {
    text-align: right;
  }

  .unit__cta {
    margin-top: 2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    background-color: var(--accent-deep);
    color: #fff;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .unit__cta--outlined {
    background-color: transparent;
    color: var(--accent-deep);
    border: 2px solid var(--accent-deep);
  }

  .unit__cta--internal {
    background-color: transparent;
    color: var(--color-ink);
    border: 1px solid var(--color-line-strong);
  }
</style>
