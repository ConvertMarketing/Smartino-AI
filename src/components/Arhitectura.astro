---
import { TIMELINE } from '../lib/data';

/**
 * The group, drawn as what it actually is: a circuit.
 *
 * The first version of this was an org chart -- a head and four branches -- and
 * it argued against its own headline. The title says the four are not
 * independent and that they feed each other; a tree says the opposite, four
 * things hanging off a company, and no amount of animation over the top of it
 * changes what the picture means.
 *
 * So the picture is the claim now. Import and distribution open the access;
 * retail and e-commerce are where the consumer is met, in parallel, not one
 * after the other; brand development is what comes back out of that contact and
 * returns into what we import. That last leg is a closed loop, and a light runs
 * it: one stage at a time, wire by wire, for ever.
 *
 * Nothing is claimed here that the client did not write. The only thing the
 * drawing adds is the direction of the arrows, and every arrow follows a
 * sentence that is on the page: "importul ne da acces", "ne pune direct in
 * contact", "se intoarce in brandurile pe care le reprezentam". The return leg
 * carries no label for that reason -- the sentence in the last card is the
 * label.
 *
 * Still CSS and not SVG. The wires are boxes placed against the same grid the
 * cards are in, so they touch the cards exactly at any width, which a viewBox
 * stretched over a fluid grid cannot do. The travelling light is two background
 * layers on each wire -- the wire itself, and a band sliding along it -- so
 * there is nothing to run per frame and it costs nothing when it is off screen.
 *
 * Three states. With no JavaScript and with no CSS animation it is the same
 * diagram, still readable: the arrowheads carry the direction on their own and
 * every card is at full strength. Under reduced motion the light does not run.
 *
 * The Moldovan shop appears under e-commerce because the client's brief puts it
 * there, and its own line says it is the partner's, because that is what it is.
 */
const STAGES = [
  {
    name: 'Import & distribuție',
    line: 'Importul ne dă acces la produse și branduri. Distribuția construiește piața.',
    children: [],
  },
  {
    name: 'Retail',
    line: 'Ne pune direct în contact cu consumatorul.',
    children: [
      { name: 'Smartino Supermarket', note: `deschis din ${TIMELINE.first.label}` },
      { name: 'Smartino Home', note: `deschis din ${TIMELINE.second.label}` },
    ],
  },
  {
    name: 'E-commerce',
    line: 'Extinde accesul la nivel național.',
    children: [
      { name: 'Smartino Shop', note: 'smartinoshop.ro' },
      { name: 'Smartino Home Online', note: 'smartinohome.ro' },
      { name: 'Smartino Eshop Moldova', note: 'al partenerului din Chișinău' },
    ],
  },
  {
    name: 'Dezvoltare de branduri',
    line: 'Ce învățăm din contactul direct cu consumatorul se întoarce în brandurile pe care le reprezentăm.',
    children: [],
  },
];
---

<section class="arh" aria-labelledby="arh-title">
  <div class="arh__inner">
    <p class="arh__kicker" data-reveal>Arhitectura Smartino</p>
    <h2 class="arh__title" id="arh-title" data-reveal style="--i: 1">
      Smartino nu face patru lucruri independente.
    </h2>
    <p class="arh__lead" data-reveal style="--i: 2">Componentele se alimentează reciproc.</p>

    <div class="arh__loop">
      <p class="arh__root" data-reveal style="--i: 2">SMARTINO INTERNATIONAL</p>

      <div class="arh__frame">
        {/* the company's own feed into the circuit: drawn, never lit -- it is
            not a stage, it is what the stages belong to */}
        <i class="seg seg--v f1" aria-hidden="true"></i>
        <i class="seg seg--h f2" aria-hidden="true"></i>
        <i class="seg seg--v f3" aria-hidden="true"></i>

        <ol class="arh__stages">
          {
            STAGES.map((s, i) => (
              <li class="pil" data-reveal style={`--i: ${i + 1}`}>
                <p class="pil__name">{s.name}</p>
                <p class="pil__line">{s.line}</p>
                {s.children.length > 0 && (
                  <ul class="pil__kids">
                    {s.children.map((c) => (
                      <li class="kid">
                        <span class="kid__name">{c.name}</span>
                        <span class="kid__note">{c.note}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ol>

        {/* the split: one stage in, two in parallel out */}
        <span class="lane lane--fork" aria-hidden="true">
          <i class="seg seg--h k1"></i>
          <i class="seg seg--v seg--up k2"></i>
          <i class="seg seg--v k3"></i>
          <i class="seg seg--h k4 a-r"></i>
          <i class="seg seg--h k5 a-r"></i>
        </span>

        {/* and the join */}
        <span class="lane lane--join" aria-hidden="true">
          <i class="seg seg--h j1"></i>
          <i class="seg seg--h j2"></i>
          <i class="seg seg--v j3"></i>
          <i class="seg seg--v seg--up j4"></i>
          <i class="seg seg--h j5 a-r"></i>
        </span>

        {/* the leg that closes it */}
        <i class="seg seg--v b1" aria-hidden="true"></i>
        <i class="seg seg--h b2" aria-hidden="true"></i>
        <i class="seg seg--v seg--up b3 a-u" aria-hidden="true"></i>
        <i class="seg seg--h b4 a-l" aria-hidden="true"></i>
      </div>
    </div>
  </div>
</section>

<style>
  .arh {
    position: relative;
    overflow: clip; /* clip, not hidden: hidden would make this a scroll
                       container and stop every scroll-driven animation in it */
    color: var(--fg-inv);
    /* This used to be pulled up into the tail of the warehouse model, on the
       idea that the model has dissolved by the time it gets there. It has not:
       measured at the join, the kicker and the heading sat over the model with
       the model still at full opacity, a hundred pixels of text on top of a
       picture. The section starts where the model's box ends now, and the
       measurement says the text is never over a model that is still drawn. */
    padding-block: clamp(3rem, 8vh, 5.5rem) clamp(2rem, 5vh, 3.5rem);
  }

  .arh__inner {
    position: relative;
    z-index: 1;
    max-width: var(--content);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .arh__kicker {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--t-glow);
  }

  .arh__title {
    margin-top: 0.875rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.25rem + 2vw, 2.875rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.06;
    max-width: 20ch;
  }

  .arh__lead {
    margin-top: 0.75rem;
    color: var(--fg-inv-2);
  }

  /* ---- the circuit ------------------------------------------------------- *
   *
   * Every measurement the wires need is a variable the grid also uses, so a
   * wire cannot end up a few pixels off a card at some width nobody tested:
   *   --lane  the empty column a fork or a join is drawn in
   *   --col   one card column, derived from it
   *   --spine where the leg down the left runs, and where the feed comes down
   *   --tap   how far below a card's top edge a wire meets its side
   * ---------------------------------------------------------------------- */
  .arh__loop {
    --lane: clamp(30px, 4.6vw, 72px);
    --gap: clamp(10px, 1.2vw, 18px);
    --col: calc((100% - 2 * var(--lane)) / 3);
    --spine: calc(var(--col) / 2);
    --tap: clamp(26px, 3.4vh, 36px);
    /* the middle of each of the pair, in the frame's own height: the rows are
       equal halves less the gap between them, so both are exact at any height
       and a wire always meets a card where a wire should meet a card */
    --rowA: calc(25% - var(--gap) / 4);
    --rowB: calc(75% + var(--gap) / 4);
    --feed: clamp(24px, 4vh, 38px);
    --ret: clamp(30px, 5vh, 54px);
    --wire: var(--line-dark-strong);
    /* one turn of the light around the whole circuit */
    --turn: 9s;
    margin-top: clamp(2.5rem, 6vh, 4rem);
  }

  .arh__root {
    max-width: max-content;
    margin-inline: auto;
    padding: 0.75rem 1.5rem;
    border: 1px solid rgba(75, 216, 232, 0.45);
    border-radius: 999px;
    background-color: rgba(19, 180, 198, 0.08);
    font-family: var(--font-display);
    font-size: clamp(0.75rem, 0.7rem + 0.2vw, 0.875rem);
    font-weight: 800;
    letter-spacing: 0.22em;
    text-align: center;
    color: var(--fg-inv);
  }

  .arh__frame {
    position: relative;
    /* room above for the feed, below for the leg that closes the loop */
    margin-top: calc(var(--feed) + 22px);
    margin-bottom: var(--ret);
  }

  .arh__stages {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr var(--lane) 1fr var(--lane) 1fr;
    row-gap: var(--gap);
  }

  /* first and last hold both rows: the pair in the middle is one stage split in
     two, not two stages */
  .pil:nth-child(1) {
    grid-area: 1 / 1 / 3 / 2;
  }
  .pil:nth-child(2) {
    grid-area: 1 / 3 / 2 / 4;
  }
  .pil:nth-child(3) {
    grid-area: 2 / 3 / 3 / 4;
  }
  .pil:nth-child(4) {
    grid-area: 1 / 5 / 3 / 6;
  }

  /* The two that hold both rows keep the full height of the pair beside them,
     because three wires meet them on their own edges -- the feed at the top,
     the circuit at half height, the return at the bottom -- and a card that
     stops short of its span leaves all three pointing at nothing. What they do
     instead is carry their words in the middle of that height. */
  .pil:nth-child(1),
  .pil:nth-child(4) {
    justify-content: center;
  }

  .pil {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: clamp(1rem, 1.8vw, 1.5rem);
    border: 1px solid var(--line-dark);
    border-radius: 16px;
    background-color: rgba(20, 25, 27, 0.6);
  }

  /* The light on the stage the pulse is at. One overlay, one property: the card
     underneath never changes, so nothing here can make its text harder to
     read. */
  .pil::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    border: 1px solid rgba(75, 216, 232, 0.8);
    background-image: radial-gradient(
      112% 66% at 50% 110%,
      rgba(19, 180, 198, 0.3),
      transparent 70%
    );
    box-shadow:
      0 0 64px rgba(19, 180, 198, 0.26) inset,
      0 0 58px rgba(19, 180, 198, 0.24);
  }

  .pil__name {
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 0.85rem + 0.4vw, 1.1875rem);
    font-weight: 800;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }

  .pil__line {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--fg-inv-2);
  }

  .pil__kids {
    margin: 0.25rem 0 0;
    padding: 0.75rem 0 0;
    border-top: 1px solid var(--line-dark);
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .kid {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .kid__name {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--fg-inv);
  }

  .kid__note {
    font-size: 0.75rem;
    color: var(--fg-inv-2);
  }

  /* ---- the wires --------------------------------------------------------- *
   *
   * Two background layers on one box: the wire, and a band of light three times
   * the box's own length sliding along it. Outside its turn the band sits past
   * the end, where it is transparent, so a wire that is not lit needs nothing
   * switched off -- and the whole thing is one animated property that the
   * compositor handles.
   * ---------------------------------------------------------------------- */
  .lane {
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--lane);
  }

  .lane--fork {
    left: var(--col);
  }

  .lane--join {
    right: var(--col);
  }

  .seg {
    position: absolute;
    background-repeat: no-repeat;
    /* Four times the wire, and the light confined to the middle fifth of that,
       so the quarter of the image a resting wire shows is entirely transparent
       and only the wire's own colour is left. Get this wrong -- and at three
       times with a wider band it is wrong -- and every wire sits permanently
       half lit, which is exactly what a circuit must not look like. */
    background-image:
      linear-gradient(var(--dir, 90deg), transparent 0 40%, var(--t-glow) 50%, transparent 60% 100%),
      linear-gradient(var(--wire), var(--wire));
  }

  .seg--h {
    height: 1px;
    background-size:
      400% 100%,
      100% 100%;
    background-position:
      100% 0,
      0 0;
  }

  .seg--v {
    width: 1px;
    --dir: 180deg;
    background-size:
      100% 400%,
      100% 100%;
    background-position:
      0 100%,
      0 0;
  }

  /* the direction, for anyone who is not watching the light: no motion needed,
     no JavaScript needed, and it is all reduced motion leaves behind */
  .a-r::before,
  .a-l::before,
  .a-u::before {
    content: '';
    position: absolute;
    width: 6px;
    height: 6px;
    border-top: 1px solid var(--wire);
    border-right: 1px solid var(--wire);
  }

  .a-r::before {
    right: 0;
    top: -3px;
    transform: rotate(45deg);
  }

  .a-l::before {
    left: 0;
    top: -3px;
    transform: rotate(-135deg);
  }

  .a-u::before {
    top: 0;
    left: -3px;
    transform: rotate(-45deg);
  }

  /* the feed from the company: root centre, across, down into the first stage */
  .f1 {
    left: 50%;
    bottom: calc(100% + var(--feed));
    height: 22px;
  }

  .f2 {
    left: var(--spine);
    right: 50%;
    bottom: calc(100% + var(--feed));
  }

  .f3 {
    left: var(--spine);
    bottom: 100%;
    height: var(--feed);
  }

  /* the fork: in at the middle, up and down, out to each of the pair */
  .k1 {
    top: 50%;
    left: 0;
    width: 50%;
  }
  .k2 {
    left: 50%;
    top: var(--rowA);
    height: calc(50% - var(--rowA));
  }
  .k3 {
    left: 50%;
    top: 50%;
    height: calc(var(--rowB) - 50%);
  }
  .k4 {
    top: var(--rowA);
    left: 50%;
    width: 50%;
  }
  .k5 {
    top: var(--rowB);
    left: 50%;
    width: 50%;
  }

  /* the join: the mirror of it */
  .j1 {
    top: var(--rowA);
    left: 0;
    width: 50%;
  }
  .j2 {
    top: var(--rowB);
    left: 0;
    width: 50%;
  }
  .j3 {
    left: 50%;
    top: var(--rowA);
    height: calc(50% - var(--rowA));
  }
  .j4 {
    left: 50%;
    top: 50%;
    height: calc(var(--rowB) - 50%);
  }
  .j5 {
    top: 50%;
    left: 50%;
    width: 50%;
  }

  /* and back */
  .b1 {
    left: calc(100% - var(--spine));
    top: 100%;
    height: var(--ret);
  }
  .b2 {
    left: var(--spine);
    right: var(--spine);
    top: calc(100% + var(--ret));
  }
  .b3 {
    left: var(--spine);
    top: 100%;
    height: var(--ret);
  }
  .b4 {
    display: none;
  }

  /* ---- the light, and only where motion is allowed ----------------------- */
  @media (prefers-reduced-motion: no-preference) {
    /* --o is the point in the turn at which a wire or a stage takes the light,
       as a fraction of it. A positive delay, not a negative one: negative winds
       the animation FORWARD, so every --o below would have had to be written as
       one minus itself and the order of the circuit would be unreadable in the
       source. The cost is that each one waits out its offset once, on the first
       turn, in a state that is dark anyway. */
    .seg {
      animation: var(--turn) linear infinite;
      animation-delay: calc(var(--o, 0) * var(--turn));
    }

    /* the company's feed is not a stage and never lights */
    .f1,
    .f2,
    .f3 {
      animation: none;
    }

    .seg--h {
      animation-name: run-r;
    }
    .seg--v {
      animation-name: run-d;
    }
    .seg--up {
      animation-name: run-u;
    }
    .a-l {
      animation-name: run-l;
    }

    /* a band crosses its own wire in a tenth of the turn, and the order of the
       delays is the order of the circuit */
    @keyframes run-r {
      0% {
        background-position:
          100% 0,
          0 0;
      }
      12%,
      100% {
        background-position:
          0% 0,
          0 0;
      }
    }

    @keyframes run-l {
      0% {
        background-position:
          0% 0,
          0 0;
      }
      12%,
      100% {
        background-position:
          100% 0,
          0 0;
      }
    }

    @keyframes run-d {
      0% {
        background-position:
          0 100%,
          0 0;
      }
      12%,
      100% {
        background-position:
          0 0%,
          0 0;
      }
    }

    @keyframes run-u {
      0% {
        background-position:
          0 0%,
          0 0;
      }
      12%,
      100% {
        background-position:
          0 100%,
          0 0;
      }
    }

    .pil::after {
      animation: stage var(--turn) linear infinite;
      animation-delay: calc(var(--o, 0) * var(--turn));
    }

    @keyframes stage {
      0% {
        opacity: 0;
      }
      5% {
        opacity: 1;
      }
      25% {
        opacity: 1;
      }
      33%,
      100% {
        opacity: 0;
      }
    }

    /* the turn, in order */
    .pil:nth-child(1) {
      --o: 0;
    }
    .pil:nth-child(2),
    .pil:nth-child(3) {
      --o: 0.25;
    }
    .pil:nth-child(4) {
      --o: 0.53;
    }

    .k1 {
      --o: 0.22;
    }
    .k2,
    .k3 {
      --o: 0.25;
    }
    .k4,
    .k5 {
      --o: 0.28;
    }

    .j1,
    .j2 {
      --o: 0.5;
    }
    .j3,
    .j4 {
      --o: 0.53;
    }
    .j5 {
      --o: 0.55;
    }

    .b1 {
      --o: 0.76;
    }
    .b2 {
      --o: 0.8;
    }
    .b3 {
      --o: 0.88;
    }

    /* Nothing here answers the pointer. The circuit is a drawing that runs, not
       a control: a card that lights under the cursor invites a click that has
       nowhere to go, and it stops the turn the one moment someone is actually
       looking at it. */
  }

  /* the ones that run against their box's own direction */
  .k2,
  .j4,
  .b3 {
    --dir: 0deg;
    background-position:
      0 0%,
      0 0;
  }

  /* ---- narrow: the same circuit, stood on its end ------------------------ *
   *
   * Not four cards in a column with a line beside them. The spine comes down
   * the left through all four, and the leg that closes the loop climbs the
   * right-hand side and comes back in at the top -- so on a phone it still
   * reads as a circuit, and it is the height of one card at a time.
   * ---------------------------------------------------------------------- */
  @media (max-width: 899px) {
    .arh__loop {
      --lane: 24px;
      --col: 100%;
      /* the line down through the stages runs inside the cards' own left edge,
         so it meets every card instead of passing beside it */
      --stub: 28px;
      --spine: calc(var(--lane) + var(--stub));
      --rspine: 11px;
      --gap: clamp(30px, 5vh, 46px);
      --ret: clamp(26px, 4vh, 40px);
    }

    .arh__stages {
      grid-template-columns: 1fr;
      padding-inline: var(--lane);
      row-gap: var(--gap);
    }

    .pil:nth-child(1),
    .pil:nth-child(2),
    .pil:nth-child(3),
    .pil:nth-child(4) {
      grid-area: auto;
    }

    /* the wire between two stages: each card draws the one that arrives at it,
       because only the card knows where its own top edge has ended up */
    .pil + .pil::before {
      content: '';
      position: absolute;
      left: var(--stub);
      top: calc(var(--gap) * -1);
      width: 1px;
      height: var(--gap);
      background-repeat: no-repeat;
      background-image:
        linear-gradient(180deg, transparent 0 40%, var(--t-glow) 50%, transparent 60% 100%),
        linear-gradient(var(--wire), var(--wire));
      background-size:
        100% 400%,
        100% 100%;
      background-position:
        0 100%,
        0 0;
    }

    /* no fork and no join down here: the pair is a sequence on a phone */
    .lane {
      display: none;
    }

    /* down out of the last stage, across, up the right, and back in at the top */
    .b1 {
      left: var(--spine);
      top: 100%;
      height: var(--ret);
    }

    .b2 {
      left: var(--spine);
      right: var(--rspine);
      top: calc(100% + var(--ret));
    }

    .b3 {
      left: auto;
      right: var(--rspine);
      top: var(--tap);
      height: calc(100% - var(--tap) + var(--ret));
    }

    .b4 {
      display: block;
      right: var(--rspine);
      top: var(--tap);
      width: calc(var(--lane) - var(--rspine));
    }

    .f2 {
      left: var(--spine);
      right: 50%;
    }

    @media (prefers-reduced-motion: no-preference) {
      .pil + .pil::before {
        animation: run-d var(--turn) linear infinite;
        animation-delay: calc(var(--od, 0) * var(--turn));
      }

      /* one stage per quarter turn here: the pair is a sequence on a phone, and
         the light says so */
      .pil:nth-child(1) {
        --o: 0;
      }
      .pil:nth-child(2) {
        --o: 0.2;
        --od: 0.18;
      }
      .pil:nth-child(3) {
        --o: 0.4;
        --od: 0.38;
      }
      .pil:nth-child(4) {
        --o: 0.58;
        --od: 0.56;
      }

      /* the whole return has to finish inside the turn: a leg that starts after
         0.88 runs off the end of it and is never seen */
      .b1 {
        --o: 0.76;
      }
      .b2 {
        --o: 0.79;
      }
      .b3 {
        --o: 0.82;
      }
      .b4 {
        --o: 0.87;
      }
    }
  }
</style>
