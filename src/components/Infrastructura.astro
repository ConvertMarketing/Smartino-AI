---
import { INFRA_ICONS, strokeD } from '../lib/infra-icons';

/**
 * What happens before the shelf, walked through one card at a time.
 *
 * The client's point: the retail did not appear out of nothing in 2025 -- the
 * import and distribution work came first, and it is what makes the shelves
 * possible. This section names that work, and it holds the screen while it
 * does: the six move past like goods on a line, and the one in the middle turns
 * to face you.
 *
 * The mark is a single object. It rides in the card it belongs to, and when the
 * belt hands over it lifts, flies to the next card and MORPHS on the way --
 * point by point, one drawing bending into the next, because all six are drawn
 * on the same skeleton in src/lib/infra-icons.ts. What each card keeps is a
 * ghost of its own mark, so you can see where the thing is going to land.
 *
 * Three states, not one. Without JavaScript the section never pins, the six are
 * a plain grid, and each card simply has its own mark at full strength. Under
 * reduced motion the same. The belt and the flying mark only exist once site.ts
 * has set data-live, so a failed chunk can never leave this half-built.
 *
 * Six words, and no invented sentences under them. The brief listed the six and
 * nothing more; anything I added under each would be a claim about how the
 * group actually operates, which is not mine to make.
 * TODO(client): a line each -- volumes, own fleet or partners, categories
 * handled -- would turn this from a list into an argument.
 */
const STEPS = [
  'Import direct',
  'Sourcing',
  'Depozitare',
  'Logistică',
  'Distribuție',
  'Operațiuni comerciale',
];
---


<section class="rail" data-rail aria-labelledby="rail-title">
  <div class="rail__stage">
    <div class="rail__inner">
      <p class="rail__kicker" data-reveal>Ce e în spate</p>
      <h2 class="rail__title" id="rail-title" data-reveal style="--i: 1">
        Retailul nu a apărut din nimic în 2025.
      </h2>
      <p class="rail__lead" data-reveal style="--i: 2">
        În spatele magazinelor stă experiența de import și distribuție adunată înainte de primul
        raft. Aceeași infrastructură ține astăzi și magazinele fizice, și comenzile online.
      </p>
    </div>

    <div class="rail__belt">
      <ol class="rail__list">
        {
          STEPS.map((name, i) => (
            <li class="card" data-rail-step data-reveal style={`--s: ${i}; --i: ${i + 1}`}>
              <span class="card__slot" data-rail-ghost>
                <svg class="card__icon" viewBox="0 0 24 24" aria-hidden="true">
                  {INFRA_ICONS[i].map((stroke) => <path d={strokeD(stroke)} />)}
                </svg>
              </span>
              <span class="card__name">{name}</span>
            </li>
          ))
        }
      </ol>
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" data-rail-ico>
        {INFRA_ICONS[0].map((stroke) => <path d={strokeD(stroke)} />)}
      </svg>
      <span class="rail__meter" aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  /* ---- the static section: what it is without JavaScript ----------------- */
  .rail {
    position: relative;
    overflow: clip; /* clip, not hidden: hidden makes this a scroll container,
                       and every scroll-driven animation inside would stop */
    color: var(--fg-inv);
    padding-block: clamp(3rem, 8vh, 5rem) clamp(3rem, 8vh, 5.5rem);
  }

  .rail__inner {
    position: relative;
    z-index: 1;
    max-width: var(--content);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .rail__kicker {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--t-glow);
  }

  .rail__title {
    margin-top: 0.875rem;
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 1.2rem + 1.7vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.08;
    max-width: 22ch;
  }

  .rail__lead {
    margin-top: 0.75rem;
    max-width: 52ch;
    color: var(--fg-inv-2);
  }

  .rail__belt {
    position: relative;
    z-index: 1;
    max-width: var(--content);
    margin-inline: auto;
    margin-top: clamp(2rem, 5vh, 3rem);
    padding-inline: var(--gutter);
  }

  .rail__meter {
    display: none;
  }

  .rail__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(10px, 1.2vw, 18px);
  }

  .card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    min-height: clamp(8rem, 18vh, 11rem);
    padding: clamp(1rem, 2vw, 1.5rem);
    border: 1px solid var(--line-dark);
    border-radius: 18px;
    background-color: rgba(20, 25, 27, 0.6);
  }

  /* Drawn here, not fetched: six line marks, no icon font and no third party.
     They are decoration -- a crate, a lens, a truck -- and say nothing the
     words under them do not. */
  /* The slot is a real HTML box on purpose: an <svg> has no offsetLeft, and
     the flying mark is aimed at layout positions, not at rects -- rects carry
     the card's own perspective transform and would land the mark off by a few
     percent on every card. */
  .card__slot {
    display: block;
    width: clamp(2.25rem, 5vw, 3rem);
    flex: none;
  }

  .card__icon {
    display: block;
    width: 100%;
    height: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.35;
    stroke-linecap: round;
    stroke-linejoin: round;
    color: rgba(255, 255, 255, 0.34);
  }

  .card__name {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.375rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }

  @media (max-width: 899px) {
    .rail__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---- the belt: only once the script has run --------------------------- *
   * data-live is written by site.ts, which does not write it under reduced
   * motion. So this whole block is unreachable without JavaScript and
   * unreachable for anyone who asked the machine to stop moving.
   *
   * The six move past the screen like goods on a line, which is what they
   * describe. One number drives all of it: --p, how far through the pin the
   * scroll has got. Each card works out its own distance from the middle from
   * that and its index, and leans, lifts and lights by it. */
  .rail[data-live] {
    --travel: 40vh;
    --card-w: clamp(230px, 24vw, 340px);
    --card-h: clamp(15.5rem, 35vh, 21rem);
    --card-gap: clamp(12px, 1.4vw, 24px);
    /* the belt advances one card per step, five steps for six cards */
    --span: calc(5 * (var(--card-w) + var(--card-gap)));
    height: calc(100dvh + 6 * var(--travel));
    padding-block: 0;
  }

  .rail[data-live] .rail__stage {
    position: sticky;
    top: 0;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1.5rem, 4vh, 3rem);
  }

  /* a flex item with auto side margins shrinks to its content and centres;
     the head has to keep the page's left edge, like every other head */
  .rail[data-live] .rail__inner {
    width: 100%;
  }

  .rail[data-live] .rail__belt {
    max-width: none;
    margin: 0;
    padding-inline: 0;
    padding-bottom: clamp(1.75rem, 4vh, 2.75rem);
  }

  .rail[data-live] .rail__list {
    display: flex;
    gap: var(--card-gap);
    /* the first and the last card can both reach the middle of the screen */
    padding-inline: calc(50% - var(--card-w) / 2);
    perspective: 1400px;
    transform: translate3d(calc(var(--p, 0) * var(--span) * -1), 0, 0);
    will-change: transform;
  }

  .rail[data-live] .card {
    /* distance from the middle, in cards: 0 is dead centre */
    --d: calc(var(--p, 0) * 5 - var(--s));
    /* the same, without a sign. abs() is too new to rely on. */
    --ad: max(var(--d), calc(var(--d) * -1));
    /* 1 in the middle, 0 by the time a card is a card and a bit away */
    --near: clamp(0, calc(1.25 - var(--ad) * 0.9), 1);
    flex: none;
    width: var(--card-w);
    height: var(--card-h);
    min-height: 0;
    justify-content: flex-end;
    padding: clamp(1.25rem, 2vw, 1.75rem);
    border-radius: 22px;
    border-color: rgba(38, 48, 51, calc(0.5 + 0.5 * var(--near)));
    background-color: rgba(20, 25, 27, calc(0.45 + 0.35 * var(--near)));
    opacity: calc(0.3 + 0.7 * var(--near));
    background-image: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.05) 0%,
      transparent 42%,
      rgba(19, 180, 198, calc(0.16 * var(--near))) 100%
    );
    transform: rotateY(calc(var(--d) * -9deg)) translateZ(calc(var(--near) * 34px))
      translateY(calc(var(--near) * -10px));
    transform-origin: 50% 60%;
  }

  /* the light only lands on the card that is in front of you */
  .rail[data-live] .card::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    pointer-events: none;
    opacity: var(--near);
    border: 1px solid rgba(75, 216, 232, 0.7);
    box-shadow:
      0 26px 70px rgba(0, 0, 0, 0.5),
      0 0 60px rgba(19, 180, 198, 0.22) inset;
  }

  /* On the belt, a card keeps only a ghost of its own mark: it says where the
     real one will land. */
  .rail[data-live] .card__slot {
    /* the same size as the mark that lands in it */
    width: clamp(4rem, 10.5vh, 6.75rem);
  }

  .rail[data-live] .card__icon {
    opacity: 0.14;
  }

  /* The mark itself: one object, over the belt rather than in it, so no card's
     own perspective can order it behind another. site.ts moves it and bends it;
     everything here is only how it looks. */
  .ico {
    display: none;
  }

  .rail[data-live] .ico {
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    width: clamp(4rem, 10.5vh, 6.75rem);
    height: auto;
    pointer-events: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    color: var(--fg-inv);
    filter: drop-shadow(0 0 22px rgba(19, 180, 198, 0.6));
  }

  .rail[data-live] .card__name {
    font-size: clamp(1.25rem, 1rem + 0.9vw, 1.875rem);
    text-shadow: 0 0 30px rgba(19, 180, 198, calc(0.5 * var(--near)));
  }

  /* how far along the line you are */
  .rail[data-live] .rail__meter {
    display: block;
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 0;
    height: 1px;
    background-color: var(--line-dark);
  }

  .rail[data-live] .rail__meter::after {
    content: '';
    position: absolute;
    inset: 0;
    transform: scaleX(var(--p, 0));
    transform-origin: left;
    background-image: linear-gradient(90deg, var(--t-glow), var(--t));
    box-shadow: 0 0 12px rgba(75, 216, 232, 0.55);
  }

  @media (max-width: 899px) {
    .rail[data-live] {
      --travel: 34vh;
      --card-w: clamp(210px, 62vw, 280px);
      --card-h: clamp(15rem, 34vh, 20rem);
    }

    .rail[data-live] .rail__stage {
      gap: clamp(1.25rem, 3vh, 2rem);
    }
  }
</style>
