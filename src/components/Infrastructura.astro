---
/**
 * What the warehouse model is a picture of.
 *
 * The client's brief: the retail did not appear out of nothing in 2025 -- the
 * import and distribution work came first, and it is what makes the shelves
 * possible. This section names that work.
 *
 * Six words, and no invented sentences under them. The brief listed the six
 * capabilities and nothing more; anything I added under each would be a claim
 * about how the group actually operates, which is not mine to make.
 * TODO(client): a line each -- volumes, own fleet or partners, categories
 * handled -- would turn this from a list into an argument.
 */
const CAPABILITIES = [
  'Import direct',
  'Sourcing',
  'Depozitare',
  'Logistică',
  'Distribuție',
  'Operațiuni comerciale',
];
---

<section class="infra" aria-labelledby="infra-title">
  <div class="infra__inner">
    <p class="infra__kicker" data-reveal>Ce e în spate</p>
    <h2 class="infra__title" id="infra-title" data-reveal style="--i: 1">
      Retailul nu a apărut din nimic în 2025.
    </h2>
    <p class="infra__lead" data-reveal style="--i: 2">
      În spatele magazinelor stă experiența de import și distribuție adunată înainte de primul
      raft. Aceeași infrastructură ține astăzi și magazinele fizice, și comenzile online.
    </p>

    <ol class="infra__grid" aria-label="Ce acoperă infrastructura grupului">
      {
        CAPABILITIES.map((name, i) => (
          <li class="cap" data-reveal style={`--i: ${i + 1}`}>
            <span class="cap__n tnum" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="cap__name">{name}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .infra {
    position: relative;
    overflow: clip; /* clip, not hidden: hidden makes this a scroll container,
                       and every scroll-driven animation inside would stop */
    color: var(--fg-inv);
    /* rises into the tail of the warehouse model while that one dissolves */
    margin-top: clamp(-14rem, -28vh, -7rem);
    padding-block: clamp(2rem, 6vh, 4rem) clamp(3rem, 8vh, 5.5rem);
  }

  /* the model above gives way only because it dissolves, and it dissolves only
     where motion is allowed */
  @media (prefers-reduced-motion: reduce) {
    .infra {
      margin-top: 0;
    }
  }

  .infra__inner {
    position: relative;
    z-index: 1;
    max-width: var(--content);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .infra__kicker {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--t-glow);
  }

  .infra__title {
    margin-top: 0.875rem;
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 1.2rem + 1.7vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }

  .infra__lead {
    margin-top: 0.75rem;
    max-width: 52ch;
    color: var(--fg-inv-2);
  }

  .infra__grid {
    margin: clamp(2rem, 5vh, 3rem) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(10px, 1.2vw, 18px);
  }

  .cap {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1rem, 2vw, 1.5rem);
    border: 1px solid var(--line-dark);
    border-radius: 16px;
    background-color: rgba(20, 25, 27, 0.6);
    transition:
      border-color var(--d-state) var(--ease-out),
      transform var(--d-state) var(--ease-out);
  }

  .cap:hover {
    border-color: rgba(75, 216, 232, 0.45);
    transform: translateY(-2px);
  }

  .cap__n {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--t-glow);
  }

  .cap__name {
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.375rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }

  @media (max-width: 899px) {
    .infra__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
