---
import { COMPANY } from '../lib/data';
---

<div class="fascia">
  <div class="fascia__inner">
    <span class="fascia__mark">SMARTINO</span>
    <span class="fascia__where">{COMPANY.address.oneLine}</span>
  </div>
</div>

<style>
  /* Transparent: it sits on the hero's own gradient rather than carrying one of
   * its own, so the top of the page reads as a single dark surface. */
  .fascia {
    position: relative;
    z-index: 2;
  }

  /* A live brand line instead of a dead border: the gradient pans slowly,
   * so the very first pixel row of the site is already in motion. */
  .fascia::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 2px;
    background-image: linear-gradient(
      90deg,
      transparent,
      var(--t) 30%,
      var(--t-glow) 50%,
      var(--t) 70%,
      transparent
    );
    background-size: 200% 100%;
    animation: fascia-pan 7s linear infinite;
    opacity: 0.85;
  }

  @media (prefers-reduced-motion: reduce) {
    .fascia::after {
      animation: none;
      background-position: 50% 0;
    }
  }

  .fascia__inner {
    max-width: var(--content);
    margin-inline: auto;
    padding-inline: var(--gutter);
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--fg-inv);
  }

  .fascia__mark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.125rem;
    letter-spacing: 0.16em;
  }

  .fascia__where {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: right;
    color: var(--fg-inv-2);
  }

  @media (max-width: 599px) {
    .fascia__inner {
      min-height: 56px;
    }
    .fascia__where {
      font-size: 0.5625rem;
      max-width: 10rem;
    }
  }
</style>
