---
import { COMPANY } from '../lib/data';

/**
 * The editorial statement: the group in three sentences of real facts, set
 * huge on warm paper. The one place the page slows down and simply speaks.
 */
---

<section class="stmt" aria-label="Despre grup">
  <div class="stmt__inner">
    <p class="stmt__kicker" data-reveal>Grupul</p>
    <p class="stmt__text" data-animate="words" aria-label="Un grup, zeci de branduri, un raft în care găsești ce cauți. Cumpărături smart, în fiecare zi.">
      <span aria-hidden="true">
        {'Un grup, zeci de branduri, un raft în care găsești ce cauți. Cumpărături smart, în fiecare zi.'
          .split(' ')
          .map((w, i) => (
            <span class="w"><span class="w__in" style={`--wi: ${i * 0.28}`}>{w}</span></span>
          ))}
      </span>
    </p>
    <ul class="stmt__values" data-reveal style="--i: 2" aria-label="Valorile grupului">
      {COMPANY.values.map((v, i) => (
        <li class="stmt__value" style={`--vi: ${i}`}>{v}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* the block arrives a touch smaller and settles to size while it enters */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .stmt__inner {
        animation: stmt-settle linear both;
      }

      .stmt__inner.stmt__inner {
        animation-timeline: view();
        animation-range: entry 0% entry 90%;
      }
    }
  }

  @keyframes stmt-settle {
    from {
      transform: translateY(6vh) scale(0.96);
    }
  }

  .stmt {
    background-color: var(--paper);
    color: var(--fg);
    padding-block: clamp(5rem, 12vh, 8.5rem);
  }

  .stmt__inner {
    max-width: var(--content);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .stmt__kicker {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--t-deep);
  }

  .stmt__text {
    margin-top: 1.75rem;
    max-width: 62rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1rem + 2.6vw, 3rem);
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: -0.015em;
  }

  /* The four values were set at 11px grey and read as the fine print at the
     bottom of a contract. They are what the group says it stands for, so they
     get a rule of their own, ink instead of grey, and a turquoise mark each. */
  .stmt__values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem clamp(1.75rem, 3.4vw, 3.25rem);
    margin-top: clamp(2.5rem, 5vh, 3.5rem);
    padding-top: clamp(1.25rem, 3vh, 1.75rem);
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .stmt__value {
    position: relative;
    padding-left: 1.3rem;
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 0.85rem + 0.35vw, 1.125rem);
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--fg);
  }

  /* a small turquoise lozenge, the same mark the page uses for a bullet */
  .stmt__value::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.52em;
    width: 7px;
    height: 7px;
    background-color: var(--t-deep);
    transform: rotate(45deg);
  }

  /* they arrive one after another once the block is in view */
  @media (prefers-reduced-motion: no-preference) {
    :global([data-js]) .stmt__values .stmt__value {
      opacity: 0;
      transform: translate3d(0, 10px, 0);
      transition:
        opacity 520ms var(--ease-out) calc(var(--vi) * 90ms + 260ms),
        transform 520ms var(--ease-out) calc(var(--vi) * 90ms + 260ms);
    }

    :global([data-js]) .stmt__values[data-in] .stmt__value {
      opacity: 1;
      transform: none;
    }
  }
</style>
