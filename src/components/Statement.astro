---
import { COMPANY } from '../lib/data';

/**
 * The editorial statement: the group in three sentences of real facts, set
 * huge on warm paper. The one place the page slows down and simply speaks.
 */
---

<section class="stmt" aria-label="Despre grup">
  {/* The white does not arrive as an edge: it floods up over the last of the
      3D model while that section is still pinned, so the page opens into the
      light instead of cutting to it. Driven by the scroll, decorative. */}
  <span class="stmt__dawn" aria-hidden="true"></span>
  <span class="stmt__glow" aria-hidden="true"></span>

  <div class="stmt__inner">
    <p class="stmt__kicker" data-reveal>Grupul</p>
    <p class="stmt__text" data-animate="words" aria-label="Un grup, zeci de branduri, un raft în care găsești ce cauți. Cumpărături smart, în fiecare zi.">
      <span aria-hidden="true">
        {'Un grup, zeci de branduri, un raft în care găsești ce cauți. Cumpărături smart, în fiecare zi.'
          .split(' ')
          .map((w, i) => (
            <span class="w"><span class="w__in" style={`--wi: ${i * 0.28}`}>{w}</span></span>
          ))}
      </span>
    </p>
    <ul class="stmt__values" data-reveal style="--i: 2" aria-label="Valorile grupului">
      {COMPANY.values.map((v, i) => (
        <li class="stmt__value" style={`--vi: ${i}`}>{v}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* the block arrives a touch smaller and settles to size while it enters */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .stmt__inner {
        animation: stmt-settle linear both;
      }

      .stmt__inner.stmt__inner {
        animation-timeline: view();
        animation-range: entry 0% entry 90%;
      }
    }
  }

  @keyframes stmt-settle {
    from {
      transform: translateY(6vh) scale(0.96);
    }
  }

  .stmt {
    position: relative;
    z-index: 1;
    /* pulled up over the maquette's tail: the two share a stretch of scroll */
    margin-top: clamp(-16rem, -30vh, -7rem);
    /* clipped sideways, open upwards: the drifting glow inside must not push
       the page wider (measured: it did, by 84-316 px), while the dawn sheet
       above this box has to stay visible */
    overflow: clip visible; /* clip, not hidden: hidden makes this a scroll container,
                       and every scroll-driven animation inside would then
                       measure against a box that never scrolls */
    background-color: var(--paper);
    color: var(--fg);
    padding-block: clamp(5rem, 12vh, 8.5rem);
  }

  /* The dawn.
     The white does not arrive as an edge. This sheet sits above the section
     (its bottom edge on the section's top edge) and is a long, soft front:
     transparent at the top, solid white at the bottom. While the 3D section
     below is still pinned to the screen, the front rises across it with the
     scroll and the model dissolves into the light.
     It needs no animation of its own -- the scroll already moves it, and an
     earlier attempt to grow it with a scroll-driven scale finished its whole
     travel while still below the fold, which nobody could see. */
  .stmt__dawn {
    position: absolute;
    inset: auto 0 100% 0;
    z-index: 0;
    height: clamp(24rem, 68vh, 40rem);
    pointer-events: none;
    background-image: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.08) 34%,
      rgba(255, 255, 255, 0.3) 58%,
      rgba(255, 255, 255, 0.72) 80%,
      rgba(255, 255, 255, 0.95) 93%,
      #fff 100%
    );
  }

  /* the same faint drifting light the index carries, so the two white
     sections read as one lit room rather than two sheets of paper */
  .stmt__glow {
    position: absolute;
    inset: -25% -10%;
    z-index: 0;
    pointer-events: none;
    background-image:
      radial-gradient(32% 30% at 76% 22%, rgba(19, 180, 198, 0.1), transparent 70%),
      radial-gradient(28% 26% at 10% 78%, rgba(19, 180, 198, 0.07), transparent 72%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .stmt__glow {
      animation: drift-b 30s var(--ease-in-out) infinite alternate;
    }
  }

  .stmt__inner {
    position: relative;
    z-index: 1;
    max-width: var(--content);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .stmt__kicker {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--t-deep);
  }

  .stmt__text {
    margin-top: 1.75rem;
    max-width: 62rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1rem + 2.6vw, 3rem);
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: -0.015em;
  }

  /* The four values were set at 11px grey and read as the fine print at the
     bottom of a contract. They are what the group says it stands for, so they
     get a rule of their own, ink instead of grey, and a turquoise mark each. */
  .stmt__values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem clamp(1.75rem, 3.4vw, 3.25rem);
    margin-top: clamp(2.5rem, 5vh, 3.5rem);
    padding-top: clamp(1.25rem, 3vh, 1.75rem);
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .stmt__value {
    position: relative;
    padding-left: 1.3rem;
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 0.85rem + 0.35vw, 1.125rem);
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--fg);
  }

  /* a small turquoise lozenge, the same mark the page uses for a bullet */
  .stmt__value::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.52em;
    width: 7px;
    height: 7px;
    background-color: var(--t-deep);
    transform: rotate(45deg);
  }

  /* light runs along the four marks, one after another, and starts over */
  @media (prefers-reduced-motion: no-preference) {
    .stmt__value::before {
      animation: value-spark 5.2s var(--ease-in-out) infinite;
      animation-delay: calc(var(--vi) * 0.42s);
    }
  }

  @keyframes value-spark {
    0%,
    18%,
    100% {
      background-color: var(--t-deep);
      box-shadow: 0 0 0 0 rgba(19, 180, 198, 0);
    }
    6% {
      background-color: var(--t);
      box-shadow: 0 0 10px 2px rgba(19, 180, 198, 0.45);
    }
  }

  /* they arrive one after another once the block is in view */
  @media (prefers-reduced-motion: no-preference) {
    :global([data-js]) .stmt__values .stmt__value {
      opacity: 0;
      transform: translate3d(0, 10px, 0);
      transition:
        opacity 520ms var(--ease-out) calc(var(--vi) * 90ms + 260ms),
        transform 520ms var(--ease-out) calc(var(--vi) * 90ms + 260ms);
    }

    :global([data-js]) .stmt__values[data-in] .stmt__value {
      opacity: 1;
      transform: none;
    }
  }
</style>
