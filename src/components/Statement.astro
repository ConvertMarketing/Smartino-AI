---
import { COMPANY } from '../lib/data';

/**
 * The editorial statement: the group in three sentences of real facts, set
 * huge on warm paper. The one place the page slows down and simply speaks.
 */
---

<section class="stmt" aria-label="Despre grup">
  <div class="stmt__inner">
    <p class="stmt__kicker" data-reveal>Grupul</p>
    <p class="stmt__text" data-animate="words" aria-label="Smartino International reunește patru direcții de retail: un supermarket și o casă de mobilier față în față în Snagov Plaza, plus două cataloage online, pentru România și Republica Moldova.">
      <span aria-hidden="true">
        {'Smartino International reunește patru direcții de retail: un supermarket și o casă de mobilier față în față în Snagov Plaza, plus două cataloage online, pentru România și Republica Moldova.'
          .split(' ')
          .map((w, i) => (
            <span class="w"><span class="w__in" style={`--wi: ${i * 0.28}`}>{w}</span></span>
          ))}
      </span>
    </p>
    <p class="stmt__values" data-reveal style="--i: 2">
      {COMPANY.values.join(' · ')}
    </p>
  </div>
</section>

<style>
  /* the block arrives a touch smaller and settles to size while it enters */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .stmt__inner {
        animation: stmt-settle linear both;
      }

      .stmt__inner.stmt__inner {
        animation-timeline: view();
        animation-range: entry 0% entry 90%;
      }
    }
  }

  @keyframes stmt-settle {
    from {
      transform: translateY(6vh) scale(0.96);
    }
  }

  .stmt {
    background-color: var(--paper);
    color: var(--fg);
    padding-block: clamp(5rem, 12vh, 8.5rem);
  }

  .stmt__inner {
    max-width: var(--content);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .stmt__kicker {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--t-deep);
  }

  .stmt__text {
    margin-top: 1.75rem;
    max-width: 62rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1rem + 2.6vw, 3rem);
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: -0.015em;
  }

  .stmt__values {
    margin-top: 2rem;
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-2);
  }
</style>
