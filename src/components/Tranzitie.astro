---
/**
 * The handover between the two models.
 *
 * The brief asked for a clear break between the two 3D scenes -- the shops and
 * the warehouse -- so they read as two halves of one system rather than two
 * separate tricks. This is that break, and nothing else: two sentences and an
 * arrow, sitting in the stretch of scroll where the first model dissolves and
 * the second is about to rise.
 *
 * Not a <section>: it carries no heading and adds no landmark. It is a hinge.
 */
---

<div class="hand">
  <p class="hand__from" data-reveal>
    <span class="hand__n tnum" aria-hidden="true">02</span> Aici întâlnim clientul.
  </p>
  <span class="hand__arrow" data-reveal style="--i: 1" aria-hidden="true"></span>
  <p class="hand__to" data-reveal style="--i: 2">
    <span class="hand__n tnum" aria-hidden="true">03</span> Aici începe sistemul care face posibil
    retailul.
  </p>
</div>

<style>
  .hand {
    position: relative;
    z-index: 1;
    /* rises into the tail of the model above while that one dissolves */
    margin-top: clamp(-15rem, -30vh, -7rem);
    max-width: var(--content);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block: clamp(2rem, 6vh, 4rem) clamp(1rem, 3vh, 2rem);
    text-align: center;
    color: var(--fg-inv);
  }

  .hand__n {
    font-weight: 700;
    color: var(--t-glow);
    margin-right: 0.5rem;
  }

  .hand__from,
  .hand__to {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  /* the one we are leaving is already half gone */
  .hand__from {
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.25rem);
    color: var(--fg-inv-2);
  }

  .hand__to {
    font-size: clamp(1.375rem, 1.05rem + 1.4vw, 2.125rem);
    font-weight: 800;
    color: var(--fg-inv);
  }

  /* the arrow is drawn, not typed: a line that falls and a head at its end */
  .hand__arrow {
    display: block;
    width: 1px;
    height: clamp(2.5rem, 7vh, 4.5rem);
    margin: clamp(1rem, 3vh, 1.75rem) auto;
    background-image: linear-gradient(180deg, transparent, var(--t-glow));
  }

  .hand__arrow::after {
    content: '';
    display: block;
    position: relative;
    top: 100%;
    left: 50%;
    width: 9px;
    height: 9px;
    margin: -5px 0 0 -5px;
    border-right: 1px solid var(--t-glow);
    border-bottom: 1px solid var(--t-glow);
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hand__arrow {
      animation: hand-fall 2.8s var(--ease-in-out) infinite;
    }
  }

  @keyframes hand-fall {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.75;
    }
    50% {
      transform: translateY(6px);
      opacity: 1;
    }
  }
  /* The model above only gives way because it dissolves, and it only dissolves
     where motion is allowed. Without it nothing may rise into it, or the model
     and its hint sit on top of these words. */
  @media (prefers-reduced-motion: reduce) {
    .hand {
      margin-top: 0;
    }
  }
</style>
