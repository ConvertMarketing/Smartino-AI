---
/**
 * The empty band. It never receives content -- that is the rule the whole page
 * rests on, and it is checked automatically.
 *
 * Below 900px the gap rotates into the horizontal space between stacked units,
 * so this vertical segment stops rendering there.
 */
interface Props {
  marks?: boolean;
  /** On the dark ground the marks glow; on light they are a quiet grey. */
  tone?: 'light' | 'dark';
  class?: string;
}
const { marks = true, tone = 'light', class: className } = Astro.props;
---

<div
  class:list={['band', className]}
  data-marks={String(marks)}
  data-tone={tone}
  aria-hidden="true"
></div>

<style>
  .band {
    position: absolute;
    inset-block: 0;
    left: 50%;
    width: var(--band);
    margin-left: calc(var(--band) / -2);
    pointer-events: none;
  }

  .band[data-marks='true']::before {
    content: '';
    position: absolute;
    inset-block: 0;
    left: 50%;
    width: 22px;
    margin-left: -11px;
    background-image: repeating-linear-gradient(
      to bottom,
      var(--mark) 0 1px,
      transparent 1px 32px
    );
  }

  .band[data-tone='light'] {
    --mark: var(--line-strong);
  }

  .band[data-tone='dark'] {
    --mark: var(--t);
  }

  @media (max-width: 899px) {
    .band {
      display: none;
    }
  }
</style>
