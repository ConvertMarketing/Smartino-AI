---
import { Image } from 'astro:assets';
import poster from '../assets/photos/harta-smartino.png';
import { ORIGIN, ONLINE_MARKETS } from '../lib/data';

/**
 * The map: both countries as one lit plate.
 *
 * It follows the warehouse on purpose. That section is where the goods are;
 * this one is where they go -- Romania and the Republic of Moldova, drawn
 * county by county and raion by raion, with light leaving the two points the
 * brand works from.
 *
 * The scene was built by the client in Claude Code as a standalone page and is
 * ported in src/scripts/romap.ts. Everything before it -- and instead of it,
 * under reduced motion or without WebGL -- is the poster below, rendered from
 * that same scene by scripts/ro-poster.mjs.
 *
 * The map is an illustration: the outlines are simplified and no border,
 * distance or coverage on it should be read as a statement of fact. The note
 * under it says so, and repeats who operates smartino.md -- the Moldovan shop
 * is the brand's, not this company's.
 */
---

<section class="romap" id="harta" aria-labelledby="romap-title" data-romap>
  <span class="romap__dither" aria-hidden="true"></span>

  <div class="romap__hold" data-pin>
    <div class="romap__pin">
      <div class="romap__inner">
        <p class="romap__kicker" data-reveal>România și Republica Moldova</p>
        <h2 class="romap__title" id="romap-title" data-reveal>Două țări, pe aceeași hartă.</h2>
        <p class="romap__lead" data-reveal>
          Numele Smartino a pornit în România în {ORIGIN.romania}. La moment activează fizic în
          România și Republica Moldova, cu distribuție la nivel național și operațiuni online care
          acoperă {ONLINE_MARKETS.slice(0, -1).join(', ')} și {ONLINE_MARKETS.at(-1)}.
        </p>
      </div>

      <span class="romap__light" aria-hidden="true"></span>

      <div class="romap__stage" data-romap-stage>
        <span class="romap__bed" aria-hidden="true"></span>
        <div class="romap__canvas" data-romap-canvas aria-hidden="true"></div>
        <Image
          class="romap__poster"
          src={poster}
          alt="Harta României și a Republicii Moldova, pe județe și raioane, ca plăci ridicate dintr-o masă întunecată, cu trasee de lumină turcoaz care pleacă din București și din Chișinău."
          widths={[800, 1200, 1600]}
          sizes="100vw"
          loading="lazy"
        />
        <div class="romap__labels" data-romap-labels aria-hidden="true"></div>
      </div>

      <span class="romap__dawn" aria-hidden="true"></span>
      <span class="romap__grain" aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  .romap {
    position: relative;
    /* Clipped sideways, open top and bottom: nothing may widen the page, but
       the light below belongs to the room and has to reach into the sections
       either side of this one instead of stopping at its edges.
       clip, not hidden: hidden would make this a scroll container and every
       scroll-driven animation inside the dark room would stop measuring. */
    overflow: clip visible;
    /* its own ground now that it is out of the dark room's wrapper: the same
       ink, so nothing shows at the join */
    background-color: var(--ink);
    color: var(--fg-inv);
    padding-block: clamp(3rem, 7vh, 5rem) 0;

    /* how much scroll the section holds the screen for while the light comes up
       over the plate */
    --wash: 30vh;
    /* What the words above the plate take out of the held screen, plus the gap
       under them: the plate gets the rest. The floor is in rem and not in vh on
       purpose -- the words wrap by WIDTH, so their height barely moves with the
       height of the screen, and a vh floor ran 39px short on a 700px-tall one
       and pushed the kicker off the top. The floor is the tallest the words
       measured plus the gap and a little air; the vh term gives the scene room
       to breathe on a tall screen instead of filling it.
       The sentence has since grown a country list, so those words now measure
       228px where they measured 204px, and the air above the kicker is down
       from ~45px to ~20px on a short landscape screen (measured at 1024x600
       through 1920x800: nothing clips, nothing overflows). Lengthen the
       sentence again and this floor is the number to raise. */
    --reserve: clamp(15.5rem, 31vh, 20rem);
    /* and how tall the same front is when it cannot hold the screen: without
       JavaScript, or where someone asked the machine to stop moving */
    --dawn-h: clamp(15rem, 38vh, 25rem);
  }

  /* ---- the hold ---------------------------------------------------------- *
   *
   * The plate stops and the page keeps scrolling, and what that scroll buys is
   * the light coming up over it. data-pinned is written by site.ts, so there is
   * no pin without JavaScript and none under reduced motion -- in both cases
   * this is a plain block, the plate scrolls past like anything else, and the
   * white arrives in the runway underneath it instead.
   * ---------------------------------------------------------------------- */
  .romap__hold {
    position: relative;
    padding-bottom: var(--dawn-h);
  }

  .romap__hold[data-pinned] {
    height: calc(100dvh + var(--wash));
    padding-bottom: 0;
  }

  .romap__pin {
    position: relative;
    /* The same ink as the section, and it is not decoration: a sticky element
       is a stacking context, so the dither over it has nothing of the section's
       ground to blend with -- overlay with no backdrop falls back to its own
       colour, which is flat grey, and the whole room came up ten luminance
       levels and went flat. It blends with this instead. */
    background-color: var(--ink);
  }

  .romap__hold[data-pinned] .romap__pin {
    position: sticky;
    top: 0;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(0.75rem, 2.5vh, 1.75rem);
  }

  .romap__inner {
    position: relative;
    z-index: 1;
    max-width: var(--content);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .romap__kicker {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--t-glow);
  }

  .romap__title {
    margin-top: 0.875rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .romap__lead {
    margin-top: 0.625rem;
    max-width: 46ch;
    color: var(--fg-inv-2);
  }

  /* ---- the stage --------------------------------------------------------- */
  /* ---- the background, and nothing else in it ---------------------------
   *
   * Rebuilt from nothing after three attempts that each left a line. What was
   * wrong was never an edge -- every edge check came back clean -- it was
   * banding: a soft, dark, screen-sized gradient runs out of 8-bit room and
   * quantises into rings, and a ring on a dark ground reads as a line. Row and
   * column scans could not find them precisely because the rings are curved.
   *
   * So: one flat ground, one gradient, one dither. Nothing else. Fewer
   * overlapping gradients also means fewer families of rings crossing each
   * other, which is what made the old version look like weather.
   * ------------------------------------------------------------------- */

  /* One light, centred on the plate, running the full width of the page and
     dying well inside its own box on every side, so it has no edge anywhere.
     The box is the held screen now, not the whole section, and a held screen is
     a third shorter -- so the insets carry the difference and the radius is
     restated against the bigger box. Measured against what it was before the
     hold existed: same reach, same fall, and still nothing at any edge. */
  .romap__light {
    position: absolute;
    inset: -46% 0 -60% 0;
    pointer-events: none;
    background-image: radial-gradient(
      58% 48% at 50% 48%,
      rgba(19, 180, 198, 0.194),
      rgba(19, 180, 198, 0.062) 44%,
      transparent 78%
    );
  }

  /* The bed the plate lies in. This used to be a plane inside the 3D scene, and
     that was the other half of the problem: a glow drawn on the drawing surface
     runs off the edges of the drawing surface, so the map sat in a rectangle of
     light with four cut sides. Out here it is aimed at the plate the same way --
     the stage is its box, so it follows the map at every size -- but it is drawn
     on the page, overflows its box on all four sides and is transparent long
     before it reaches any of them. It has no edges left to show. */
  .romap__bed {
    position: absolute;
    inset: -45% -10%;
    pointer-events: none;
    background-image: radial-gradient(
      48% 46% at 50% 52%,
      rgba(78, 150, 160, 0.122),
      rgba(78, 150, 160, 0.048) 42%,
      transparent 76%
    );
  }

  /* ---- the white front ---------------------------------------------------
   *
   * It is drawn in this section, on this section's own ground and under this
   * section's own dither. It used to be hung above the light band's box
   * instead, and that was the line: an element that paints outside its
   * section's background has no backdrop there, so the dither hung with it
   * stopped blending and turned into flat grey, straight across the page.
   *
   * The ramp is the same shape in both states, and the shape is the point. A
   * white front over a dark ground that goes from nothing to solid in a couple
   * of hundred pixels reads as a bar someone laid across the screen. This one
   * is eased -- slow to start, slow to finish -- and it is given half a
   * screen: enough that it has no edge to start or stop on, short enough that
   * it is never spread over the whole of what you are looking at.
   *
   * And it never becomes a field. The hold ends with the front laid across the
   * bottom third of the screen and reaching pure white on the last pixel of it
   * -- there is no band of plain white anywhere, because a band of plain white
   * is a piece of page with nothing on it. The white the band below is made of
   * arrives as the band below, not before it. What the front does is meet the
   * plate at its lower edge and hand over there.
   * -------------------------------------------------------------------- */
  .romap__dawn {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: var(--dawn-h);
    pointer-events: none;
    /* eleven stops off one curve, half linear and half smoothstep: eased at
       both ends so the front has no edge to start or stop on, and no steeper
       than a quarter of a luminance level per pixel in the middle, which is
       where a white front over a dark ground gives itself away as a bar. */
    background-image: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.064) 10%,
      rgba(255, 255, 255, 0.152) 20%,
      rgba(255, 255, 255, 0.258) 30%,
      rgba(255, 255, 255, 0.376) 40%,
      rgba(255, 255, 255, 0.5) 50%,
      rgba(255, 255, 255, 0.624) 60%,
      rgba(255, 255, 255, 0.742) 70%,
      rgba(255, 255, 255, 0.848) 80%,
      rgba(255, 255, 255, 0.936) 90%,
      #fff 100%
    );
  }

  /* Pinned, the front is a sheet a little over a screen tall and the screen is
     a window one screen high on to it, moved by --p. The sheet's height sets
     the travel, and its ramp runs to the sheet's own bottom edge: so the front
     is exactly at the screen's bottom edge on the first pixel of scroll and
     has risen a bit over a third of the screen by the last, still touching
     that bottom edge, still reaching white only there. Nothing is ever held
     with nothing happening on it, and nothing above the lower third is ever
     touched. */
  .romap__hold[data-pinned] .romap__dawn {
    inset: 0;
    height: auto;
    background-size: 100% 138%;
    background-position: 0 calc(var(--p, 0) * 100%);
    background-image: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0) 0 72.5%,
      rgba(255, 255, 255, 0.064) 75.25%,
      rgba(255, 255, 255, 0.152) 78%,
      rgba(255, 255, 255, 0.258) 80.75%,
      rgba(255, 255, 255, 0.376) 83.5%,
      rgba(255, 255, 255, 0.5) 86.25%,
      rgba(255, 255, 255, 0.624) 89%,
      rgba(255, 255, 255, 0.742) 91.75%,
      rgba(255, 255, 255, 0.848) 94.5%,
      rgba(255, 255, 255, 0.936) 97.25%,
      #fff 100%
    );
  }

  /* The dither, last, over everything the section draws -- both gradients and
     the 3D scene alike, since all three quantise the same way. One noise field
     over the lot: two of them stacked would make their own box where they
     overlapped, which is the kind of thing we are here to get rid of.
     Overlay, not opacity: mid-grey through overlay leaves a pixel exactly where
     it was, so this noise has no average brightness of its own and therefore no
     edge of its own, and it can cover the whole section unmasked. It also
     scales with what is under it, which is what we want: strongest where the
     light is and therefore where the rings are, nothing at all on black. Text
     is near white, where overlay is likewise almost a no-op. */
  .romap__dither,
  .romap__grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: overlay;
    opacity: 0.14;
    background-image: var(--grain);
    background-size: 200px 200px;
  }

  /* Two of them, and never both over the same pixel. The held screen paints its
     own ground, so it hides the section's grain exactly where its own starts:
     the seam between them is the pin's own edge, the two sides are the same
     noise at the same strength, and there is nothing there to see. One alone
     could not do it -- inside the pin it has no section ground to blend with
     (a sticky box is a stacking context), and outside it, it would crawl over a
     plate that is standing still. */
  .romap__grain {
    bottom: calc(-1 * var(--dawn-h));
  }

  .romap__hold[data-pinned] .romap__grain {
    bottom: 0;
  }

  .romap__stage {
    position: relative;
    /* The plate is about twice as wide as it is tall once the camera looks down
       at it, so the stage is cut to that shape: any other ratio makes the
       framing search back the camera off and leaves the map small in the middle
       of an empty box. The vh cap is what keeps a 2:1 box off the bottom of a
       short laptop, by narrowing it rather than by changing its shape -- which
       would cost the poster its exact fit. There is no pixel cap any more: on a
       wide screen it left the stage short of both edges, and nothing in here
       may stop before the window does. */
    width: min(100%, 176vh);
    aspect-ratio: 2 / 1;
    margin-inline: auto;
    margin-top: clamp(0.5rem, 2vh, 1.5rem);
  }

  /* Held, the plate shares the screen with the words above it, so its height is
     capped by what they leave -- and the cap is applied to the WIDTH, because
     width is what the ratio is derived from: cap the height directly and the
     ratio breaks, which costs the poster its exact fit and backs the camera
     off. The reserve is measured, not guessed: see the comment on --reserve. */
  /* A flex item with an auto margin on the cross axis does not stretch -- so in
     the held screen the words shrank to their own longest line and centred
     themselves in the page instead of starting at its edge. Full width, and
     their own max-width and auto margins centre the measure again. */
  .romap__hold[data-pinned] .romap__inner {
    width: 100%;
  }

  .romap__hold[data-pinned] .romap__stage {
    margin-top: 0;
    flex: 0 0 auto;
    width: min(100%, 176vh, calc(2 * (100dvh - var(--reserve))));
  }

  .romap__canvas {
    position: absolute;
    inset: 0;
  }

  .romap__canvas :global(canvas) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  .romap__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 700ms var(--ease-out);
  }

  .romap[data-ready] .romap__poster {
    opacity: 0;
  }

  /* ---- the names, written in the air -------------------------------------- */
  .romap__labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .romap__labels :global(.romap__name) {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    white-space: nowrap;
    will-change: transform, opacity;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-inv);
    text-shadow: 0 0 14px rgba(19, 180, 198, 0.55);
  }

  .romap__labels :global(.romap__name)::before {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    margin: 0 9px 1px 0;
    border-radius: 50%;
    vertical-align: middle;
    background-color: var(--t-glow);
    box-shadow: 0 0 10px var(--t-glow), 0 0 2px #fff;
  }

  .romap__labels :global(.romap__name--origin) {
    letter-spacing: 0.3em;
    font-weight: 700;
  }

  @media (max-width: 699px) {
    /* a 2:1 band is too thin to read as a room on a phone: the map ends up the
       same size either way, so the extra height is air around it, not waste */
    .romap__stage {
      aspect-ratio: 3 / 2;
    }

    .romap__hold[data-pinned] .romap__stage {
      width: min(100%, calc(1.5 * (100dvh - var(--reserve))));
    }

    /* the plate is a third of the size here; the names have to follow it down
       or they stop being captions and start being the picture */
    .romap__labels :global(.romap__name) {
      font-size: 0.625rem;
      letter-spacing: 0.14em;
    }

    .romap__labels :global(.romap__name)::before {
      width: 4px;
      height: 4px;
      margin-right: 6px;
    }
  }
</style>
