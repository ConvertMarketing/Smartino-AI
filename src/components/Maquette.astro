---
import { Image } from 'astro:assets';

/**
 * A maquette section: a 3D model of one of the group's places, pinned to the
 * screen while the camera flies through it.
 *
 * Two of these ship now -- the shops at Snagov and the warehouse at Otopeni --
 * so everything specific arrives as props and this file holds only what they
 * share. The scene itself lives in src/scripts/maquette.ts and arrives lazily.
 *
 * This file ships everything that must work before -- or without -- it: the
 * pre-rendered poster (scripts/poster.mjs writes it from the very same scene),
 * the labels as real links at their poster positions, and the words. When the
 * model is live the labels are re-projected every frame and the poster fades
 * under the canvas.
 *
 * The models are illustrations of the plots, drawn by the client in Claude
 * Design. Each section says so, and they must not be read as site plans.
 * TODO(client): confirm the footprints against the real plots before launch.
 */
export type MaquettePin = {
  /** the key the runtime uses, also the data-pin attribute */
  key: string;
  /** the baked plaque node in the GLB; its position anchors the HTML label */
  plaque: string;
  /** node-name prefix of the meshes that light up with this label */
  match: string;
  name: string;
  meta: string;
  href: string;
  label: string;
  external?: boolean;
};

interface Props {
  id: string;
  /** file name under public/models, without the extension */
  model: string;
  poster: ImageMetadata;
  posterAlt: string;
  kicker: string;
  title: string;
  lead: string;
  pins: MaquettePin[];
  /** optional three-key camera path, when the default does not suit the plot */
  keys?: { yaw: number; pitch: number; dist: number; ty: number }[];
  /** when the section below is dark too: the model dissolves into it instead
   *  of scrolling away with an edge */
  dissolve?: boolean;
  /** the projected label positions written by scripts/poster.mjs */
  spots: Record<string, { x: number; y: number }>;
}

const { id, model, poster, posterAlt, kicker, title, lead, pins, spots, keys, dissolve } = Astro.props;
---

<section class:list={['mq', dissolve && 'mq--dissolve']} id={id} aria-labelledby={`mq-title-${id}`} data-maquette data-mq-model={model} data-mq-keys={keys ? JSON.stringify(keys) : undefined}>
  <div class="mq__stage" data-mq-stage>
    <div class="mq__canvas" data-mq-canvas aria-hidden="true"></div>
    <Image
      class="mq__poster"
      src={poster}
      alt={posterAlt}
      widths={[720, 1200, 1600]}
      sizes="100vw"
      loading="lazy"
    />

    <div class="mq__copy">
      <p class="mq__kicker" data-reveal>{kicker}</p>
      <h2 class="mq__title" id={`mq-title-${id}`} data-reveal>{title}</h2>
      <p class="mq__lead" data-reveal>{lead}</p>
      <p class="mq__note">Machetă ilustrativă a ansamblului — nu un plan tehnic.</p>
    </div>

    {
      pins.map((pin) => (
        <a
          class="mq__pin"
          data-pin={pin.key}
          data-plaque={pin.plaque}
          data-match={pin.match}
          href={pin.href}
          rel={pin.external ? 'noopener' : undefined}
          style={`left: ${(spots[pin.key] ?? { x: 50 }).x}%; top: ${(spots[pin.key] ?? { y: 50 }).y}%`}
          aria-label={pin.label}
        >
          <span class="mq__tag">
            <span class="mq__tagName">{pin.name}</span>
            <span class="mq__tagMeta tnum">{pin.meta}</span>
          </span>
        </a>
      ))
    }

    <p class="mq__hint" data-mq-hint>Trage ca să rotești · derulează ca să zbori</p>
  </div>
</section>

<style>
  /* The handover, when what follows is dark as well: the model sinks back into
     the black while the next section is already rising over it, the same way
     the brand wall gives way to the story. Without it the plot simply scrolls
     off and leaves a straight edge across the screen. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .mq--dissolve .mq__stage {
        animation: mq-sink linear both;
      }

      /* own rule, higher specificity: apart from the shorthand so a minifier
         cannot fold the timeline into it, and above it so its reset loses */
      .mq--dissolve .mq__stage.mq__stage {
        animation-timeline: view();
        animation-range: exit 12% exit 86%;
      }
    }
  }

  @keyframes mq-sink {
    to {
      opacity: 0;
      transform: scale(0.94);
      filter: blur(7px);
    }
  }

  .mq {
    position: relative;
    height: 260vh;
    background-color: var(--ink);
    color: var(--fg-inv);
  }

  .mq__stage {
    position: sticky;
    top: 0;
    height: 100dvh;
    overflow: hidden;
    background-color: var(--ink);
  }

  /* studio light behind the model: a turquoise pool low on the floor and a
     vignette at the edges, both on a layer the text never sits on */
  .mq__stage::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      radial-gradient(60% 45% at 62% 82%, rgba(19, 180, 198, 0.22), transparent 70%),
      radial-gradient(120% 90% at 50% 50%, transparent 55%, rgba(0, 0, 0, 0.55) 100%);
  }

  .mq__canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    cursor: grab;
  }

  .mq[data-dragging] .mq__canvas {
    cursor: grabbing;
  }

  .mq[data-ready] .mq__canvas {
    opacity: 1;
  }

  .mq__canvas :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .mq__poster {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 900ms var(--ease-out);
  }

  .mq[data-ready] .mq__poster {
    opacity: 0;
    pointer-events: none;
  }

  /* ---- words ------------------------------------------------------------ */
  /* The words open the scene, then step aside: once the flight is a fifth
     of the way through (--mqp, written by the scene each frame) the model
     has the screen to itself. Without the scene, --mqp is 0 and they stay. */
  .mq__copy {
    position: absolute;
    z-index: 3;
    left: var(--gutter);
    top: clamp(3.5rem, 9vh, 6.5rem);
    max-width: 27rem;
    pointer-events: none;
    opacity: clamp(0, calc((0.3 - var(--mqp, 0)) / 0.16), 1);
  }

  .mq__kicker {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--t-glow);
  }

  .mq__title {
    margin-top: 0.875rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.1rem + 2.4vw, 3rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--fg-inv);
  }

  .mq__lead {
    margin-top: 1rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--fg-inv-2);
    max-width: 24rem;
  }

  .mq__note {
    margin-top: 1.25rem;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-inv-2);
  }

  /* ---- labels: real links, projected from the model ---------------------- */
  /* the anchor itself: a lit point on the building, the tag floats above it */
  .mq__pin {
    position: absolute;
    z-index: 2;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    background-color: var(--t);
    box-shadow: 0 0 0 4px rgba(19, 180, 198, 0.28);
    text-decoration: none;
  }

  /* Until the scene mounts, the labels sit at the percentages the desktop
     render projected them to. On a narrower screen those land wherever the
     camera happened to put the building at 1600x1000 -- which for Otopeni is
     on top of the words. While the poster is showing they park low instead;
     the runtime takes the positions back the moment the model starts, and on
     a wide screen the projected spots are already right, so nothing moves
     there. */
  @media (max-width: 1199px) {
    .mq:not([data-ready]) .mq__pin {
      top: auto !important;
      bottom: clamp(5rem, 12vh, 7rem);
    }

    .mq:not([data-ready]) .mq__pin:nth-of-type(1) {
      left: 28% !important;
    }

    .mq:not([data-ready]) .mq__pin:nth-of-type(2) {
      left: 72% !important;
    }
  }

  /* set by the scene when this tag would sit on the opening words */
  .mq__pin[data-shy] .mq__tag {
    opacity: 0;
    visibility: hidden;
  }

  .mq__tag {
    --tx: -50%;
    --stem: 50%;
    position: absolute;
    left: 50%;
    bottom: 19px;
    transform: translateX(var(--tx));
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.55rem 0.8rem 0.6rem;
    border-radius: 10px;
    white-space: nowrap;
    background-color: rgba(11, 15, 16, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: var(--lift-2);
    transition:
      transform var(--d-micro) var(--ease-out),
      border-color var(--d-micro) var(--ease-out),
      box-shadow var(--d-micro) var(--ease-out);
  }

  /* the stem down to the anchor */
  .mq__tag::after {
    content: '';
    position: absolute;
    left: var(--stem);
    top: 100%;
    width: 1px;
    height: 14px;
    background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.5), var(--t));
  }

  .mq__pin:hover .mq__tag,
  .mq__pin[data-hot] .mq__tag,
  .mq__pin:focus-visible .mq__tag {
    transform: translateX(var(--tx)) translateY(-4px);
    border-color: var(--t);
    box-shadow: var(--lift-t);
  }

  .mq__pin[data-edge='l'] .mq__tag {
    --tx: -12%;
    --stem: 12%;
  }

  .mq__pin[data-edge='r'] .mq__tag {
    --tx: -88%;
    --stem: 88%;
  }

  .mq__pin[data-behind] {
    visibility: hidden;
  }

  .mq__tagName {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--fg-inv);
  }

  .mq__tagMeta {
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--fg-inv-2);
  }

  /* ---- hint ------------------------------------------------------------ */
  .mq__hint {
    display: none;
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 1.25rem;
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--fg-inv-2);
    pointer-events: none;
    transition: opacity 600ms var(--ease-out);
  }

  :global([data-js]) .mq__hint {
    display: block;
  }

  .mq[data-dragged] .mq__hint {
    opacity: 0;
  }

  @media (max-width: 899px) {
    .mq {
      height: 220vh;
    }

    .mq__copy {
      right: var(--gutter);
      max-width: none;
      top: clamp(2.5rem, 6vh, 4rem);
    }

    .mq__lead {
      max-width: 22rem;
    }

    .mq__tag {
      padding: 0.45rem 0.65rem 0.5rem;
    }

    .mq__tagName {
      font-size: 0.8125rem;
    }

    .mq__tagMeta {
      font-size: 0.625rem;
    }
  }
</style>
