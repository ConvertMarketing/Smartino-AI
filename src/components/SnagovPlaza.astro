---
import { COMPANY, SUPERMARKET_HOURS, TIMELINE } from '../lib/data';

/**
 * Where to find the group, and how to reach it.
 *
 * The schematic site plan that used to sit here is gone at the client's
 * request: it drew two rectangles and a dashed line, which said less than the
 * one word "vizavi" already says, and it claimed a geometry nobody had
 * measured. What is left is the part a visitor actually uses -- address,
 * hours, phones, e-mail -- arranged as four panels lit against the dark.
 *
 * The "deschis acum" line is the only thing on this page that changes by
 * itself: site.ts computes it in the reader's browser against Bucharest time,
 * and it stays hidden until it can be computed, so no JavaScript means no
 * wrong claim about whether the door is open.
 */
const mapsQuery = encodeURIComponent(
  `${COMPANY.address.venue}, ${COMPANY.address.street}, ${COMPANY.address.locality}`
);

/** The shape site.ts reads: day numbers plus the two clock times. */
const hoursSpec = JSON.stringify(
  SUPERMARKET_HOURS.map((h) => ({ dow: h.dow, open: h.open, close: h.close }))
);

const [phoneA, phoneB, phoneShop] = COMPANY.phones;
---

<section class="plaza" id="snagov-plaza" aria-labelledby="plaza-title">

  <div class="plaza__inner">
    <p class="plaza__kicker" data-reveal>Ne găsești aici</p>
    <h2 class="plaza__title" id="plaza-title" data-animate="words" aria-label="Snagov Plaza">
      <span aria-hidden="true">
        {'Snagov Plaza'.split(' ').map((w, i) => (
          <span class="w"><span class="w__in" style={`--wi: ${i}`}>{w}</span></span>
        ))}
      </span>
    </h2>
    <p class="plaza__lede" data-reveal style="--i: 1">
      Cele două magazine fizice ale grupului, unul în fața celuilalt.
    </p>

    <div class="plaza__deck">
      <article class="pc pc--place" data-reveal style="--i: 1">
        <p class="pc__label">Adresa</p>
        <span class="pc__pin" aria-hidden="true"></span>
        <address class="pc__address">
          {COMPANY.address.venue}<br />
          {COMPANY.address.street}<br />
          {COMPANY.address.locality}
        </address>
        <a
          class="pc__action"
          href={`https://www.google.com/maps/search/?api=1&query=${mapsQuery}`}
          rel="noopener"
        >
          Deschide în hărți <span aria-hidden="true">↗</span>
        </a>
      </article>

      <article class="pc" data-reveal style="--i: 2">
        <p class="pc__label">Program · Supermarket</p>
        <p class="pc__status" data-open-now data-hours={hoursSpec} hidden></p>
        <dl class="pc__hours tnum">
          {
            SUPERMARKET_HOURS.map((h) => (
              <div class="pc__hourRow">
                <dt>{h.days}</dt>
                <dd>
                  {h.open}–{h.close}
                </dd>
              </div>
            ))
          }
        </dl>
        {/* Not guessed. This is the largest store in the group and a wrong time
            sends someone driving to Tâncăbești for nothing.
            TODO(client): opening hours for Smartino Home. */}
        <p class="pc__note">Smartino Home: programul se anunță în curând.</p>
      </article>

      <article class="pc" data-reveal style="--i: 3">
        <p class="pc__label">Telefon</p>
        <a class="pc__big" href={phoneA.href}>{phoneA.value}</a>
        <a class="pc__big" href={phoneB.href}>{phoneB.value}</a>
        <p class="pc__sub">
          <span>{phoneShop.label}</span>
          <a href={phoneShop.href}>{phoneShop.value}</a>
        </p>
      </article>

      <article class="pc" data-reveal style="--i: 4">
        <p class="pc__label">E-mail</p>
        <a class="pc__big pc__big--mail" href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
        <p class="pc__note">Pentru colaborări, furnizori și presă.</p>
      </article>
    </div>

    <p class="plaza__opened tnum" data-reveal style="--i: 5">
      Supermarket, {TIMELINE.first.label}. Home, {TIMELINE.second.label}.
    </p>
  </div>
</section>

<style>
  .plaza {
    position: relative;
    overflow: clip; /* clip, not hidden: hidden makes this a scroll container,
                       and every scroll-driven animation inside would then
                       measure against a box that never scrolls */
    color: var(--fg-inv);
    padding-block: clamp(4rem, 9vh, 6rem) clamp(3rem, 6vh, 4.5rem);
  }

  .plaza__inner {
    position: relative;
    z-index: 1;
    max-width: var(--content);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .plaza__kicker {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--t-glow);
  }

  .plaza__title {
    margin-top: 0.875rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .plaza__lede {
    margin-top: 0.5rem;
    color: var(--fg-inv-2);
  }

  /* ---- the four panels -------------------------------------------------- */
  .plaza__deck {
    margin-top: clamp(2rem, 5vh, 3rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(12px, 1.4vw, 20px);
  }

  .pc {
    position: relative;
    padding: clamp(1.25rem, 2.4vw, 1.75rem);
    border: 1px solid var(--line-dark);
    border-radius: 18px;
    background-color: var(--ink-2);
    transition:
      border-color var(--d-state) var(--ease-out),
      box-shadow var(--d-state) var(--ease-out),
      transform var(--d-state) var(--ease-out);
  }

  .pc:hover,
  .pc:focus-within {
    border-color: rgba(75, 216, 232, 0.55);
    box-shadow: 0 18px 46px rgba(19, 180, 198, 0.18);
    transform: translateY(-3px);
  }

  .pc__label {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--fg-inv-2);
  }

  .pc__address {
    margin-top: 0.875rem;
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 0.95rem + 0.4vw, 1.375rem);
    font-weight: 600;
    font-style: normal;
    line-height: 1.5;
  }

  /* a light on the map, breathing */
  .pc__pin {
    position: absolute;
    top: clamp(1.25rem, 2.4vw, 1.75rem);
    right: clamp(1.25rem, 2.4vw, 1.75rem);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--t-glow);
    box-shadow: 0 0 0 0 rgba(75, 216, 232, 0.55);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pc__pin {
      animation: pin-pulse 2.6s var(--ease-in-out) infinite;
    }
  }

  @keyframes pin-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(75, 216, 232, 0.5);
    }
    70% {
      box-shadow: 0 0 0 16px rgba(75, 216, 232, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(75, 216, 232, 0);
    }
  }

  .pc__action {
    display: inline-block;
    margin-top: 1.125rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--t-glow);
    text-decoration: none;
    border-bottom: 1px solid rgba(75, 216, 232, 0.4);
    padding-bottom: 2px;
  }

  .pc__action:hover {
    border-bottom-color: var(--t-glow);
  }

  /* ---- hours ------------------------------------------------------------ */
  .pc__status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.875rem;
    padding: 0.3125rem 0.75rem 0.3125rem 0.625rem;
    border-radius: 999px;
    border: 1px solid var(--line-dark-strong);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--fg-inv);
  }

  .pc__status::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--fg-inv-2);
  }

  .pc__status[data-state='open'] {
    border-color: rgba(75, 216, 232, 0.5);
  }

  .pc__status[data-state='open']::before {
    background-color: var(--t-glow);
    box-shadow: 0 0 10px var(--t-glow);
  }

  .pc__hours {
    margin: 0.875rem 0 0;
  }

  .pc__hourRow {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--line-dark);
  }

  .pc__hourRow dt {
    color: var(--fg-inv-2);
    font-size: 0.9375rem;
  }

  /* the gap between day and time is a dotted leader, the way a timetable
     prints it -- it also survives any width */
  .pc__hourRow dt::after {
    content: '';
    display: inline-block;
    width: 100%;
  }

  .pc__hourRow dd {
    margin: 0;
    margin-left: auto;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    white-space: nowrap;
  }

  .pc__note {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--fg-inv-2);
  }

  /* ---- phones and mail --------------------------------------------------- */
  .pc__big {
    display: block;
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 0.95rem + 0.6vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--fg-inv);
    text-decoration: none;
  }

  .pc__big:hover {
    color: var(--t-glow);
  }

  .pc__big--mail {
    font-size: clamp(1rem, 0.85rem + 0.5vw, 1.25rem);
    overflow-wrap: anywhere;
  }

  .pc__sub {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 1.125rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--line-dark);
    font-size: 0.875rem;
    color: var(--fg-inv-2);
  }

  .pc__sub a {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--fg-inv);
    text-decoration: none;
  }

  .pc__sub a:hover {
    color: var(--t-glow);
  }

  .plaza__opened {
    margin-top: clamp(1.75rem, 4vh, 2.5rem);
    font-size: 0.8125rem;
    color: var(--fg-inv-2);
  }

  @media (max-width: 899px) {
    .plaza__deck {
      grid-template-columns: 1fr;
    }
  }
</style>
