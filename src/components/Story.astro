---
import { Image } from 'astro:assets';
import homeCladire from '../assets/photos/smartino-home-cladire.jpg';
import supermarketFoto from '../assets/photos/smartino-supermarket-interior.jpg';
import shopSite from '../assets/photos/smartinoshop-site.jpg';
import { TIMELINE, FACTS, ORIGIN, BRAND_ORIGIN_NOTE } from '../lib/data';

/**
 * The story, told properly: five chapters scrolling past a pinned visual that
 * answers each one. Every fact in the copy comes from the client -- the three
 * early years carry no day or month, because none was given and none is
 * invented.
 *
 * The chapter that names the Republic of Moldova is also the one that carries
 * the note about who operates what: the brand starts there, the Romanian
 * company operates it here, and smartino.md belongs to RINCOM-GRUP SRL.
 *
 * The pinned plates are decorative (aria-hidden): the words carry the story,
 * the visual carries the feeling. Without JS the first plate simply stays.
 */
const chapters = [
  {
    n: 'Capitolul unu',
    title: 'Începutul',
    body: [
      `${ORIGIN.year}. Numele Smartino apare pentru prima dată în Republica Moldova, pe rafturi de produse pentru casă și îngrijire.`,
      `În anii care urmează ajunge unul dintre numele mari ale pieței de acolo — destul de puternic cât să merite dus mai departe.`,
    ],
    note: true,
  },
  {
    n: 'Capitolul doi',
    title: 'Peste Prut',
    body: [
      `${ORIGIN.romania}. Brandul intră în România, cu aceleași categorii care l-au făcut cunoscut acasă: igienă, îngrijire, curățenie.`,
      `Aceeași idee, o piață de zece ori mai mare.`,
    ],
  },
  {
    n: 'Capitolul trei',
    title: 'Non-stop',
    body: [
      `${ORIGIN.online}. Se deschide smartinoshop.ro — catalogul de îngrijire și curățenie al grupului, livrat în toată țara.`,
      `Primul raft Smartino fără program de funcționare.`,
    ],
  },
  {
    n: 'Capitolul patru',
    title: 'Un magazin',
    body: [
      `${TIMELINE.first.label}. La Snagov Plaza se aprind luminile în primul magazin fizic: un supermarket cu lucrurile de care o familie are nevoie în fiecare zi.`,
      `Fără artificii. Program lung, rafturi pline, drum scurt.`,
    ],
  },
  {
    n: 'Capitolul cinci',
    title: 'Vizavi',
    body: [
      `${TIMELINE.second.label}, la 379 de zile după primul magazin. Peste drum se deschide Smartino Home: peste 1.200 m² de mobilier, grădină, textile și decor, plus catalogul online.`,
      `Aceeași promisiune, extinsă de la nevoile zilei către casa întreagă. Douăzeci și cinci de ani de la primul raft.`,
    ],
    facts: true,
  },
];
---

<section class="story" id="povestea" aria-labelledby="story-title" data-story>
  <h2 class="sr-only" id="story-title">Povestea grupului</h2>

  <div class="story__frame">
    <div class="story__visual" aria-hidden="true">
      {/* Plate 1 — the year the name is born, on a line that starts climbing. */}
      <div class="story__plate" data-plate="1">
        <svg viewBox="0 0 800 500" preserveAspectRatio="xMidYMid slice">
          <rect width="800" height="500" fill="var(--ink)"></rect>
          <g stroke="var(--t)" fill="none">
            <path d="M -20 470 C 180 460, 300 430, 420 380 S 660 270, 830 210" stroke-width="2.6" opacity="0.85"></path>
            <path d="M -20 490 C 180 484, 300 464, 420 428 S 660 348, 830 300" stroke-width="1.2" opacity="0.35"></path>
          </g>
          <circle cx="120" cy="466" r="7" fill="var(--t-glow)"></circle>
          <circle cx="400" cy="250" r="180" fill="url(#glow-a)"></circle>
          <defs>
            <radialGradient id="glow-a">
              <stop offset="0%" stop-color="rgba(19,180,198,0.34)"></stop>
              <stop offset="100%" stop-color="rgba(19,180,198,0)"></stop>
            </radialGradient>
          </defs>
        </svg>
        <p class="story__giant tnum">{ORIGIN.year}</p>
        <p class="story__plateLabel">Republica Moldova</p>
      </div>

      {/* Plate 2 — the same line, crossing a border. */}
      <div class="story__plate" data-plate="2">
        <svg viewBox="0 0 800 500" preserveAspectRatio="xMidYMid slice">
          <rect width="800" height="500" fill="var(--ink)"></rect>
          <g stroke="var(--t)" fill="none">
            <path d="M -20 470 C 180 460, 300 430, 420 380 S 660 250, 830 160" stroke-width="2.6" opacity="0.85"></path>
          </g>
          <line x1="400" y1="40" x2="400" y2="460" stroke="var(--fg-inv-2)" stroke-dasharray="4 10" opacity="0.6"></line>
          <circle cx="400" cy="392" r="9" fill="var(--t-glow)"></circle>
          <circle cx="400" cy="250" r="180" fill="url(#glow-b)"></circle>
          <defs>
            <radialGradient id="glow-b">
              <stop offset="0%" stop-color="rgba(19,180,198,0.34)"></stop>
              <stop offset="100%" stop-color="rgba(19,180,198,0)"></stop>
            </radialGradient>
          </defs>
        </svg>
        <p class="story__giant tnum">{ORIGIN.romania}</p>
        <p class="story__plateLabel">România</p>
      </div>

      {/* Plate 3 — the shop that has no opening hours. */}
      <div class="story__plate" data-plate="3">
        <Image
          class="story__photo story__photo--top"
          src={shopSite}
          alt=""
          widths={[640, 960, 1440]}
          sizes="(max-width: 899px) 100vw, 46vw"
          loading="lazy"
        />
        <span class="story__scrim"></span>
        <p class="story__plateLabel tnum">smartinoshop.ro · {ORIGIN.online}</p>
      </div>

      {/* Plate 4 — the first shelves, photographed. */}
      <div class="story__plate" data-plate="4">
        <Image
          class="story__photo"
          src={supermarketFoto}
          alt=""
          widths={[640, 960, 1440]}
          sizes="(max-width: 899px) 100vw, 46vw"
          loading="lazy"
        />
        <span class="story__scrim"></span>
        <p class="story__plateLabel tnum">{TIMELINE.first.label}</p>
      </div>

      {/* Plate 5 — the second building, and the count of days between them. */}
      <div class="story__plate" data-plate="5">
        <Image
          class="story__photo"
          src={homeCladire}
          alt=""
          widths={[640, 960, 1440]}
          sizes="(max-width: 899px) 100vw, 46vw"
          loading="lazy"
        />
        <span class="story__scrim story__scrim--deep"></span>
        <p class="story__giant story__giant--over tnum">379</p>
        <p class="story__plateLabel tnum">{TIMELINE.second.label} · 1.200 m²</p>
        <span class="story__ticks"></span>
      </div>
    </div>

    <div class="story__steps">
      {
        chapters.map((c, i) => (
          <article class="story__step" data-step={i + 1}>
            <p class="story__kicker">{c.n}</p>
            <h3 class="story__title" data-animate="words" aria-label={c.title}>
              <span aria-hidden="true">
                {c.title.split(' ').map((w, wi) => (
                  <span class="w"><span class="w__in" style={`--wi: ${wi}`}>{w}</span></span>
                ))}
              </span>
            </h3>
            {c.body.map((p) => (
              <p class="story__copy" data-reveal>{p}</p>
            ))}
            {c.note && <p class="story__legal" data-reveal>{BRAND_ORIGIN_NOTE}</p>}
            {c.facts && (
              <>
                <dl class="story__facts" data-reveal>
                  {FACTS.map((f) => (
                    <div class="story__fact">
                      <dt class="story__factValue tnum" data-count={f.n} data-suffix={f.suffix}>{f.value}</dt>
                      <dd class="story__factLabel">{f.label}</dd>
                    </div>
                  ))}
                </dl>
              </>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .story {
    /* Pulled up into the brand wall's runway: the first chapter rises through
       the same dark the logos are sinking into, so the two sections share a
       stretch of scroll instead of meeting at a line. The z-index keeps the
       words above the wall while they overlap. */
    position: relative;
    z-index: 1;
    margin-top: clamp(-13rem, -26vh, -6rem);
    background-color: transparent;
    color: var(--fg-inv);
  }

  /* the ground the story stands on, faded in over the overlap so the wall
     shows through at the top and nothing shows through further down */
  .story::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image: linear-gradient(180deg, transparent, var(--ink) clamp(14rem, 28vh, 22rem));
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .story__frame {
    max-width: var(--content);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
  }

  .story__visual {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    display: grid;
    align-items: center;
  }

  .story__plate {
    grid-area: 1 / 1;
    position: relative;
    height: min(62vh, 560px);
    border-radius: 24px;
    overflow: hidden;
    background-color: var(--ink-2);
    box-shadow: var(--lift-2);
    opacity: 0;
    transform: scale(0.96);
    transition:
      opacity 600ms var(--ease-out),
      transform 600ms var(--ease-out);
    display: grid;
    place-items: center;
  }

  /* Plate 1 shows by default, so the column is never empty without JS. */
  .story__plate[data-plate='1'],
  [data-step='1'] .story__plate[data-plate='1'] {
    opacity: 1;
    transform: none;
  }

  [data-step] .story__plate[data-plate='1'] {
    opacity: 0;
    transform: scale(0.96);
  }

  [data-step='1'] .story__plate[data-plate='1'],
  [data-step='2'] .story__plate[data-plate='2'],
  [data-step='3'] .story__plate[data-plate='3'],
  [data-step='4'] .story__plate[data-plate='4'],
  [data-step='5'] .story__plate[data-plate='5'] {
    opacity: 1;
    transform: none;
  }

  .story__plate svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .story__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* a website screenshot is read from the top, not from its middle */
  .story__photo--top {
    object-position: top center;
  }

  .story__scrim {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(180deg, rgba(11, 15, 16, 0.15), rgba(11, 15, 16, 0.72) 85%),
      linear-gradient(120deg, rgba(19, 180, 198, 0.28), transparent 55%);
    mix-blend-mode: multiply;
  }

  .story__plateLabel {
    position: absolute;
    left: 1.5rem;
    bottom: 1.25rem;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--t-glow);
    text-shadow: 0 1px 8px rgba(11, 15, 16, 0.8);
  }

  .story__scrim--deep {
    background-image:
      linear-gradient(180deg, rgba(11, 15, 16, 0.45), rgba(11, 15, 16, 0.82) 85%),
      linear-gradient(120deg, rgba(19, 180, 198, 0.3), transparent 55%);
  }

  .story__giant {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-size: clamp(6rem, 14vw, 13rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    background-image: linear-gradient(120deg, var(--t-glow), var(--t));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* over a photograph the number needs its own weight behind it */
  .story__giant--over {
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 6px 26px rgba(11, 15, 16, 0.85));
  }

  .story__ticks {
    position: absolute;
    inset-block: 12%;
    right: 12%;
    width: 22px;
    background-image: repeating-linear-gradient(
      to bottom,
      rgba(19, 180, 198, 0.6) 0 1px,
      transparent 1px 14px
    );
  }

  .story__steps {
    padding-block: 14vh 18vh;
    display: grid;
    gap: 26vh;
  }

  .story__step {
    max-width: 30rem;
  }

  .story__kicker {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--t);
  }

  .story__title {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.6rem + 2.6vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  .story__copy {
    margin-top: 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--fg-inv-2);
  }

  .story__copy:first-of-type {
    color: var(--fg-inv);
  }

  .story__facts {
    margin-top: 2.25rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    border-top: 1px solid var(--line-dark);
    padding-top: 1.5rem;
  }

  .story__factValue {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .story__factLabel {
    margin-top: 0.125rem;
    font-size: 0.875rem;
    color: var(--fg-inv-2);
  }

  .story__legal {
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    color: var(--fg-inv-2);
  }

  @media (max-width: 899px) {
    .story__frame {
      grid-template-columns: 1fr;
    }

    /* On phones the visual becomes a banner pinned above each step. */
    .story__visual {
      position: sticky;
      top: 0;
      height: 42vh;
      z-index: 1;
      align-items: stretch;
      padding-top: 0.75rem;
    }

    .story__plate {
      height: calc(42vh - 1.5rem);
    }

    .story__steps {
      padding-block: 6vh 12vh;
      gap: 14vh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .story__plate {
      transition: none;
    }
  }
</style>
