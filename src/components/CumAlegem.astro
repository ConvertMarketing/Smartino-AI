---
/**
 * Curation: what "Ales de Smartino" has to mean before it can be printed on
 * anything.
 *
 * The client's point, in their own words: a supplier getting into Smartino
 * passes a selection, not a listing. So the six criteria are set as a row of
 * equals -- none of them ranked, none of them explained away -- and the phrase
 * itself closes the section at full size.
 */
const CRITERIA = ['Calitate', 'Valoare', 'Design', 'Utilitate', 'Relevanță', 'Diferențiere'];
---

<section class="pick" aria-labelledby="pick-title">
  <div class="pick__inner">
    <p class="pick__kicker" data-reveal>Cum alegem</p>
    <h2 class="pick__title" id="pick-title" data-reveal style="--i: 1">
      Nu orice produs trebuie să ajungă la Smartino.
    </h2>
    <p class="pick__body" data-reveal style="--i: 2">
      Oamenii nu au nevoie doar de mai multe opțiuni. Au nevoie de motive să aleagă altfel. De
      aceea Smartino caută, selectează și aduce produse și branduri care merită descoperite. Le
      oferim contextul necesar pentru ca oamenii să le poată înțelege, compara și alege cu
      încredere.
    </p>

    <ul class="pick__crit" aria-label="Criteriile după care selectăm" data-reveal style="--i: 3">
      {
        CRITERIA.map((c, i) => (
          <li class="crit" style={`--k: ${i}`}>
            {c}
          </li>
        ))
      }
    </ul>

    <p class="pick__seal" data-reveal style="--i: 8">Ales de Smartino.</p>
  </div>
</section>

<style>
  /* One lamp, low and to the right, so the two dark bands either side of this
     one are not lit from the same place: the section above throws its light
     high on the right and low on the left, the zone below opens with a wide one
     across the middle. Painted on the section itself rather than on an element
     of its own -- nothing here is over anything, so there is nothing to blend
     with and no box to give away. */
  .pick {
    position: relative;
    overflow: clip;
    background-color: var(--ink);
    color: var(--fg-inv);
    background-image: radial-gradient(
      44% 38% at 84% 72%,
      rgba(19, 180, 198, 0.16),
      transparent 74%
    );
    padding-block: clamp(3rem, 8vh, 5rem) clamp(5rem, 13vh, 8rem);
  }

  .pick__inner {
    position: relative;
    z-index: 1;
    max-width: var(--content);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .pick__kicker {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--t-glow);
  }

  .pick__title {
    margin-top: 0.875rem;
    max-width: 20ch;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.25rem + 2.1vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .pick__body {
    margin-top: clamp(1.25rem, 3vh, 2rem);
    max-width: 52ch;
    line-height: 1.6;
    color: var(--fg-inv-2);
  }

  /* ---- the threshold ------------------------------------------------------
   *
   * Six equals, and still not a ranked list -- but a band of six compartments
   * rather than six tags dropped next to the paragraph. What the section says
   * about them is that they are a threshold: a product passes all six or it
   * does not arrive. So they are drawn as six things to pass through, and they
   * light one after another from the left, with the phrase that is made of
   * them landing after the last.
   *
   * The lines between them are the grid's own gaps, one pixel of rule showing
   * through from underneath: interior lines only, no frame, and the same
   * markup works as one row of six or as two columns of three without a single
   * border being redeclared.
   * ---------------------------------------------------------------------- */
  .pick__crit {
    margin: clamp(2rem, 5vh, 3rem) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1px;
    background-color: var(--line-dark-strong);
  }

  .crit {
    display: grid;
    place-items: center;
    padding: clamp(1.125rem, 2.6vh, 1.75rem) 0.625rem;
    background-color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 0.8rem + 0.45vw, 1.25rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.1;
    text-align: center;
    text-wrap: balance;
    color: var(--fg-inv);
  }

  @media (max-width: 899px) {
    .pick__crit {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* the pass: each compartment takes the light in turn, and the reveal the
       band already has is what starts the count */
    :global([data-js]) .crit {
      color: var(--fg-inv-2);
      transition:
        background-color 560ms var(--ease-out),
        color 560ms var(--ease-out);
      transition-delay: calc(var(--k, 0) * 90ms + 240ms);
    }

    /* 7% of the turquoise was enough to read as a tint on paper; on ink the
       same 7% is nothing, so the mix is twice that and the compartment still
       stays well under the rule that separates it from its neighbour. */
    :global([data-js]) .pick__crit[data-in] .crit {
      background-color: color-mix(in srgb, var(--t) 15%, var(--ink));
      color: var(--fg-inv);
    }
  }

  .pick__seal {
    margin-top: clamp(2.5rem, 7vh, 4.5rem);
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.2rem + 3.6vw, 4.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--fg-inv);
  }
</style>
