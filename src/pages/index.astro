---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Timeline from '../components/Timeline.astro';
import UnitSection from '../components/UnitSection.astro';
import SnagovPlaza from '../components/SnagovPlaza.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { UNITS } from '../lib/data';

const title = 'Smartino International — un grup crescut dintr-un singur magazin';
const description =
  'Smartino International SRL reunește Smartino Supermarket și Smartino Home în Snagov Plaza, ' +
  'plus magazinele online Smartino Shop și Smartino Moldova.';
---

<Base title={title} description={description}>
  <main>
    <Hero />
    <Timeline />
    {UNITS.map((unit, i) => <UnitSection unit={unit} alt={i % 2 === 1} />)}
    <SnagovPlaza />
  </main>
  <SiteFooter />
</Base>
