---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Maquette from '../components/Maquette.astro';
import Tranzitie from '../components/Tranzitie.astro';
import Infrastructura from '../components/Infrastructura.astro';
import Arhitectura from '../components/Arhitectura.astro';
import RoMap from '../components/RoMap.astro';
import CumGandim from '../components/CumGandim.astro';
import CumAlegem from '../components/CumAlegem.astro';
import Brands from '../components/Brands.astro';
import Parteneriate from '../components/Parteneriate.astro';
import SnagovPlaza from '../components/SnagovPlaza.astro';
import SiteFooter from '../components/SiteFooter.astro';
import snagovPoster from '../assets/photos/snagov-plaza-macheta.png';
import otopeniPoster from '../assets/photos/otopeni-macheta.png';
import spots from '../data/maquette-pins.json';
import { COMPANY, UNITS, TIMELINE, HOME_HOURS, HOME_AREA } from '../lib/data';

/* The two maquettes. Everything specific to a scene lives here; the component
 * and the 3D runtime know none of it.
 *
 * The pins carry the opening dates now. The chapter-by-chapter history is gone
 * at the client's request -- what it was there to say is said where each store
 * is actually shown, which is here, in the diagram, and in the address block. */
const [, home] = UNITS;

const title = 'Smartino International — import, distribuție, retail și e-commerce';
const description =
  'Grupul Smartino: import direct și distribuție, magazinele Smartino Supermarket și Smartino Home ' +
  'la Snagov, magazinele online Smartino Shop și Smartino Home, plus partenerul din Republica Moldova.';
---

<Base title={title} description={description}>
  <main>
    <Hero />

    {/* One dark room, not a stack of sections that happen to be the same
        colour. The lamps live on the wrapper, above and below, so the light
        crosses every join because nothing cuts it. The ground is solid here,
        which is what the sections' text is measured against. */}
    <div class="zone">
      <span class="zone__lamp" aria-hidden="true"></span>
      <span class="zone__lamp--low" aria-hidden="true"></span>

      <Maquette
        id="macheta"
        model="snagov-plaza"
        poster={snagovPoster}
        posterAlt="Macheta ilustrativă a ansamblului Smartino Snagov: inelul Smartino Home și hala Smartino Supermarket"
        kicker={COMPANY.address.oneLine}
        title="Laboratorul nostru fizic de retail."
        lead="Locul în care construim, testăm și perfecționăm felul în care produsele, spațiul și experiența se întâlnesc cu oamenii."
        spots={spots['snagov-plaza']}
        dissolve
        pins={[
          {
            key: 'supermarket',
            plaque: 'pin_placa_supermarket',
            match: 'supermarket',
            name: 'Supermarket',
            meta: `deschis din ${TIMELINE.first.label}`,
            href: '#snagov-plaza',
            label: `Smartino Supermarket, deschis din ${TIMELINE.first.label} — vezi adresa și programul`,
          },
          {
            key: 'home',
            plaque: 'pin_placa_home',
            match: 'mall_',
            name: 'Home',
            meta: `deschis din ${TIMELINE.second.label}`,
            href: home.href!,
            external: true,
            label: `Smartino Home, ${HOME_AREA}, deschis din ${TIMELINE.second.label}, zilnic ${HOME_HOURS[0].open}–${HOME_HOURS[0].close} — deschide ${home.domain}`,
          },
        ]}
      />

      <Tranzitie />

      <Infrastructura />

      <Maquette
        id="otopeni"
        model="otopeni"
        poster={otopeniPoster}
        posterAlt="Macheta ilustrativă a platformei din Otopeni: hala de depozitare Smartino și clădirea de birouri Smartino International"
        kicker="Distribuție & logistică"
        title="De aici pleacă marfa."
        lead="Depozitul grupului și birourile Smartino International, în parcul industrial de la Otopeni. Aici ajung brandurile importate și de aici pleacă spre magazine și spre comenzile online."
        spots={spots.otopeni}
        dissolve
        keys={[
          { yaw: -0.62, pitch: 0.72, dist: 2.6, ty: 0 },
          { yaw: -0.1, pitch: 0.34, dist: 1.55, ty: 6 },
          { yaw: 0.95, pitch: 0.52, dist: 1.9, ty: 0 },
        ]}
        pins={[
          {
            key: 'depozit',
            plaque: 'pin_placa_hala_4000',
            match: 'smartino_4000',
            name: 'Depozit',
            meta: 'marfa pentru toate magazinele',
            href: '#snagov-plaza',
            label: 'Depozitul Smartino din Otopeni — vezi datele de contact',
          },
          {
            key: 'birouri',
            plaque: 'pin_placa_smartino',
            match: 'smartino_international,smartino_birouri',
            name: 'Birouri',
            meta: 'Smartino International',
            href: '#snagov-plaza',
            label: 'Birourile Smartino International — vezi datele de contact',
          },
        ]}
      />

      <Arhitectura />
      <RoMap />
    </div>

    {/* The light band: one idea, and the selection behind it. */}
    <CumGandim />
    <CumAlegem />

    {/* Back into the dark for the proof: the brands, the terms, the address. */}
    <div class="zone">
      <span class="zone__lamp" aria-hidden="true"></span>
      <span class="zone__lamp--low" aria-hidden="true"></span>
      <Brands />
      <Parteneriate />
      <SnagovPlaza />
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .zone {
    position: relative;
    background-color: var(--ink);
  }

  .zone__lamp {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 0;
    height: clamp(58rem, 160vh, 100rem);
    pointer-events: none;
    background-image:
      radial-gradient(46% 45% at 50% 45%, rgba(19, 180, 198, 0.24), transparent 78%),
      radial-gradient(26% 14% at 12% 14%, rgba(75, 216, 232, 0.14), transparent 74%),
      radial-gradient(26% 14% at 88% 16%, rgba(75, 216, 232, 0.12), transparent 74%);
  }

  /* The lamp at the far end of the room. Same idea as the first: one light hung
     across the last sections, not two lights meeting at a section edge. It dies
     before the room does, so what follows starts from plain dark. */
  .zone__lamp--low {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 0;
    height: clamp(42rem, 116vh, 70rem);
    pointer-events: none;
    background-image:
      radial-gradient(48% 40% at 16% 40%, rgba(19, 180, 198, 0.2), transparent 74%),
      radial-gradient(42% 34% at 90% 62%, rgba(75, 216, 232, 0.15), transparent 76%);
  }

  /* every section in the room sits in the same light: transparent grounds,
     content above */
  .zone > :global(section) {
    position: relative;
    z-index: 1;
    background-color: transparent;
  }
</style>
