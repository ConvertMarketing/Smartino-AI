---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Maquette from '../components/Maquette.astro';
import Statement from '../components/Statement.astro';
import BrandIndex from '../components/BrandIndex.astro';
import Marquee from '../components/Marquee.astro';
import Brands from '../components/Brands.astro';
import Story from '../components/Story.astro';
import SnagovPlaza from '../components/SnagovPlaza.astro';
import SiteFooter from '../components/SiteFooter.astro';

const title = 'Smartino International — zeci de branduri, un singur grup';
const description =
  'Smartino International SRL reunește Smartino Supermarket și Smartino Home în Snagov Plaza, ' +
  'plus magazinele online Smartino Shop și Smartino Moldova.';
---

<Base title={title} description={description}>
  <main>
    <Hero />
    <Maquette />
    <Statement />
    <BrandIndex />
    <Marquee />
    {/* One dark room, not two sections that happen to be the same colour.
        The lamp lives here, above the wall and below the story's first
        chapter, so the light crosses the join because nothing cuts it -- there
        is no second light to match. The ground is solid on this wrapper, which
        is what the sections' text is measured against. */}
    <div class="zone">
      <span class="zone__lamp" aria-hidden="true"></span>
      <span class="zone__lamp--low" aria-hidden="true"></span>
      <Brands />
      <Story />
      <SnagovPlaza />
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .zone {
    position: relative;
    background-color: var(--ink);
  }

  .zone__lamp {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 0;
    height: clamp(58rem, 160vh, 100rem);
    pointer-events: none;
    /* Geometry, not taste: in this box the wall stands between 22% and 55%,
       the story starts at 57%, and the light has to be dead by ~92%. So the
       main ellipse is centred at 45% with a 45% vertical radius -- it peaks
       behind the wall and still carries a third of its strength across the
       join, then dies on its own. */
    background-image:
      radial-gradient(46% 45% at 50% 45%, rgba(19, 180, 198, 0.24), transparent 78%),
      radial-gradient(26% 14% at 12% 14%, rgba(75, 216, 232, 0.14), transparent 74%),
      radial-gradient(26% 14% at 88% 16%, rgba(75, 216, 232, 0.12), transparent 74%);
  }

  /* The second lamp of the room, at the far end. Same idea as the first: it is
     one light hung across the story's last chapter and the address block, not
     two lights meeting at a section edge. It dies before the room does, so the
     footer below starts from plain dark and there is nothing to match there
     either. */
  .zone__lamp--low {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 0;
    height: clamp(42rem, 116vh, 70rem);
    pointer-events: none;
    background-image:
      radial-gradient(48% 40% at 16% 40%, rgba(19, 180, 198, 0.2), transparent 74%),
      radial-gradient(42% 34% at 90% 62%, rgba(75, 216, 232, 0.15), transparent 76%);
  }

  /* both sections sit in the same light: transparent grounds, content above */
  .zone > :global(section) {
    position: relative;
    z-index: 1;
    background-color: transparent;
  }
</style>
