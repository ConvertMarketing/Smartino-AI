---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Maquette from '../components/Maquette.astro';
import Statement from '../components/Statement.astro';
import BrandIndex from '../components/BrandIndex.astro';
import Marquee from '../components/Marquee.astro';
import Brands from '../components/Brands.astro';
import Story from '../components/Story.astro';
import SnagovPlaza from '../components/SnagovPlaza.astro';
import SiteFooter from '../components/SiteFooter.astro';

const title = 'Smartino International — zeci de branduri, un singur grup';
const description =
  'Smartino International SRL reunește Smartino Supermarket și Smartino Home în Snagov Plaza, ' +
  'plus magazinele online Smartino Shop și Smartino Moldova.';
---

<Base title={title} description={description}>
  <main>
    <Hero />
    <Maquette />
    <Statement />
    <BrandIndex />
    <Marquee />
    <Brands />
    <Story />
    <SnagovPlaza />
  </main>
  <SiteFooter />
</Base>
